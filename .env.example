# Crab Launcher environment variables (optional)
# Copy this file to `.env` and fill in your own credentials for local development.
# Never commit `.env` or real credentials to the repository.

# Microsoft Azure App Client ID for Microsoft account login (Device Code Flow)
CRAB_MS_CLIENT_ID=your_microsoft_azure_client_id_here

# CurseForge Core API v1 key (optional, for CurseForge content integration)
CRAB_CURSEFORGE_API_KEY=your_curseforge_api_key_here
