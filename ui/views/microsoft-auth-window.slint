import { Theme } from "../theme.slint";
import { CrabButton } from "../components/button.slint";

/// Janela dedicada de autenticação Microsoft via OAuth 2.0 Device Code Flow com QR Code local.
export component MicrosoftAuthWindow inherits Window {
    title: "Sign in with Microsoft — Crab";
    icon: @image-url("../../assets/app/logo-icon.svg");
    default-font-family: Theme.font-family;
    preferred-width: 440px;
    preferred-height: 490px;
    min-width: 400px;
    min-height: 450px;
    background: Theme.bg-primary;

    in property <string> user-code: "";
    in property <string> verification-url: "";
    in property <image> qr-image;
    in property <bool> has-qr: false;
    in property <string> status-message: "Requesting sign-in code...";
    in property <string> error-message: "";
    in property <bool> copied-feedback: false;

    callback copy-code-clicked(string);
    callback open-browser-clicked(string);
    callback cancel-clicked();

    VerticalLayout {
        padding: Theme.space-xl;
        spacing: Theme.space-md;
        alignment: start;

        // Cabeçalho com ícone Microsoft + título
        HorizontalLayout {
            spacing: Theme.space-sm;
            alignment: center;

            VerticalLayout {
                alignment: center;
                Image {
                    source: @image-url("../../assets/icons/microsoft.svg");
                    width: 22px;
                    height: 22px;
                }
            }

            Text {
                text: "Sign in with Microsoft";
                font-size: Theme.font-xl;
                font-weight: 700;
                color: Theme.text-primary;
                vertical-alignment: center;
            }
        }

        Text {
            text: "Scan the QR code or open the link below in your browser and enter the code to sign in with your Minecraft account.";
            font-size: Theme.font-sm;
            color: Theme.text-secondary;
            horizontal-alignment: center;
            wrap: word-wrap;
        }

        // QR Code local
        if root.has-qr: HorizontalLayout {
            alignment: center;

            Rectangle {
                width: 176px;
                height: 176px;
                border-radius: Theme.radius-md;
                background: #ffffff;
                border-width: 1px;
                border-color: Theme.border;

                Image {
                    source: root.qr-image;
                    width: 160px;
                    height: 160px;
                    x: 8px;
                    y: 8px;
                    image-rendering: pixelated;
                }
            }
        }

        // Código de autenticação
        if root.user-code != "": Rectangle {
            height: 46px;
            border-radius: Theme.radius-sm;
            background: Theme.bg-secondary;
            border-width: 1px;
            border-color: Theme.border;

            Text {
                text: root.user-code;
                font-family: "monospace";
                font-size: 20px;
                font-weight: 700;
                letter-spacing: 3px;
                color: Theme.accent;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        // Ações principais: Copy Code e Open Browser
        if root.user-code != "": HorizontalLayout {
            spacing: Theme.space-sm;
            alignment: center;

            CrabButton {
                text: root.copied-feedback ? "Copied!" : "Copy Code";
                icon: root.copied-feedback
                    ? @image-url("../../assets/icons/check.svg")
                    : @image-url("../../assets/icons/copy.svg");
                has-icon: true;
                variant: "secondary";
                clicked => {
                    root.copy-code-clicked(root.user-code);
                }
            }

            CrabButton {
                text: "Open Browser";
                icon: @image-url("../../assets/icons/external-link.svg");
                has-icon: true;
                variant: "primary";
                enabled: root.verification-url != "";
                clicked => {
                    root.open-browser-clicked(root.verification-url);
                }
            }
        }

        if root.error-message != "": Rectangle {
            border-radius: Theme.radius-sm;
            background: Theme.error-bg;
            border-width: 1px;
            border-color: Theme.error-border;

            VerticalLayout {
                padding: Theme.space-sm;
                Text {
                    text: root.error-message;
                    font-size: Theme.font-xs;
                    color: Theme.error-text;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }
            }
        }

        Rectangle {
            vertical-stretch: 1;
        }

        // Indicador de espera
        if root.error-message == "" && root.status-message != "": Text {
            text: root.status-message;
            font-size: Theme.font-xs;
            color: Theme.text-secondary;
            horizontal-alignment: center;
        }

        HorizontalLayout {
            alignment: center;

            CrabButton {
                text: "Cancel";
                icon: @image-url("../../assets/icons/x.svg");
                has-icon: true;
                variant: "secondary";
                clicked => {
                    root.cancel-clicked();
                }
            }
        }
    }
}
