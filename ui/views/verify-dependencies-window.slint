import { ListView } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { CrabButton } from "../components/button.slint";
import { CrabCheckbox } from "../components/checkbox.slint";
import { CrabDialogFrame } from "../components/dialog-window.slint";

export struct DependencyIssueItem {
    id: string,
    name: string,
    version: string,
    status: string, // "Missing" | "Incompatible"
    required-by: string,
    provider: string,
    selected: bool,
    icon: image,
    has-icon: bool,
}

/// Janela independente de verificação e instalação de dependências obrigatórias ausentes/incompatíveis.
export component VerifyDependenciesWindow inherits Window {
    title: "Verify Dependencies — Crab Launcher";
    icon: @image-url("../../assets/app/logo-icon.svg");
    default-font-family: Theme.font-family;
    preferred-width: 620px;
    preferred-height: 440px;
    min-width: 520px;
    min-height: 360px;
    background: Theme.bg-secondary;

    in property <bool> is-checking: false;
    in property <string> status-text: "";
    in property <[DependencyIssueItem]> issues: [];

    callback toggle-item(string);
    callback install-selected();
    callback cancelled();

    CrabDialogFrame {
        width: parent.width;
        height: parent.height;
        heading: "Verify Dependencies";
        subtitle: root.is-checking
            ? "Scanning installed mods for missing or incompatible required dependencies..."
            : root.status-text;
        escape-pressed => { root.cancelled(); }

        Rectangle {
            vertical-stretch: 1;
            border-radius: Theme.radius-sm;
            background: Theme.bg-primary;
            border-width: 1px;
            border-color: Theme.border;
            clip: true;

            if root.is-checking: Text {
                text: "Verifying dependencies...";
                font-size: Theme.font-sm;
                color: Theme.text-secondary;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            if !root.is-checking && root.issues.length == 0: Text {
                text: root.status-text != "" ? root.status-text : "All required mod dependencies are satisfied.";
                font-size: Theme.font-sm;
                color: Theme.text-secondary;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            if !root.is-checking && root.issues.length > 0: ListView {
                for item in root.issues: Rectangle {
                    height: 54px;

                    HorizontalLayout {
                        padding-left: Theme.space-md;
                        padding-right: Theme.space-md;
                        spacing: Theme.space-sm;

                        VerticalLayout {
                            width: 24px;
                            alignment: center;
                            CrabCheckbox {
                                label: "";
                                checked: item.selected;
                                toggled => { root.toggle-item(item.id); }
                            }
                        }

                        VerticalLayout {
                            width: 32px;
                            alignment: center;
                            if item.has-icon: Image {
                                source: item.icon;
                                width: 28px;
                                height: 28px;
                                image-fit: cover;
                            }
                            if !item.has-icon: Image {
                                source: item.provider == "Modrinth"
                                    ? @image-url("../../assets/providers/modrinth.svg")
                                    : item.provider == "CurseForge"
                                        ? @image-url("../../assets/providers/curseforge.svg")
                                        : Theme.icon-puzzle;
                                width: 24px;
                                height: 24px;
                                image-fit: contain;
                            }
                        }

                        VerticalLayout {
                            horizontal-stretch: 1;
                            alignment: center;
                            spacing: 2px;

                            HorizontalLayout {
                                spacing: 6px;
                                alignment: start;

                                Text {
                                    text: item.name;
                                    font-size: Theme.font-sm;
                                    font-weight: 600;
                                    color: Theme.text-primary;
                                    overflow: elide;
                                }

                                Rectangle {
                                    height: 18px;
                                    width: st-txt.preferred-width + 10px;
                                    border-radius: Theme.radius-sm;
                                    background: item.status == "Missing" ? #ef444426 : Theme.warning-bg;

                                    st-txt := Text {
                                        text: item.status;
                                        font-size: 10px;
                                        font-weight: 600;
                                        color: item.status == "Missing" ? Theme.danger : Theme.warning-text;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }
                            }

                            Text {
                                text: item.version + "  •  Required by: " + item.required-by;
                                font-size: Theme.font-xs;
                                color: Theme.text-secondary;
                                overflow: elide;
                            }
                        }
                    }

                    Rectangle {
                        y: parent.height - 1px;
                        height: 1px;
                        width: parent.width;
                        background: Theme.border-subtle;
                    }
                }
            }
        }

        Rectangle {
            height: 1px;
            background: Theme.border-subtle;
        }

        HorizontalLayout {
            spacing: Theme.space-sm;
            alignment: end;

            CrabButton {
                text: "Close";
                icon: Theme.icon-x;
                has-icon: true;
                variant: "secondary";
                clicked => { root.cancelled(); }
            }

            CrabButton {
                text: "Install Selected";
                icon: Theme.icon-download;
                has-icon: true;
                variant: "primary";
                enabled: !root.is-checking && root.issues.length > 0;
                clicked => { root.install-selected(); }
            }
        }
    }
}
