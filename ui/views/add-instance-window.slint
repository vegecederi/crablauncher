import { ListView, ScrollView } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { Strings } from "../strings.slint";
import { CrabButton } from "../components/button.slint";
import { CrabTextInput } from "../components/input.slint";
import { CrabCheckbox } from "../components/checkbox.slint";
import { CrabDropdown, DropdownOption } from "../components/dropdown.slint";
import { NavigationItem } from "../components/navigation-item.slint";
import { DescriptionBlockItem, FilterOptionItem } from "download-mods-window.slint";

export struct VersionItem {
    id: string,
    version-type: string,
    release-date: string,
    is-snapshot: bool,
    recommended: bool,
}

export struct AddLoaderVersionItem {
    version: string,
    status-label: string,
    recommended: bool,
    stable: bool,
}

export struct PackResultItem {
    id: string,
    title: string,
    description: string,
    author: string,
    homepage-url: string,
    icon-url: string,
    icon: image,
    has-icon: bool,
}

export component AddInstanceWindow inherits Window {
    title: Strings.add-window-title;
    icon: @image-url("../../assets/app/logo-icon.svg");
    default-font-family: Theme.font-family;
    preferred-width: 960px;
    preferred-height: 680px;
    min-width: 780px;
    min-height: 580px;
    background: Theme.bg-primary;

    in-out property <int> active-source: 0;
    in-out property <string> pack-path: "";
    in-out property <string> pack-query: "";
    in-out property <string> pack-project: "";
    in-out property <string> pack-release: "";
    in-out property <string> pack-sort-id: "relevance";
    in-out property <string> pack-sort-label: "Sort by Relevance";
    in-out property <bool> show-pack-filters: false;
    in-out property <string> pack-mc-version-filter: "";
    in property <[FilterOptionItem]> pack-filter-modloaders: [];
    in property <[FilterOptionItem]> pack-filter-categories: [];
    in property <[PackResultItem]> pack-results: [];
    in property <[DropdownOption]> pack-releases: [];
    in property <string> pack-release-label: "";
    in property <string> pack-detail-title: "";
    in property <string> pack-detail-author: "";
    in property <string> pack-description: "";
    in property <string> pack-detail-body: "";
    in property <[DescriptionBlockItem]> pack-detail-blocks: [];
    in property <string> pack-detail-homepage: "";
    in property <string> pack-detail-issues-url: "";
    in property <string> pack-detail-source-url: "";
    in property <string> pack-detail-discord-url: "";
    in property <string> pack-detail-wiki-url: "";
    in property <string> pack-message: "";
    in property <bool> pack-ready: false;
    in property <bool> pack-loading: false;
    in property <bool> pack-searching: false;
    in property <bool> pack-loading-more: false;
    in property <bool> pack-can-load-more: false;
    in property <image> pack-icon;
    in property <bool> has-pack-icon: false;
    in property <string> pack-icon-url: "";
    in property <int> pack-request: 0;
    callback source-changed(int);
    callback browse-pack();
    callback inspect-pack();
    callback pack-path-edited();
    callback search-packs();
    callback pack-load-more();
    callback pack-sort-changed(string);
    callback pack-filters-changed();
    callback pack-toggle-filter-loader(string);
    callback pack-toggle-filter-category(string);
    callback pack-reset-filters();
    callback select-pack(string);
    callback select-pack-release(string);
    callback open-pack-url(string);
    callback install-pack();

    // Instance Information
    in-out property <string> instance-name: "";
    in-out property <bool> user-edited-name: false;
    in property <[DropdownOption]> group-options: [];
    in-out property <string> selected-group-id: "";
    in-out property <string> selected-group-label: "Ungrouped";
    callback group-selected(string);
    in-out property <string> selected-icon-key: "";
    in property <image> selected-icon-preview;
    in property <bool> has-selected-icon: false;

    // Minecraft Version
    in-out property <string> search-query: "";
    in-out property <bool> show-releases: true;
    in-out property <bool> show-snapshots: false;
    in-out property <bool> show-betas: false;
    in-out property <bool> show-alphas: false;
    in property <[VersionItem]> versions: [];
    in-out property <string> selected-version-id: "";
    in property <bool> is-loading: false;
    in property <bool> is-creating: false;
    in property <string> notice-message: "";
    in property <string> error-message: "";

    // Modloader Selection (0=Vanilla, 1=Fabric, 2=Forge, 3=NeoForge)
    in-out property <int> selected-modloader: 0;
    in-out property <string> loader-search-query: "";
    in property <[AddLoaderVersionItem]> loader-versions: [];
    in-out property <string> selected-loader-version: "";
    in property <bool> loader-loading: false;
    in property <string> loader-status-text: "";

    callback change-icon-clicked();
    callback filters-changed();
    callback version-selected(string);
    callback modloader-changed(int);
    callback loader-search-changed();
    callback loader-version-selected(string);
    callback refresh-versions();
    callback create-clicked();
    callback cancel-clicked();

    private property <string> modloader-name:
        root.selected-modloader == 1 ? "Fabric"
        : root.selected-modloader == 2 ? "Forge"
        : root.selected-modloader == 3 ? "NeoForge"
        : root.selected-modloader == 4 ? "Quilt"
        : root.selected-modloader == 5 ? "LiteLoader"
        : "Vanilla";

    private property <bool> can-create:
        !root.is-creating
        && root.instance-name != ""
        && (root.active-source == 0
            ? root.selected-version-id != ""
                && (root.selected-modloader == 0 || (!root.loader-loading && root.selected-loader-version != ""))
            : root.pack-ready && !root.pack-loading);

    VerticalLayout {
        padding: Theme.space-sm;
        spacing: Theme.space-sm;

        // 1. Top Section: Preview do ícone à esquerda + Instance Name à direita
        HorizontalLayout {
            spacing: Theme.space-sm;

            Rectangle {
                width: 72px;
                height: 72px;
                border-radius: Theme.radius-sm;
                background: icon-touch.has-hover ? Theme.bg-interactive : Theme.bg-secondary;
                border-width: 1px;
                border-color: icon-touch.has-hover ? Theme.accent : Theme.border;

                icon-touch := TouchArea {
                    enabled: !root.is-creating && root.active-source == 0;
                    mouse-cursor: pointer;
                    clicked => { root.change-icon-clicked(); }
                }

                if !(root.active-source == 0 ? root.has-selected-icon : root.has-pack-icon): Image {
                    x: 12px;
                    y: 12px;
                    width: 48px;
                    height: 48px;
                    source: Theme.icon-cube;
                    colorize: Theme.accent;
                }

                if root.active-source == 0 ? root.has-selected-icon : root.has-pack-icon: Image {
                    x: 6px;
                    y: 6px;
                    width: 60px;
                    height: 60px;
                    source: root.active-source == 0 ? root.selected-icon-preview : root.pack-icon;
                    image-fit: contain;
                }
            }

            VerticalLayout {
                horizontal-stretch: 1;
                alignment: center;
                spacing: 4px;

                HorizontalLayout {
                    spacing: Theme.space-sm;
                    Text {
                        text: "Name:";
                        width: 48px;
                        font-size: Theme.font-sm;
                        color: Theme.text-secondary;
                        vertical-alignment: center;
                    }
                    CrabTextInput {
                    horizontal-stretch: 1;
                    text <=> root.instance-name;
                    placeholder: Strings.instance-name-placeholder;
                    enabled: !root.is-creating;
                    edited => {
                        root.user-edited-name = root.instance-name != "";
                    }
                    accepted => {
                        if (root.can-create) {
                            if (root.active-source == 0) { root.create-clicked(); }
                            else { root.install-pack(); }
                        }
                    }
                }
                }

                HorizontalLayout {
                    spacing: Theme.space-sm;
                    Text {
                        text: "Group:";
                        width: 48px;
                        font-size: Theme.font-sm;
                        color: Theme.text-secondary;
                        vertical-alignment: center;
                    }
                    CrabDropdown {
                        horizontal-stretch: 1;
                        height: Theme.button-height;
                        options: root.group-options;
                        selected-id <=> root.selected-group-id;
                        selected-label: root.selected-group-label;
                        selected(gid) => { root.group-selected(gid); }
                    }
                }
            }
        }

        Rectangle { height: 1px; background: Theme.border-subtle; }

        // 2. Corpo: Sidebar compacta à esquerda + área principal Custom à direita
        HorizontalLayout {
            vertical-stretch: 1;
            spacing: Theme.space-sm;

            // Sidebar compacta (inspirada no Prism Launcher)
            Rectangle {
                width: 132px;
                border-radius: Theme.radius-sm;
                background: Theme.bg-secondary;
                border-width: 1px;
                border-color: Theme.border;

                // Atalho de scroll do mouse na barra lateral para alternar fonte (Custom / Import / Modrinth)
                TouchArea {
                    scroll-event(ev) => {
                        if (root.is-creating) {
                            return reject;
                        }
                        if (ev.delta-y > 0px) {
                            let next = max(0, root.active-source - 1);
                            if (next != root.active-source) { root.source-changed(next); }
                            return accept;
                        } else if (ev.delta-y < 0px) {
                            let next = min(2, root.active-source + 1);
                            if (next != root.active-source) { root.source-changed(next); }
                            return accept;
                        }
                        reject
                    }
                }

                VerticalLayout {
                    padding: Theme.space-xs;
                    spacing: 2px;

                    NavigationItem {
                        label: "Custom";
                        icon: Theme.icon-cube;
                        selected: root.active-source == 0;
                        clicked => { if (!root.is-creating) { root.source-changed(0); } }
                    }
                    NavigationItem {
                        label: "Import";
                        icon: Theme.icon-folder;
                        selected: root.active-source == 1;
                        clicked => { if (!root.is-creating) { root.source-changed(1); } }
                    }
                    NavigationItem {
                        label: "Modrinth";
                        icon: @image-url("../../assets/providers/modrinth.svg");
                        preserve-icon-colors: true;
                        selected: root.active-source == 2;
                        clicked => { if (!root.is-creating) { root.source-changed(2); } }
                    }

                    Rectangle { vertical-stretch: 1; }
                }
            }

            if root.active-source == 1: VerticalLayout {
                horizontal-stretch: 1;
                spacing: Theme.space-sm;
                alignment: start;
                Text { text: "Import"; font-size: Theme.font-md; font-weight: 600; color: Theme.text-primary; }
                Text { text: "Local modpack or exported instance"; color: Theme.text-secondary; }
                HorizontalLayout {
                    spacing: Theme.space-xs;
                    CrabTextInput {
                        text <=> root.pack-path;
                        placeholder: "Path to a .zip or .mrpack";
                        horizontal-stretch: 1;
                        enabled: !root.is-creating;
                        edited(_) => { root.pack-path-edited(); }
                        accepted(_) => { root.inspect-pack(); }
                    }
                    CrabButton {
                        text: "Browse…";
                        enabled: !root.is-creating && !root.pack-loading;
                        clicked => { root.browse-pack(); }
                    }
                    CrabButton {
                        text: "Load";
                        enabled: !root.is-creating && !root.pack-loading && root.pack-path != "";
                        clicked => { root.inspect-pack(); }
                    }
                }
                Text {
                    text: "Supported: Modrinth (.mrpack or .zip) and standard Prism/MultiMC instance exports (.zip).";
                    color: Theme.text-secondary;
                    wrap: word-wrap;
                }
                Text { text: root.pack-message; color: Theme.text-secondary; wrap: word-wrap; }
            }

            if root.active-source == 2: VerticalLayout {
                horizontal-stretch: 1;
                vertical-stretch: 1;
                spacing: Theme.space-sm;

                Text {
                    text: "Modrinth";
                    font-size: Theme.font-xl;
                    font-weight: 700;
                    color: Theme.text-primary;
                }

                // Barra superior: Filter + Search (mesmo padrão da janela Download Mods)
                HorizontalLayout {
                    spacing: Theme.space-sm;

                    CrabButton {
                        height: Theme.button-height;
                        text: "Filter";
                        icon: Theme.icon-sliders-horizontal;
                        has-icon: true;
                        variant: root.show-pack-filters ? "primary" : "secondary";
                        enabled: !root.is-creating;
                        clicked => {
                            root.show-pack-filters = !root.show-pack-filters;
                        }
                    }

                    pack-search-input := CrabTextInput {
                        horizontal-stretch: 1;
                        text <=> root.pack-query;
                        placeholder: "Search modpacks...";
                        leading-icon: Theme.icon-search;
                        has-leading-icon: true;
                        enabled: !root.is-creating;
                        accepted(_) => { root.search-packs(); }
                    }
                }

                // Corpo dividido: Filtros opcionais + Lista de modpacks à esquerda + Detalhes ricos à direita
                HorizontalLayout {
                    vertical-stretch: 1;
                    spacing: Theme.space-sm;

                    if root.show-pack-filters: Rectangle {
                        width: 212px;
                        border-radius: Theme.radius-sm;
                        background: Theme.bg-secondary;
                        border-width: 1px;
                        border-color: Theme.border;
                        clip: true;

                        VerticalLayout {
                            padding: Theme.space-sm;
                            spacing: Theme.space-sm;

                            HorizontalLayout {
                                spacing: Theme.space-xs;
                                Text {
                                    text: "Filters";
                                    font-size: Theme.font-sm;
                                    font-weight: 600;
                                    color: Theme.text-primary;
                                    horizontal-stretch: 1;
                                    vertical-alignment: center;
                                }
                                CrabButton {
                                    text: "Reset";
                                    variant: "ghost";
                                    enabled: !root.is-creating;
                                    clicked => { root.pack-reset-filters(); }
                                }
                            }

                            Rectangle { height: 1px; background: Theme.border-subtle; }

                            ScrollView {
                                vertical-stretch: 1;

                                VerticalLayout {
                                    alignment: start;
                                    spacing: 12px;
                                    padding-top: 2px;
                                    padding-bottom: 6px;
                                    padding-right: 4px;

                                    VerticalLayout {
                                        alignment: start;
                                        spacing: 4px;
                                        Text {
                                            text: "Minecraft Version";
                                            font-size: Theme.font-xs;
                                            font-weight: 600;
                                            color: Theme.text-secondary;
                                        }
                                        CrabTextInput {
                                            text <=> root.pack-mc-version-filter;
                                            placeholder: "All versions";
                                            enabled: !root.is-creating;
                                            accepted(_) => { root.pack-filters-changed(); }
                                            edited(_) => { root.pack-filters-changed(); }
                                        }
                                    }

                                    if root.pack-filter-modloaders.length > 0: VerticalLayout {
                                        alignment: start;
                                        spacing: 4px;
                                        Text {
                                            text: "Modloaders";
                                            font-size: Theme.font-xs;
                                            font-weight: 600;
                                            color: Theme.text-secondary;
                                        }
                                        for ml in root.pack-filter-modloaders: CrabCheckbox {
                                            label: ml.label;
                                            checked: ml.checked;
                                            enabled: !root.is-creating;
                                            toggled => { root.pack-toggle-filter-loader(ml.id); }
                                        }
                                    }

                                    if root.pack-filter-categories.length > 0: VerticalLayout {
                                        alignment: start;
                                        spacing: 4px;
                                        Text {
                                            text: "Categories";
                                            font-size: Theme.font-xs;
                                            font-weight: 600;
                                            color: Theme.text-secondary;
                                        }
                                        for cat in root.pack-filter-categories: CrabCheckbox {
                                            label: cat.label;
                                            checked: cat.checked;
                                            enabled: !root.is-creating;
                                            toggled => { root.pack-toggle-filter-category(cat.id); }
                                        }
                                    }
                                }
                            }
                        }
                    }

                    // Painel Esquerdo: Lista de modpacks com ícones reais + Sort abaixo
                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: Theme.space-sm;

                        Rectangle {
                            vertical-stretch: 1;
                            border-radius: Theme.radius-sm;
                            background: Theme.bg-secondary;
                            border-width: 1px;
                            border-color: Theme.border;
                            clip: true;

                            if root.pack-searching: pack-spinner := Rectangle {
                                private property <float> spin-phase: mod(animation-tick() / 1ms, 900) / 900.0;
                                private property <angle> spin-angle: self.spin-phase * 360deg;

                                Rectangle {
                                    x: (parent.width - self.width) / 2;
                                    y: (parent.height - self.height) / 2;
                                    width: 30px;
                                    height: 30px;
                                    border-radius: 15px;
                                    border-width: 2.5px;
                                    border-color: Theme.border;

                                    Rectangle {
                                        x: 15px + 12px * Math.cos(pack-spinner.spin-angle) - 3px;
                                        y: 15px + 12px * Math.sin(pack-spinner.spin-angle) - 3px;
                                        width: 6px;
                                        height: 6px;
                                        border-radius: 3px;
                                        background: Theme.accent;
                                    }
                                }
                            }

                            if !root.pack-searching && root.pack-results.length == 0 && root.error-message != "": Text {
                                text: "Failed to load modpacks. Check your connection and try again.";
                                font-size: Theme.font-sm;
                                color: Theme.error-text;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                                wrap: word-wrap;
                            }

                            if !root.pack-searching && root.pack-results.length == 0 && root.error-message == "": Text {
                                text: root.pack-message != "" ? root.pack-message : "No modpacks found.";
                                font-size: Theme.font-sm;
                                color: Theme.text-secondary;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }

                            if !root.pack-searching && root.pack-results.length > 0: ListView {
                                width: parent.width;
                                height: parent.height;
                                scrolled => {
                                    if (root.pack-can-load-more && !root.pack-loading-more
                                        && -self.content-y + self.height >= self.content-height - 140px)
                                    {
                                        root.pack-load-more();
                                    }
                                }

                                for pack in root.pack-results: Rectangle {
                                    height: 64px;
                                    background: pack.id == root.pack-project
                                        ? Theme.accent-muted
                                        : pack-touch.has-hover ? Theme.bg-interactive : transparent;

                                    pack-touch := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => {
                                            if (!root.is-creating) {
                                                root.select-pack(pack.id);
                                            }
                                        }
                                    }

                                    HorizontalLayout {
                                        padding-left: Theme.space-sm;
                                        padding-right: Theme.space-sm;
                                        spacing: Theme.space-sm;

                                        // Ícone real 44x44
                                        VerticalLayout {
                                            width: 44px;
                                            horizontal-stretch: 0;
                                            alignment: center;
                                            Rectangle {
                                                width: 44px;
                                                height: 44px;
                                                border-radius: Theme.radius-sm;
                                                background: Theme.bg-primary;
                                                clip: true;

                                                if pack.has-icon: Image {
                                                    width: 44px;
                                                    height: 44px;
                                                    source: pack.icon;
                                                    image-fit: cover;
                                                }
                                                if !pack.has-icon: Image {
                                                    x: 10px;
                                                    y: 10px;
                                                    width: 24px;
                                                    height: 24px;
                                                    source: Theme.icon-cube;
                                                    colorize: Theme.text-secondary;
                                                }
                                            }
                                        }

                                        // Título + descrição curta com elisão
                                        VerticalLayout {
                                            horizontal-stretch: 1;
                                            min-width: 0px;
                                            alignment: center;
                                            spacing: 2px;

                                            Text {
                                                text: pack.title;
                                                font-size: Theme.font-sm;
                                                font-weight: 600;
                                                color: pack.id == root.pack-project
                                                    ? Theme.accent
                                                    : Theme.text-primary;
                                                overflow: elide;
                                            }

                                            Text {
                                                text: pack.description;
                                                font-size: Theme.font-xs;
                                                color: Theme.text-secondary;
                                                overflow: elide;
                                            }
                                        }
                                    }

                                    Rectangle {
                                        y: parent.height - 1px;
                                        height: 1px;
                                        width: parent.width;
                                        background: Theme.border-subtle;
                                    }
                                }
                            }
                        }

                        HorizontalLayout {
                            alignment: start;
                            CrabDropdown {
                                width: 210px;
                                open-upward: true;
                                enabled: !root.is-creating;
                                options: [
                                    { id: "relevance", label: "Sort by Relevance", detail: "", enabled: true, has-icon: false },
                                    { id: "downloads", label: "Sort by Downloads", detail: "", enabled: true, has-icon: false },
                                    { id: "updated", label: "Sort by Updated", detail: "", enabled: true, has-icon: false },
                                    { id: "newest", label: "Sort by Newest", detail: "", enabled: true, has-icon: false },
                                ];
                                selected-id <=> root.pack-sort-id;
                                selected-label: root.pack-sort-label;
                                selected(s) => { root.pack-sort-changed(s); }
                            }
                        }
                    }

                    // Painel Direito: Detalhes completos em Markdown + Links + Version selected abaixo
                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: Theme.space-sm;

                        Rectangle {
                            vertical-stretch: 1;
                            border-radius: Theme.radius-sm;
                            background: Theme.bg-secondary;
                            border-width: 1px;
                            border-color: Theme.border;
                            clip: true;

                            if root.pack-project == "": Text {
                                text: "Select a modpack to view its description, links and versions.";
                                font-size: Theme.font-sm;
                                color: Theme.text-secondary;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                                wrap: word-wrap;
                            }

                            if root.pack-project != "": Flickable {
                                width: parent.width;
                                height: parent.height;
                                content-width: self.width;
                                content-height: pack-detail-col.preferred-height + 24px;

                                pack-detail-col := VerticalLayout {
                                    width: parent.width;
                                    padding: Theme.space-md;
                                    spacing: Theme.space-sm;
                                    alignment: start;

                                    HorizontalLayout {
                                        spacing: Theme.space-sm;
                                        Text {
                                            text: root.pack-detail-title;
                                            font-size: Theme.font-lg;
                                            font-weight: 700;
                                            color: Theme.accent;
                                            horizontal-stretch: 1;
                                            wrap: word-wrap;
                                        }
                                        if root.pack-detail-homepage != "": CrabButton {
                                            text: "Homepage";
                                            icon: Theme.icon-external-link;
                                            has-icon: true;
                                            variant: "ghost";
                                            clicked => { root.open-pack-url(root.pack-detail-homepage); }
                                        }
                                    }

                                    if root.pack-detail-author != "": Text {
                                        text: "by " + root.pack-detail-author;
                                        font-size: Theme.font-xs;
                                        color: Theme.text-secondary;
                                    }

                                    if root.pack-detail-issues-url != "" || root.pack-detail-source-url != "" || root.pack-detail-discord-url != "" || root.pack-detail-wiki-url != "": HorizontalLayout {
                                        spacing: Theme.space-xs;
                                        alignment: start;

                                        if root.pack-detail-issues-url != "": CrabButton {
                                            text: "Issues";
                                            icon: Theme.icon-external-link;
                                            has-icon: true;
                                            variant: "secondary";
                                            clicked => { root.open-pack-url(root.pack-detail-issues-url); }
                                        }
                                        if root.pack-detail-source-url != "": CrabButton {
                                            text: "Source";
                                            icon: Theme.icon-external-link;
                                            has-icon: true;
                                            variant: "secondary";
                                            clicked => { root.open-pack-url(root.pack-detail-source-url); }
                                        }
                                        if root.pack-detail-discord-url != "": CrabButton {
                                            text: "Discord";
                                            icon: Theme.icon-external-link;
                                            has-icon: true;
                                            variant: "secondary";
                                            clicked => { root.open-pack-url(root.pack-detail-discord-url); }
                                        }
                                        if root.pack-detail-wiki-url != "": CrabButton {
                                            text: "Wiki";
                                            icon: Theme.icon-external-link;
                                            has-icon: true;
                                            variant: "secondary";
                                            clicked => { root.open-pack-url(root.pack-detail-wiki-url); }
                                        }
                                    }

                                    Rectangle { height: 1px; background: Theme.border; }

                                    if root.pack-detail-blocks.length == 0: Text {
                                        text: root.pack-detail-body != "" ? root.pack-detail-body : root.pack-description;
                                        font-size: Theme.font-sm;
                                        color: Theme.text-primary;
                                        wrap: word-wrap;
                                    }

                                    for blk in root.pack-detail-blocks: VerticalLayout {
                                        spacing: 2px;

                                        if blk.kind == "heading": Text {
                                            text: blk.text;
                                            font-size: Theme.font-lg;
                                            font-weight: 700;
                                            color: Theme.text-primary;
                                            wrap: word-wrap;
                                        }

                                        if blk.kind == "subheading": Text {
                                            text: blk.text;
                                            font-size: Theme.font-md;
                                            font-weight: 600;
                                            color: Theme.text-primary;
                                            wrap: word-wrap;
                                        }

                                        if blk.kind == "paragraph": Text {
                                            text: blk.text;
                                            font-size: Theme.font-sm;
                                            color: Theme.text-primary;
                                            wrap: word-wrap;
                                        }

                                        if blk.kind == "bullet": HorizontalLayout {
                                            spacing: 6px;
                                            Text { text: "•"; font-size: Theme.font-sm; color: Theme.accent; }
                                            Text {
                                                text: blk.text;
                                                font-size: Theme.font-sm;
                                                color: Theme.text-primary;
                                                horizontal-stretch: 1;
                                                wrap: word-wrap;
                                            }
                                        }

                                        if blk.kind == "link": HorizontalLayout {
                                            alignment: start;
                                            CrabButton {
                                                text: blk.text;
                                                icon: Theme.icon-external-link;
                                                has-icon: true;
                                                variant: "ghost";
                                                clicked => { root.open-pack-url(blk.url); }
                                            }
                                        }

                                        if blk.kind == "image" && blk.has-image: Rectangle {
                                            height: 96px;
                                            border-radius: Theme.radius-sm;
                                            background: transparent;
                                            clip: true;

                                            Image {
                                                width: parent.width;
                                                height: parent.height;
                                                source: blk.image;
                                                image-fit: contain;
                                            }

                                            if blk.url != "": TouchArea {
                                                mouse-cursor: pointer;
                                                clicked => { root.open-pack-url(blk.url); }
                                            }
                                        }

                                        if blk.kind == "separator": Rectangle {
                                            height: 1px;
                                            background: Theme.border;
                                        }
                                    }
                                }
                            }
                        }

                        HorizontalLayout {
                            spacing: Theme.space-sm;

                            Text {
                                text: "Version selected:";
                                font-size: Theme.font-xs;
                                color: Theme.text-secondary;
                                vertical-alignment: center;
                            }

                            CrabDropdown {
                                horizontal-stretch: 1;
                                open-upward: true;
                                options: root.pack-releases;
                                selected-id <=> root.pack-release;
                                selected-label: root.pack-release-label;
                                enabled: root.pack-releases.length > 0 && !root.is-creating;
                                selected(id) => { root.select-pack-release(id); }
                            }
                        }
                    }
                }
            }

            if root.active-source == 0: VerticalLayout {
                horizontal-stretch: 1;
                vertical-stretch: 1;
                spacing: Theme.space-sm;

                Text {
                    text: "Custom";
                    font-size: Theme.font-md;
                    font-weight: 600;
                    color: Theme.text-primary;
                }

                if root.notice-message != "": Rectangle {
                    height: 28px;
                    border-radius: Theme.radius-sm;
                    background: Theme.warning-bg;
                    border-width: 1px;
                    border-color: Theme.warning-border;

                    HorizontalLayout {
                        padding-left: Theme.space-sm;
                        padding-right: Theme.space-sm;
                        Text {
                            text: root.notice-message;
                            font-size: Theme.font-xs;
                            color: Theme.warning-text;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                    }
                }

                // 2A. Minecraft Version (Tabela + Pesquisa à esquerda | Filter + Refresh à direita)
                VerticalLayout {
                    vertical-stretch: 1;
                    spacing: Theme.space-xs;

                    HorizontalLayout {
                        alignment: space-between;
                        Text {
                            text: "Minecraft Version";
                            font-size: Theme.font-sm;
                            font-weight: 600;
                            color: Theme.text-secondary;
                        }
                        if root.selected-version-id != "": Text {
                            text: "Selected: " + root.selected-version-id;
                            font-size: Theme.font-xs;
                            font-weight: 600;
                            color: Theme.accent;
                        }
                    }

                    HorizontalLayout {
                        vertical-stretch: 1;
                        spacing: Theme.space-sm;

                        // Esquerda: Tabela + campo de pesquisa abaixo
                        VerticalLayout {
                            horizontal-stretch: 1;
                            vertical-stretch: 1;
                            spacing: Theme.space-xs;

                            Rectangle {
                                vertical-stretch: 1;
                                horizontal-stretch: 1;
                                border-radius: Theme.radius-sm;
                                background: Theme.bg-secondary;
                                border-width: 1px;
                                border-color: Theme.border;
                                clip: true;

                                VerticalLayout {
                                    Rectangle {
                                        height: 26px;
                                        background: Theme.bg-interactive;

                                        HorizontalLayout {
                                            padding-left: Theme.space-md;
                                            padding-right: Theme.space-md;
                                            spacing: Theme.space-sm;

                                            Text {
                                                text: Strings.col-version;
                                                font-size: Theme.font-xs;
                                                font-weight: 600;
                                                color: Theme.text-secondary;
                                                horizontal-stretch: 2;
                                                vertical-alignment: center;
                                            }

                                            Text {
                                                text: Strings.col-released;
                                                font-size: Theme.font-xs;
                                                font-weight: 600;
                                                color: Theme.text-secondary;
                                                width: 88px;
                                                vertical-alignment: center;
                                            }

                                            Text {
                                                text: Strings.col-type;
                                                font-size: Theme.font-xs;
                                                font-weight: 600;
                                                color: Theme.text-secondary;
                                                width: 72px;
                                                horizontal-alignment: right;
                                                vertical-alignment: center;
                                            }
                                        }

                                        Rectangle {
                                            y: parent.height - 1px;
                                            height: 1px;
                                            width: parent.width;
                                            background: Theme.border;
                                        }
                                    }

                                    if root.is-loading: Rectangle {
                                        vertical-stretch: 1;
                                        Text {
                                            text: Strings.loading-versions;
                                            font-size: Theme.font-sm;
                                            color: Theme.text-secondary;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }

                                    if !root.is-loading && root.versions.length == 0: Rectangle {
                                        vertical-stretch: 1;
                                        Text {
                                            text: Strings.no-versions-match;
                                            font-size: Theme.font-sm;
                                            color: Theme.text-secondary;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }

                                    if !root.is-loading && root.versions.length > 0: ListView {
                                        vertical-stretch: 1;

                                        for ver in root.versions: Rectangle {
                                             height: 26px;
                                            background: ver.id == root.selected-version-id
                                                ? Theme.accent-muted
                                                : row-touch.has-hover
                                                    ? Theme.bg-interactive
                                                    : transparent;

                                            if ver.id == root.selected-version-id: Rectangle {
                                                x: 0px;
                                                y: 0px;
                                                width: 3px;
                                                height: parent.height;
                                                background: Theme.accent;
                                            }

                                            row-touch := TouchArea {
                                                mouse-cursor: pointer;
                                                clicked => {
                                                    root.selected-version-id = ver.id;
                                                    if (!root.user-edited-name) {
                                                        root.instance-name = ver.id;
                                                    }
                                                    root.version-selected(ver.id);
                                                }
                                            }

                                            HorizontalLayout {
                                                padding-left: Theme.space-md;
                                                padding-right: Theme.space-md;
                                                spacing: Theme.space-sm;

                                                HorizontalLayout {
                                                    horizontal-stretch: 2;
                                                    spacing: 5px;
                                                    alignment: start;

                                                    if ver.recommended: VerticalLayout {
                                                        alignment: center;
                                                        Image {
                                                            source: Theme.icon-star;
                                                            width: 12px;
                                                            height: 12px;
                                                            colorize: Theme.accent;
                                                        }
                                                    }

                                                    Text {
                                                        text: ver.id;
                                                        font-size: Theme.font-sm;
                                                        font-weight: ver.id == root.selected-version-id ? 600 : 400;
                                                        color: ver.id == root.selected-version-id ? Theme.accent : Theme.text-primary;
                                                        vertical-alignment: center;
                                                        overflow: elide;
                                                    }
                                                }

                                                Text {
                                                    text: ver.release-date;
                                                    font-size: Theme.font-xs;
                                                    color: Theme.text-secondary;
                                                    width: 88px;
                                                    vertical-alignment: center;
                                                }

                                                Text {
                                                    text: ver.version-type;
                                                    font-size: Theme.font-xs;
                                                    color: ver.is-snapshot ? Theme.warning-text : Theme.text-secondary;
                                                    width: 72px;
                                                    horizontal-alignment: right;
                                                    vertical-alignment: center;
                                                }
                                            }

                                            Rectangle {
                                                y: parent.height - 1px;
                                                height: 1px;
                                                width: parent.width;
                                                background: Theme.border-subtle;
                                            }
                                        }
                                    }
                                }
                            }

                            CrabTextInput {
                                text <=> root.search-query;
                                placeholder: Strings.search-placeholder;
                                leading-icon: Theme.icon-search;
                                has-leading-icon: true;
                                edited => { root.filters-changed(); }
                            }
                        }

                        // Direita: Filter + Refresh
                        Rectangle {
                            width: 132px;
                            border-radius: Theme.radius-sm;
                            background: Theme.bg-secondary;
                            border-width: 1px;
                            border-color: Theme.border;

                            VerticalLayout {
                                padding: Theme.space-sm;
                                spacing: Theme.space-xs;
                                alignment: start;

                                Text {
                                    text: "Filter";
                                    font-size: Theme.font-xs;
                                    font-weight: 600;
                                    color: Theme.text-secondary;
                                }

                                CrabCheckbox {
                                    label: Strings.filter-releases;
                                    checked <=> root.show-releases;
                                    toggled => { root.filters-changed(); }
                                }

                                CrabCheckbox {
                                    label: Strings.filter-snapshots;
                                    checked <=> root.show-snapshots;
                                    toggled => { root.filters-changed(); }
                                }

                                CrabCheckbox {
                                    label: "Betas";
                                    checked <=> root.show-betas;
                                    toggled => { root.filters-changed(); }
                                }

                                CrabCheckbox {
                                    label: "Alphas";
                                    checked <=> root.show-alphas;
                                    toggled => { root.filters-changed(); }
                                }

                                Rectangle { vertical-stretch: 1; }

                                CrabButton {
                                    text: "Refresh";
                                    icon: Theme.icon-refresh;
                                    has-icon: true;
                                    variant: "secondary";
                                    enabled: !root.is-loading;
                                    clicked => { root.refresh-versions(); }
                                }
                            }
                        }
                    }
                }

                // 2B. Modloader Selection (Lista exclusiva à esquerda + tabela de versões à direita)
                VerticalLayout {
                    min-height: 220px;
                    vertical-stretch: 1;
                    spacing: Theme.space-xs;

                    Text {
                        text: "Modloader";
                        font-size: Theme.font-sm;
                        font-weight: 600;
                        color: Theme.text-secondary;
                    }

                    GridLayout {
                        vertical-stretch: 1;
                        spacing: Theme.space-sm;

                        // Esquerda: Vanilla / Fabric / Forge / NeoForge / Quilt / LiteLoader (com ScrollView para nunca sobrepor o rodapé)
                        Rectangle {
                            col: 1;
                            row: 0;
                            width: 132px;
                            border-radius: Theme.radius-sm;
                            background: Theme.bg-secondary;
                            border-width: 1px;
                            border-color: Theme.border;
                            clip: true;

                            ScrollView {
                                width: parent.width;
                                height: parent.height;

                                VerticalLayout {
                                    padding: 4px;
                                    spacing: 2px;
                                    alignment: start;

                                    for ml in [
                                        { idx: 0, label: "Vanilla", icon: @image-url("../../assets/modloaders/vanilla.svg") },
                                        { idx: 1, label: "Fabric", icon: @image-url("../../assets/modloaders/fabric.png") },
                                        { idx: 2, label: "Forge", icon: @image-url("../../assets/modloaders/forge.jpg") },
                                        { idx: 3, label: "NeoForge", icon: @image-url("../../assets/modloaders/neoforge.png") },
                                        { idx: 4, label: "Quilt", icon: @image-url("../../assets/modloaders/quilt.png") },
                                        { idx: 5, label: "LiteLoader", icon: @image-url("../../assets/modloaders/liteloader.png") },
                                    ]: Rectangle {
                                        height: 28px;
                                        border-radius: Theme.radius-sm;
                                        border-width: root.selected-modloader == ml.idx ? 1px : 0px;
                                        background: root.selected-modloader == ml.idx
                                            ? Theme.accent-muted
                                            : ml-touch.has-hover ? Theme.bg-interactive-hover : transparent;
                                        border-color: Theme.accent;

                                        ml-touch := TouchArea {
                                            enabled: !root.is-creating;
                                            mouse-cursor: pointer;
                                            clicked => {
                                                root.selected-modloader = ml.idx;
                                                root.modloader-changed(ml.idx);
                                            }
                                        }

                                        HorizontalLayout {
                                            padding-left: Theme.space-sm;
                                            padding-right: Theme.space-sm;
                                            spacing: 8px;

                                            VerticalLayout {
                                                alignment: center;
                                                Image {
                                                    source: ml.icon;
                                                    width: 16px;
                                                    height: 16px;
                                                    image-fit: contain;
                                                }
                                            }

                                            Text {
                                                text: ml.label;
                                                font-size: Theme.font-sm;
                                                font-weight: root.selected-modloader == ml.idx ? 600 : 500;
                                                color: root.selected-modloader == ml.idx ? Theme.accent : Theme.text-primary;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        // Direita: Tabela de versões do modloader selecionado
                        VerticalLayout {
                            col: 0;
                            row: 0;
                            horizontal-stretch: 1;
                            vertical-stretch: 1;
                            spacing: 4px;

                            Rectangle {
                                vertical-stretch: 1;
                                border-radius: Theme.radius-sm;
                                background: Theme.bg-secondary;
                                border-width: 1px;
                                border-color: Theme.border;
                                clip: true;

                                if root.selected-modloader == 0: Text {
                                    text: "No mod loader is selected.";
                                    font-size: Theme.font-sm;
                                    color: Theme.text-secondary;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                    wrap: word-wrap;
                                }

                                if root.selected-modloader != 0 && root.loader-loading: Text {
                                    text: root.loader-status-text != "" ? root.loader-status-text : "Loading loader versions...";
                                    font-size: Theme.font-sm;
                                    color: Theme.text-secondary;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }

                                if root.selected-modloader != 0 && !root.loader-loading && root.loader-versions.length == 0: Text {
                                    text: root.loader-status-text != "" ? root.loader-status-text : "No compatible versions available.";
                                    font-size: Theme.font-sm;
                                    color: Theme.warning-text;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }

                                if root.selected-modloader != 0 && !root.loader-loading && root.loader-versions.length > 0: ListView {
                                    for lv in root.loader-versions: Rectangle {
                                        height: 28px;
                                        background: lv.version == root.selected-loader-version
                                            ? Theme.accent-muted
                                            : lv-touch.has-hover ? Theme.bg-interactive : transparent;

                                        lv-touch := TouchArea {
                                            enabled: !root.is-creating;
                                            mouse-cursor: pointer;
                                            clicked => {
                                                root.selected-loader-version = lv.version;
                                                root.loader-version-selected(lv.version);
                                            }
                                        }

                                        HorizontalLayout {
                                            padding-left: Theme.space-md;
                                            padding-right: Theme.space-md;
                                            spacing: Theme.space-sm;

                                            Text {
                                                text: lv.version;
                                                font-size: Theme.font-sm;
                                                font-weight: lv.version == root.selected-loader-version ? 600 : 400;
                                                color: lv.version == root.selected-loader-version ? Theme.accent : Theme.text-primary;
                                                horizontal-stretch: 1;
                                                vertical-alignment: center;
                                                overflow: elide;
                                            }

                                            if lv.recommended: VerticalLayout {
                                                alignment: center;
                                                Image {
                                                    source: Theme.icon-star;
                                                    width: 12px;
                                                    height: 12px;
                                                    colorize: Theme.accent;
                                                }
                                            }

                                            if lv.status-label != "": Text {
                                                text: lv.status-label;
                                                font-size: Theme.font-xs;
                                                font-weight: lv.recommended ? 600 : 400;
                                                color: lv.recommended
                                                    ? Theme.accent
                                                    : lv.stable ? Theme.text-secondary : Theme.warning-text;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }
                                }
                            }

                            CrabTextInput {
                                enabled: root.selected-modloader != 0 && !root.is-creating;
                                text <=> root.loader-search-query;
                                placeholder: "Filter loader versions...";
                                leading-icon: Theme.icon-search;
                                has-leading-icon: true;
                                edited => { root.loader-search-changed(); }
                            }
                        }
                    }
                }
            }
        }

        if root.error-message != "": Rectangle {
            height: 30px;
            border-radius: Theme.radius-sm;
            background: Theme.error-bg;
            border-width: 1px;
            border-color: Theme.error-border;

            HorizontalLayout {
                padding-left: Theme.space-sm;
                padding-right: Theme.space-sm;
                Text {
                    text: root.error-message;
                    font-size: Theme.font-xs;
                    color: Theme.error-text;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }
        }

        // 3. Footer
        if root.active-source != 0 && root.error-message != "": Text {
            text: root.error-message;
            color: Theme.error-text;
            wrap: word-wrap;
        }
        HorizontalLayout {
            spacing: Theme.space-sm;

            Text {
                text: root.active-source != 0
                    ? (root.is-creating ? "Installing modpack files…" : "")
                    : root.selected-version-id != ""
                    ? (root.selected-modloader == 0
                        ? "Minecraft " + root.selected-version-id + " • Vanilla"
                        : "Minecraft " + root.selected-version-id + " • " + root.modloader-name
                            + (root.selected-loader-version != "" ? " " + root.selected-loader-version : ""))
                    : "Select a Minecraft version";
                font-size: Theme.font-xs;
                font-weight: 500;
                color: Theme.text-secondary;
                horizontal-stretch: 1;
                vertical-alignment: center;
                overflow: elide;
            }

            CrabButton {
                text: Strings.cancel;
                icon: Theme.icon-x;
                has-icon: true;
                variant: "secondary";
                enabled: !root.is-creating;
                clicked => { root.cancel-clicked(); }
            }

            CrabButton {
                text: root.active-source == 0 ? "Create Instance" : "Install Modpack";
                icon: Theme.icon-check;
                has-icon: true;
                variant: "primary";
                enabled: root.can-create;
                clicked => {
                    if (root.active-source == 0) { root.create-clicked(); }
                    else { root.install-pack(); }
                }
            }
        }
    }
}
