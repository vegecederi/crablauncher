import { ListView, ScrollView, TextEdit } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { CrabButton } from "../components/button.slint";
import { CrabTextInput } from "../components/input.slint";
import { CrabCheckbox } from "../components/checkbox.slint";
import { CrabRadioButton } from "../components/radio.slint";
import { CrabDropdown, DropdownOption } from "../components/dropdown.slint";
import { NavigationItem } from "../components/navigation-item.slint";
import { SettingsSection } from "../components/settings-section.slint";
import { AccountItem } from "accounts-window.slint";

export struct JavaRuntimeItem {
    path: string,
    label: string,
    major: int,
}

export struct ThemeItem {
    id: string,
    name: string,
    author: string,
    version: string,
    description: string,
    is-builtin: bool,
    is-active: bool,
    swatch-bg: color,
    swatch-surface: color,
    swatch-border: color,
    swatch-accent: color,
    swatch-text: color,
    swatch-text-sec: color,
}

export struct IconPackItem {
    id: string,
    name: string,
    author: string,
    version: string,
    description: string,
    is-builtin: bool,
    is-active: bool,
}

export component SettingsWindow inherits Window {
    title: "Settings — Crab";
    icon: @image-url("../../assets/app/logo-icon.svg");
    default-font-family: Theme.font-family;
    preferred-width: 820px;
    preferred-height: 720px;
    min-width: 680px;
    min-height: 480px;
    background: Theme.bg-primary;

    in-out property <int> active-tab: 0; // 0=General, 1=Java, 2=Minecraft, 3=Downloads, 4=About, 5=Appearance
    in-out property <int> mc-subtab: 0; // 0=General, 1=Java, 2=Console, 3=Tweaks
    in-out property <int> appearance-subtab: 0; // 0=Themes, 1=Instance Grid

    // General & Language
    in-out property <string> language: "en";
    in property <[DropdownOption]> language-options: [];
    in-out property <string> language-label: "English";
    in-out property <bool> confirm-instance-delete: true;
    in-out property <bool> confirm-group-delete: true;
    in-out property <bool> launch-on-double-click: false;
    in-out property <int> rename-folder-policy: 2; // 0=Ask, 1=Always, 2=Never

    // Folders
    in-out property <string> folder-instances: "";
    in-out property <string> folder-mods: "";
    in-out property <string> folder-icons: "";
    in-out property <string> folder-java-runtimes: "";
    in-out property <string> folder-skins: "";
    in-out property <string> folder-downloads: "";

    // Console (General)
    in-out property <string> console-history-limit: "150000";
    in-out property <bool> console-stop-on-overflow: true;

    // Tasks
    in-out property <string> concurrent-task-limit: "10";
    in-out property <string> concurrent-download-limit: "6";
    in-out property <string> retry-limit: "1";
    in-out property <string> http-timeout-secs: "60";

    // Java Runtime Management & Selection
    in property <[JavaRuntimeItem]> java-runtimes: [];
    in-out property <bool> java-auto-select: true;
    in-out property <bool> java-auto-download: true;
    in-out property <int> java-preferred-provider: 0; // 0=Mojang, 1=Adoptium, 2=Azul, 3=Semeru
    in property <[DropdownOption]> java-provider-options: [];
    in-out property <string> java-provider-id: "mojang";
    in-out property <string> java-provider-label: "Mojang";
    in-out property <string> java-manual-path: "";
    in property <string> java-selected-summary: "Automatic (compatible with Minecraft version)";
    in-out property <string> java-add-path: "";
    in property <string> java-status-message: "";
    in property <bool> java-busy: false;

    // System RAM & Diagnostics
    in property <string> system-ram-display: "";
    in property <string> system-avail-ram-display: "";
    in property <int> system-ram-total-mib: 16384;

    // Minecraft — General (Game Window + Launcher Behavior + Launch Preferences)
    in-out property <string> window-width: "854";
    in-out property <string> window-height: "480";
    in-out property <bool> start-fullscreen: false;
    in-out property <bool> use-custom-resolution: true;
    in property <[DropdownOption]> resolution-preset-options: [];
    in-out property <string> resolution-preset-id: "854x480";
    in-out property <string> resolution-preset-label: "854 × 480";

    in-out property <int> on-launch-behavior: 0; // 0=KeepOpen, 1=Minimize, 2=Hide, 3=Close
    in-out property <bool> reopen-on-exit: true;
    in-out property <bool> reopen-on-crash: true;
    in-out property <bool> reopen-on-kill: false;

    in-out property <bool> check-java-compatibility: true;
    in-out property <bool> warn-incompatible-java: true;
    in-out property <bool> verify-before-launch: true;
    in-out property <bool> auto-repair-missing: true;
    in-out property <bool> allow-multiple-instances: true;
    in-out property <bool> confirm-before-stopping: false;

    // Minecraft — Java (Memory + JVM Arguments)
    in-out property <string> min-memory-mb: "512";
    in-out property <string> max-memory-mb: "2048";
    in property <[DropdownOption]> memory-preset-options: [];
    in-out property <string> memory-preset-id: "2048";
    in-out property <string> memory-preset-label: "2 GiB — 2048 MiB";
    in property <string> memory-warning: "";
    in-out property <bool> warn-insufficient-memory: true;
    in-out property <bool> use-default-jvm-args: true;
    in property <[DropdownOption]> jvm-preset-options: [];
    in-out property <string> jvm-preset-id: "default";
    in-out property <string> jvm-preset-label: "Launcher Default";
    in property <string> jvm-preset-description: "";
    in property <string> jvm-preset-compat: "";
    in-out property <string> jvm-args: "";
    in property <string> jvm-conflict-warning: "";
    in property <string> jvm-test-result: "";

    // Minecraft — Console (Behavior + Appearance + Logging)
    in-out property <bool> show-console-on-launch: true;
    in-out property <bool> show-console-on-crash: true;
    in-out property <bool> close-console-on-exit: false;
    in-out property <bool> console-autoscroll: true;
    in-out property <bool> console-word-wrap: true;
    in-out property <bool> confirm-before-clearing-console: false;

    in-out property <string> console-font-family: "JetBrains Mono";
    in-out property <string> console-font-size: "12";
    in-out property <string> console-line-spacing: "2";
    in-out property <bool> console-use-theme-font: true;
    in-out property <bool> console-colorize-levels: true;
    in-out property <bool> console-show-timestamps: true;

    in-out property <string> console-max-lines: "4000";
    in-out property <bool> preserve-complete-logs: true;

    // Minecraft — Tweaks (Linux Performance Integration + System Information)
    in property <bool> is-linux: true;
    in-out property <bool> enable-gamemode: false;
    in property <bool> gamemode-available: false;
    in property <string> gamemode-status: "Not Installed";

    in-out property <bool> enable-mangohud: false;
    in property <bool> mangohud-available: false;
    in property <string> mangohud-status: "Not Installed";
    in property <bool> mangohud-has-config: false;

    in-out property <bool> use-discrete-gpu: false;
    in property <bool> discrete-gpu-available: false;
    in property <string> gpu-detail: "";

    in-out property <bool> use-zink: false;
    in property <bool> zink-available: false;
    in property <string> zink-status: "";

    in property <string> tweaks-feedback: "";

    // System Info fields for Tweaks -> System Information
    in property <string> sys-os: "";
    in property <string> sys-arch: "";
    in property <string> sys-ram: "";
    in property <string> sys-gpu: "";
    in property <string> sys-session: "";
    in property <string> sys-gamemode: "";
    in property <string> sys-mangohud: "";
    in property <string> sys-vulkan: "";

    // Downloads
    in-out property <string> max-concurrent-downloads: "16";
    in property <string> data-dir-display: "";
    in property <string> config-dir-display: "";
    in property <string> cache-dir-display: "";

    // Proxy
    in-out property <int> proxy-mode: 0; // 0=System, 1=None, 2=Manual
    in-out property <string> proxy-host: "";
    in-out property <string> proxy-port: "8080";

    // Appearance / Themes + Instance Grid
    in property <[ThemeItem]> themes: [];
    in-out property <string> selected-theme-id: "crab-dark";
    in-out property <int> grid-icon-size: 1; // 0=Small, 1=Medium, 2=Large
    in-out property <int> grid-spacing: 1; // 0=Compact, 1=Normal, 2=Spacious
    in-out property <bool> grid-show-name: true;
    in-out property <bool> grid-show-version: false;
    in-out property <bool> grid-show-modloader: false;
    in-out property <int> grid-sort-by: 1; // 0=Name, 1=Creation Date, 2=Last Played, 3=Manual Order

    // About / Status
    in property <string> app-version: "v0.1.0";
    in property <string> system-info-text: "";
    in property <string> error-message: "";

    // Callbacks
    callback language-selected(string);
    callback java-provider-selected(string);
    callback auto-detect-java();
    callback detect-java-selector-clicked();
    callback browse-java-clicked();
    callback open-install-java-clicked();
    callback add-java-clicked(string);
    callback remove-managed-java-clicked(string);
    callback download-java-clicked(int);
    callback test-java-clicked(string);
    callback resolution-preset-selected(string);
    callback resolution-fields-edited();
    callback memory-preset-selected(string);
    callback memory-fields-edited();
    callback jvm-preset-selected(string);
    callback jvm-args-edited();
    callback manage-jvm-presets-clicked();
    callback save-as-jvm-preset-clicked(string);
    callback test-jvm-args-clicked(string, string, string, string);
    callback copy-jvm-args-clicked(string);
    callback open-logs-folder-clicked();
    callback copy-latest-log-clicked();
    callback open-mangohud-config-clicked();
    callback refresh-system-info-clicked();
    callback apply-theme-clicked(string);
    callback import-theme-clicked();
    callback open-themes-folder-clicked();
    callback refresh-themes-clicked();
    callback copy-system-info-clicked();
    callback apply-clicked();
    // Icon Packs (Appearance -> Icons)
    in property <[IconPackItem]> icon-packs: [];
    in-out property <string> active-icon-pack-id: "lucide";
    private property <string> hovered-icon-pack-id: "";
    private property <string> preview-pack-id: root.hovered-icon-pack-id != "" ? root.hovered-icon-pack-id : root.active-icon-pack-id;
    callback icon-pack-selected(string);
    callback import-icon-pack-clicked();
    callback open-icon-packs-folder-clicked();
    callback refresh-icon-packs-clicked();
    callback reset-icon-pack-clicked();

    // Accounts tab (reutiliza AccountManager)
    in property <[AccountItem]> accounts: [];
    in-out property <string> selected-account-id: "";
    in-out property <string> offline-account-input: "";
    private property <bool> show-add-offline-dialog: false;
    in property <string> accounts-error-message: "";

    callback add-microsoft-account-clicked();
    callback add-offline-account-clicked(string);
    callback request-add-offline-account-dialog();
    callback refresh-accounts-clicked();
    callback remove-account-clicked(string);
    callback set-default-account-clicked(string);
    callback no-default-account-clicked();

    callback save-clicked();
    callback browse-folder-clicked(string);
    callback reset-folder-paths-clicked();
    callback close-clicked();

    VerticalLayout {
        HorizontalLayout {
            vertical-stretch: 1;

            // Navegação lateral interna com ícones 18x18 consistentes
            Rectangle {
                width: 164px;
                background: Theme.bg-secondary;

                Rectangle {
                    x: parent.width - 1px;
                    width: 1px;
                    height: parent.height;
                    background: Theme.border;
                }

                VerticalLayout {
                    padding: Theme.space-sm;
                    spacing: Theme.space-xs;

                    NavigationItem {
                        label: "General";
                        icon: @image-url("../../assets/icons/settings.svg");
                        selected: root.active-tab == 0;
                        clicked => { root.active-tab = 0; }
                    }

                    NavigationItem {
                        label: "Appearance";
                        icon: @image-url("../../assets/icons/layers.svg");
                        selected: root.active-tab == 5;
                        clicked => { root.active-tab = 5; }
                    }

                    NavigationItem {
                        label: "Java";
                        icon: @image-url("../../assets/icons/coffee.svg");
                        selected: root.active-tab == 1;
                        clicked => { root.active-tab = 1; }
                    }

                    NavigationItem {
                        label: "Minecraft";
                        icon: @image-url("../../assets/icons/cube.svg");
                        selected: root.active-tab == 2;
                        clicked => { root.active-tab = 2; }
                    }

                    NavigationItem {
                        label: "Downloads";
                        icon: @image-url("../../assets/icons/download.svg");
                        selected: root.active-tab == 3;
                        clicked => { root.active-tab = 3; }
                    }

                    NavigationItem {
                        label: "Accounts";
                        icon: @image-url("../../assets/icons/user.svg");
                        selected: root.active-tab == 6;
                        clicked => {
                            root.active-tab = 6;
                            root.refresh-accounts-clicked();
                        }
                    }

                    NavigationItem {
                        label: "About";
                        icon: @image-url("../../assets/icons/info.svg");
                        selected: root.active-tab == 4;
                        clicked => { root.active-tab = 4; }
                    }

                    Rectangle {
                        vertical-stretch: 1;
                    }
                }
            }

            // Conteúdo da categoria selecionada
            Rectangle {
                horizontal-stretch: 1;
                background: Theme.bg-primary;

                // 0: General
                if root.active-tab == 0: ScrollView {
                    width: parent.width;
                    height: parent.height;

                    VerticalLayout {
                        padding: Theme.space-lg;
                        spacing: Theme.space-md;
                        alignment: start;

                        Text {
                            text: "General";
                            font-size: Theme.font-xl;
                            font-weight: 600;
                            color: Theme.text-primary;
                        }

                        SettingsSection {
                            title: "Language";
                            CrabDropdown {
                                width: 240px;
                                options: root.language-options;
                                selected-id <=> root.language;
                                selected-label: root.language-label;
                                selected(id) => { root.language-selected(id); }
                            }
                        }

                        SettingsSection {
                            title: "Confirmations & Interaction";
                            CrabCheckbox {
                                label: "Confirm before deleting an instance";
                                checked <=> root.confirm-instance-delete;
                                toggled => { root.save-clicked(); }
                            }

                            CrabCheckbox {
                                label: "Confirm before deleting a group";
                                checked <=> root.confirm-group-delete;
                                toggled => { root.save-clicked(); }
                            }

                            CrabCheckbox {
                                label: "Launch instance on double-click";
                                checked <=> root.launch-on-double-click;
                                toggled => { root.save-clicked(); }
                            }
                        }

                        SettingsSection {
                            title: "Instance Renaming";
                            CrabRadioButton {
                                label: "Ask what to do";
                                selected: root.rename-folder-policy == 0;
                                clicked => { root.rename-folder-policy = 0; root.save-clicked(); }
                            }
                            CrabRadioButton {
                                label: "Always rename the folder";
                                selected: root.rename-folder-policy == 1;
                                clicked => { root.rename-folder-policy = 1; root.save-clicked(); }
                            }
                            CrabRadioButton {
                                label: "Never rename the folder";
                                selected: root.rename-folder-policy == 2;
                                clicked => { root.rename-folder-policy = 2; root.save-clicked(); }
                            }
                        }

                        SettingsSection {
                            title: "Folders";

                            HorizontalLayout {
                                spacing: Theme.space-sm;
                                Text { text: "Instances"; width: 112px; font-size: Theme.font-sm; color: Theme.text-secondary; vertical-alignment: center; }
                                CrabTextInput { horizontal-stretch: 1; text <=> root.folder-instances; placeholder: "Default instances directory"; edited => { root.save-clicked(); } accepted => { root.save-clicked(); } }
                                CrabButton { text: "Browse"; variant: "secondary"; clicked => { root.browse-folder-clicked("instances"); } }
                            }
                            HorizontalLayout {
                                spacing: Theme.space-sm;
                                Text { text: "Mods"; width: 112px; font-size: Theme.font-sm; color: Theme.text-secondary; vertical-alignment: center; }
                                CrabTextInput { horizontal-stretch: 1; text <=> root.folder-mods; placeholder: "Default shared mods directory"; edited => { root.save-clicked(); } accepted => { root.save-clicked(); } }
                                CrabButton { text: "Browse"; variant: "secondary"; clicked => { root.browse-folder-clicked("mods"); } }
                            }
                            HorizontalLayout {
                                spacing: Theme.space-sm;
                                Text { text: "Icons"; width: 112px; font-size: Theme.font-sm; color: Theme.text-secondary; vertical-alignment: center; }
                                CrabTextInput { horizontal-stretch: 1; text <=> root.folder-icons; placeholder: "Default icons directory"; edited => { root.save-clicked(); } accepted => { root.save-clicked(); } }
                                CrabButton { text: "Browse"; variant: "secondary"; clicked => { root.browse-folder-clicked("icons"); } }
                            }
                            HorizontalLayout {
                                spacing: Theme.space-sm;
                                Text { text: "Java Runtimes"; width: 112px; font-size: Theme.font-sm; color: Theme.text-secondary; vertical-alignment: center; }
                                CrabTextInput { horizontal-stretch: 1; text <=> root.folder-java-runtimes; placeholder: "Default Java runtimes directory"; edited => { root.save-clicked(); } accepted => { root.save-clicked(); } }
                                CrabButton { text: "Browse"; variant: "secondary"; clicked => { root.browse-folder-clicked("runtimes"); } }
                            }
                            HorizontalLayout {
                                spacing: Theme.space-sm;
                                Text { text: "Skins"; width: 112px; font-size: Theme.font-sm; color: Theme.text-secondary; vertical-alignment: center; }
                                CrabTextInput { horizontal-stretch: 1; text <=> root.folder-skins; placeholder: "Default skins directory"; edited => { root.save-clicked(); } accepted => { root.save-clicked(); } }
                                CrabButton { text: "Browse"; variant: "secondary"; clicked => { root.browse-folder-clicked("skins"); } }
                            }
                            HorizontalLayout {
                                spacing: Theme.space-sm;
                                Text { text: "Downloads"; width: 112px; font-size: Theme.font-sm; color: Theme.text-secondary; vertical-alignment: center; }
                                CrabTextInput { horizontal-stretch: 1; text <=> root.folder-downloads; placeholder: "Default downloads directory"; edited => { root.save-clicked(); } accepted => { root.save-clicked(); } }
                                CrabButton { text: "Browse"; variant: "secondary"; clicked => { root.browse-folder-clicked("downloads"); } }
                            }
                            HorizontalLayout {
                                alignment: start;
                                CrabButton {
                                    text: "Reset Folder Paths";
                                    variant: "secondary";
                                    clicked => { root.reset-folder-paths-clicked(); }
                                }
                            }
                        }

                        SettingsSection {
                            title: "Console";

                            HorizontalLayout {
                                spacing: Theme.space-sm;
                                Text { text: "Log History Limit"; width: 164px; font-size: Theme.font-sm; color: Theme.text-secondary; vertical-alignment: center; }
                                CrabTextInput { width: 120px; text <=> root.console-history-limit; placeholder: "150000"; edited => { root.save-clicked(); } accepted => { root.save-clicked(); } }
                                Text { text: "lines"; font-size: Theme.font-xs; color: Theme.text-secondary; vertical-alignment: center; }
                            }

                            CrabCheckbox {
                                label: "Stop logging when log overflows";
                                checked <=> root.console-stop-on-overflow;
                                toggled => { root.save-clicked(); }
                            }
                        }

                        SettingsSection {
                            title: "Tasks";

                            HorizontalLayout {
                                spacing: Theme.space-sm;
                                Text { text: "Concurrent Task Limit"; width: 184px; font-size: Theme.font-sm; color: Theme.text-secondary; vertical-alignment: center; }
                                CrabTextInput { width: 96px; text <=> root.concurrent-task-limit; placeholder: "10"; edited => { root.save-clicked(); } accepted => { root.save-clicked(); } }
                            }
                            HorizontalLayout {
                                spacing: Theme.space-sm;
                                Text { text: "Concurrent Download Limit"; width: 184px; font-size: Theme.font-sm; color: Theme.text-secondary; vertical-alignment: center; }
                                CrabTextInput { width: 96px; text <=> root.concurrent-download-limit; placeholder: "6"; edited => { root.save-clicked(); } accepted => { root.save-clicked(); } }
                            }
                            HorizontalLayout {
                                spacing: Theme.space-sm;
                                Text { text: "Retry Limit"; width: 184px; font-size: Theme.font-sm; color: Theme.text-secondary; vertical-alignment: center; }
                                CrabTextInput { width: 96px; text <=> root.retry-limit; placeholder: "1"; edited => { root.save-clicked(); } accepted => { root.save-clicked(); } }
                            }
                            HorizontalLayout {
                                spacing: Theme.space-sm;
                                Text { text: "HTTP Timeout"; width: 184px; font-size: Theme.font-sm; color: Theme.text-secondary; vertical-alignment: center; }
                                CrabTextInput { width: 96px; text <=> root.http-timeout-secs; placeholder: "60"; edited => { root.save-clicked(); } accepted => { root.save-clicked(); } }
                                Text { text: "seconds"; font-size: Theme.font-xs; color: Theme.text-secondary; vertical-alignment: center; }
                            }
                        }
                    }
                }

                // 1: Java (dedicada ao gerenciamento de runtimes instalados e provedores)
                if root.active-tab == 1: VerticalLayout {
                    width: parent.width;
                    height: parent.height;
                    padding: Theme.space-lg;
                    spacing: Theme.space-md;

                    Text {
                        text: "Java Runtimes";
                        font-size: Theme.font-xl;
                        font-weight: 600;
                        color: Theme.text-primary;
                    }

                    HorizontalLayout {
                        spacing: Theme.space-sm;
                        alignment: start;

                        CrabButton {
                            text: "Auto-detect";
                            icon: @image-url("../../assets/icons/scan-search.svg");
                            has-icon: true;
                            variant: "secondary";
                            enabled: !root.java-busy;
                            clicked => { root.auto-detect-java(); }
                        }

                        CrabButton {
                            text: "Install Java...";
                            icon: @image-url("../../assets/icons/download.svg");
                            has-icon: true;
                            variant: "primary";
                            enabled: !root.java-busy;
                            clicked => { root.open-install-java-clicked(); }
                        }

                        CrabButton {
                            text: "Remove Selected Managed";
                            icon: @image-url("../../assets/icons/trash.svg");
                            has-icon: true;
                            variant: "flat-danger";
                            enabled: root.java-manual-path != "" && !root.java-busy;
                            clicked => { root.remove-managed-java-clicked(root.java-manual-path); }
                        }
                    }

                    HorizontalLayout {
                        spacing: Theme.space-sm;
                        alignment: start;
                        Text {
                            text: "Preferred Provider:";
                            font-size: Theme.font-xs;
                            color: Theme.text-secondary;
                            vertical-alignment: center;
                        }
                        CrabDropdown {
                            width: 240px;
                            has-selected-icon: true;
                            selected-icon: root.java-provider-id == "adoptium"
                                ? @image-url("../../assets/java-providers/adoptium.png")
                                : root.java-provider-id == "azul"
                                    ? @image-url("../../assets/java-providers/azul-zulu.png")
                                    : root.java-provider-id == "semeru"
                                        ? @image-url("../../assets/java-providers/ibm-semeru.jpg")
                                        : @image-url("../../assets/java-providers/mojang.png");
                            options: [
                                { id: "mojang", label: "Mojang", detail: "Official", enabled: true, icon: @image-url("../../assets/java-providers/mojang.png"), has-icon: true },
                                { id: "adoptium", label: "Eclipse Adoptium", detail: "Temurin", enabled: true, icon: @image-url("../../assets/java-providers/adoptium.png"), has-icon: true },
                                { id: "azul", label: "Azul Zulu", detail: "OpenJDK", enabled: true, icon: @image-url("../../assets/java-providers/azul-zulu.png"), has-icon: true },
                                { id: "semeru", label: "IBM Semeru", detail: "OpenJ9", enabled: true, icon: @image-url("../../assets/java-providers/ibm-semeru.jpg"), has-icon: true },
                            ];
                            selected-id <=> root.java-provider-id;
                            selected-label: root.java-provider-label;
                            selected(id) => { root.java-provider-selected(id); }
                        }
                    }

                    CrabCheckbox {
                        label: "Automatically download required Java when missing";
                        checked <=> root.java-auto-download;
                        toggled => { root.save-clicked(); }
                    }

                    Rectangle {
                        vertical-stretch: 1;
                        border-radius: Theme.radius-sm;
                        background: Theme.bg-secondary;
                        border-width: 1px;
                        border-color: Theme.border;
                        clip: true;

                        if root.java-runtimes.length == 0: Text {
                            text: "No Java runtimes detected. Click Auto-detect or Install Java.";
                            font-size: Theme.font-sm;
                            color: Theme.text-secondary;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }

                        if root.java-runtimes.length > 0: ListView {
                            for rt in root.java-runtimes: Rectangle {
                                height: 34px;
                                background: rt.path == root.java-manual-path
                                    ? Theme.accent-muted
                                    : rt-touch.has-hover ? Theme.bg-interactive : transparent;

                                rt-touch := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => {
                                        root.java-manual-path = rt.path;
                                    }
                                }

                                HorizontalLayout {
                                    padding-left: Theme.space-sm;
                                    padding-right: Theme.space-sm;
                                    Text {
                                        text: rt.label;
                                        font-size: Theme.font-sm;
                                        color: rt.path == root.java-manual-path ? Theme.accent : Theme.text-primary;
                                        vertical-alignment: center;
                                        overflow: elide;
                                    }
                                }

                                Rectangle {
                                    y: parent.height - 1px;
                                    height: 1px;
                                    width: parent.width;
                                    background: Theme.border-subtle;
                                }
                            }
                        }
                    }

                    HorizontalLayout {
                        spacing: Theme.space-sm;
                        CrabTextInput {
                            horizontal-stretch: 1;
                            text <=> root.java-add-path;
                            placeholder: "Add custom Java executable path...";
                            edited => { root.save-clicked(); }
                        }
                        CrabButton {
                            text: "Add Java";
                            icon: @image-url("../../assets/icons/plus.svg");
                            has-icon: true;
                            variant: "secondary";
                            enabled: root.java-add-path != "" && !root.java-busy;
                            clicked => {
                                root.add-java-clicked(root.java-add-path);
                                root.java-add-path = "";
                            }
                        }
                    }

                    if root.java-status-message != "": Text {
                        text: root.java-status-message;
                        font-size: Theme.font-xs;
                        color: Theme.text-secondary;
                        wrap: word-wrap;
                    }
                }

                // 2: Minecraft (4 abas secundárias: General | Java | Console | Tweaks)
                if root.active-tab == 2: VerticalLayout {
                    width: parent.width;
                    height: parent.height;
                    padding: Theme.space-lg;
                    spacing: Theme.space-md;

                    Text {
                        text: "Minecraft";
                        font-size: Theme.font-xl;
                        font-weight: 600;
                        color: Theme.text-primary;
                    }

                    HorizontalLayout {
                        spacing: 4px;
                        alignment: start;

                        CrabButton {
                            text: "General";
                            icon: @image-url("../../assets/icons/settings.svg");
                            has-icon: true;
                            variant: root.mc-subtab == 0 ? "primary" : "secondary";
                            clicked => { root.mc-subtab = 0; }
                        }
                        CrabButton {
                            text: "Java";
                            icon: @image-url("../../assets/icons/coffee.svg");
                            has-icon: true;
                            variant: root.mc-subtab == 1 ? "primary" : "secondary";
                            clicked => { root.mc-subtab = 1; }
                        }
                        CrabButton {
                            text: "Console";
                            icon: @image-url("../../assets/icons/terminal.svg");
                            has-icon: true;
                            variant: root.mc-subtab == 2 ? "primary" : "secondary";
                            clicked => { root.mc-subtab = 2; }
                        }
                        CrabButton {
                            text: "Tweaks";
                            icon: @image-url("../../assets/icons/sliders-horizontal.svg");
                            has-icon: true;
                            variant: root.mc-subtab == 3 ? "primary" : "secondary";
                            clicked => { root.mc-subtab = 3; }
                        }
                    }

                    Flickable {
                        vertical-stretch: 1;
                        horizontal-stretch: 1;
                        content-width: self.width;
                        content-height: mc-inner.preferred-height + 20px;

                        mc-inner := VerticalLayout {
                            width: parent.width;
                            spacing: 12px;
                            alignment: start;

                            // 0: General (Game Window + Launcher Behavior + Launch Preferences)
                            if root.mc-subtab == 0: VerticalLayout {
                                horizontal-stretch: 1;
                                max-width: 99999px;
                                spacing: 12px;

                                SettingsSection {
                                    title: "Game Window";

                                    CrabCheckbox {
                                        label: "Start Minecraft in Fullscreen";
                                        checked <=> root.start-fullscreen;
                                        toggled => { root.save-clicked(); }
                                    }

                                    CrabCheckbox {
                                        label: "Use Custom Window Resolution";
                                        checked <=> root.use-custom-resolution;
                                        enabled: !root.start-fullscreen;
                                        toggled => { root.save-clicked(); }
                                    }

                                    VerticalLayout {
                                        spacing: 4px;
                                        Text { text: "Resolution Preset"; font-size: Theme.font-xs; color: Theme.text-secondary; }
                                        CrabDropdown {
                                            width: 260px;
                                            options: root.resolution-preset-options;
                                            selected-id <=> root.resolution-preset-id;
                                            selected-label: root.resolution-preset-label;
                                            enabled: root.use-custom-resolution && !root.start-fullscreen;
                                            selected(id) => { root.resolution-preset-selected(id); }
                                        }
                                    }

                                    HorizontalLayout {
                                        spacing: Theme.space-md;
                                        alignment: start;

                                        VerticalLayout {
                                            width: 150px;
                                            spacing: 4px;
                                            Text { text: "Window Width (px)"; font-size: Theme.font-xs; color: Theme.text-secondary; }
                                            CrabTextInput {
                                                text <=> root.window-width;
                                                enabled: root.use-custom-resolution && !root.start-fullscreen;
                                                placeholder: "854";
                                                edited(_) => { root.resolution-fields-edited(); }
                                            }
                                        }
                                        VerticalLayout {
                                            width: 150px;
                                            spacing: 4px;
                                            Text { text: "Window Height (px)"; font-size: Theme.font-xs; color: Theme.text-secondary; }
                                            CrabTextInput {
                                                text <=> root.window-height;
                                                enabled: root.use-custom-resolution && !root.start-fullscreen;
                                                placeholder: "480";
                                                edited(_) => { root.resolution-fields-edited(); }
                                            }
                                        }
                                    }
                                }

                                SettingsSection {
                                    title: "Launcher Behavior";

                                    Text {
                                        text: "When Minecraft Starts";
                                        font-size: Theme.font-xs;
                                        font-weight: 600;
                                        color: Theme.text-secondary;
                                    }

                                    VerticalLayout {
                                        spacing: 2px;
                                        CrabRadioButton {
                                            label: "Keep Launcher Open";
                                            selected: root.on-launch-behavior == 0;
                                            clicked => { root.on-launch-behavior = 0; }
                                        }
                                        CrabRadioButton {
                                            label: "Minimize Launcher";
                                            selected: root.on-launch-behavior == 1;
                                            clicked => { root.on-launch-behavior = 1; }
                                        }
                                        CrabRadioButton {
                                            label: "Hide Launcher";
                                            description: "Hides the window while keeping the launcher process active in the background.";
                                            selected: root.on-launch-behavior == 2;
                                            clicked => { root.on-launch-behavior = 2; }
                                        }
                                        CrabRadioButton {
                                            label: "Close Launcher";
                                            description: "Exits the GUI process; a lightweight headless supervisor monitors Minecraft and preserves logs.";
                                            selected: root.on-launch-behavior == 3;
                                            clicked => { root.on-launch-behavior = 3; }
                                        }
                                    }

                                    Rectangle { height: 1px; background: Theme.border-subtle; }

                                    Text {
                                        text: "When Minecraft Exits";
                                        font-size: Theme.font-xs;
                                        font-weight: 600;
                                        color: Theme.text-secondary;
                                    }

                                    CrabCheckbox {
                                        label: "Reopen Launcher After Game Exit";
                                        checked <=> root.reopen-on-exit;
                                        enabled: root.on-launch-behavior != 0;
                                        toggled => { root.save-clicked(); }
                                    }
                                    CrabCheckbox {
                                        label: "Reopen Launcher After Game Crash";
                                        checked <=> root.reopen-on-crash;
                                        enabled: root.on-launch-behavior != 0;
                                        toggled => { root.save-clicked(); }
                                    }
                                    CrabCheckbox {
                                        label: "Reopen Launcher After Game Is Killed";
                                        checked <=> root.reopen-on-kill;
                                        enabled: root.on-launch-behavior != 0;
                                        toggled => { root.save-clicked(); }
                                    }
                                }

                                SettingsSection {
                                    title: "Launch Preferences";

                                    CrabCheckbox {
                                        label: "Check Java compatibility before launch";
                                        checked <=> root.check-java-compatibility;
                                        toggled => { root.save-clicked(); }
                                    }
                                    CrabCheckbox {
                                        label: "Warn about incompatible Java versions";
                                        checked <=> root.warn-incompatible-java;
                                        enabled: root.check-java-compatibility;
                                        toggled => { root.save-clicked(); }
                                    }
                                    CrabCheckbox {
                                        label: "Verify required game files before launch";
                                        checked <=> root.verify-before-launch;
                                        toggled => { root.save-clicked(); }
                                    }
                                    CrabCheckbox {
                                        label: "Automatically repair missing game files";
                                        checked <=> root.auto-repair-missing;
                                        enabled: root.verify-before-launch;
                                        toggled => { root.save-clicked(); }
                                    }
                                    CrabCheckbox {
                                        label: "Allow multiple different instances to run simultaneously";
                                        checked <=> root.allow-multiple-instances;
                                        toggled => { root.save-clicked(); }
                                    }
                                    Text {
                                        text: "Running the same instance twice at the same time is always blocked to protect worlds and saves.";
                                        font-size: Theme.font-xs;
                                        color: Theme.text-secondary;
                                        wrap: word-wrap;
                                    }
                                    CrabCheckbox {
                                        label: "Confirm before stopping Minecraft";
                                        checked <=> root.confirm-before-stopping;
                                        toggled => { root.save-clicked(); }
                                    }
                                }
                            }

                            // 1: Java (Java Installation + Memory + Java Arguments)
                            if root.mc-subtab == 1: VerticalLayout {
                                horizontal-stretch: 1;
                                max-width: 99999px;
                                spacing: 12px;

                                SettingsSection {
                                    title: "Java Installation";

                                    CrabCheckbox {
                                        label: "Automatically select compatible Java";
                                        checked <=> root.java-auto-select;
                                        toggled => { root.save-clicked(); }
                                    }

                                    CrabCheckbox {
                                        label: "Automatically download required Java when missing";
                                        checked <=> root.java-auto-download;
                                        toggled => { root.save-clicked(); }
                                    }

                                    Text {
                                        text: "Selected Runtime: " + root.java-selected-summary;
                                        font-size: Theme.font-xs;
                                        color: Theme.text-secondary;
                                        wrap: word-wrap;
                                    }

                                    VerticalLayout {
                                        spacing: 4px;
                                        Text { text: "Java Executable Path"; font-size: Theme.font-xs; color: Theme.text-secondary; }
                                        CrabTextInput {
                                            text <=> root.java-manual-path;
                                            enabled: !root.java-auto-select;
                                            placeholder: "/usr/lib/jvm/.../bin/java";
                                            edited => { root.save-clicked(); }
                                        }
                                    }

                                    HorizontalLayout {
                                        spacing: Theme.space-xs;
                                        alignment: start;

                                        CrabButton {
                                            text: "Detect";
                                            icon: @image-url("../../assets/icons/scan-search.svg");
                                            has-icon: true;
                                            variant: "secondary";
                                            clicked => { root.detect-java-selector-clicked(); }
                                        }
                                        CrabButton {
                                            text: "Browse";
                                            icon: @image-url("../../assets/icons/folder.svg");
                                            has-icon: true;
                                            variant: "secondary";
                                            clicked => { root.browse-java-clicked(); }
                                        }
                                        CrabButton {
                                            text: "Test Settings";
                                            icon: @image-url("../../assets/icons/flask-conical.svg");
                                            has-icon: true;
                                            variant: "secondary";
                                            enabled: root.java-manual-path != "" && !root.java-busy;
                                            clicked => { root.test-java-clicked(root.java-manual-path); }
                                        }
                                        CrabButton {
                                            text: "Open Java Downloader";
                                            icon: @image-url("../../assets/icons/download.svg");
                                            has-icon: true;
                                            variant: "secondary";
                                            clicked => { root.open-install-java-clicked(); }
                                        }
                                    }

                                    if root.java-status-message != "": Text {
                                        text: root.java-status-message;
                                        font-size: Theme.font-xs;
                                        color: Theme.text-secondary;
                                        wrap: word-wrap;
                                    }
                                }

                                SettingsSection {
                                    title: "Memory";

                                    VerticalLayout {
                                        spacing: 4px;
                                        Text { text: "Memory Preset"; font-size: Theme.font-xs; color: Theme.text-secondary; }
                                        CrabDropdown {
                                            width: 260px;
                                            options: root.memory-preset-options;
                                            selected-id <=> root.memory-preset-id;
                                            selected-label: root.memory-preset-label;
                                            selected(id) => { root.memory-preset-selected(id); }
                                        }
                                    }

                                    HorizontalLayout {
                                        spacing: Theme.space-lg;
                                        alignment: start;

                                        VerticalLayout {
                                            width: 170px;
                                            spacing: 4px;
                                            Text { text: "Minimum Memory (MiB)"; font-size: Theme.font-xs; color: Theme.text-secondary; }
                                            CrabTextInput {
                                                text <=> root.min-memory-mb;
                                                placeholder: "512";
                                                edited(_) => { root.memory-fields-edited(); }
                                            }
                                        }
                                        VerticalLayout {
                                            width: 170px;
                                            spacing: 4px;
                                            Text { text: "Maximum Memory (MiB)"; font-size: Theme.font-xs; color: Theme.text-secondary; }
                                            CrabTextInput {
                                                text <=> root.max-memory-mb;
                                                placeholder: "2048";
                                                edited(_) => { root.memory-fields-edited(); }
                                            }
                                        }
                                    }

                                    Text {
                                        text: "JVM flags: -Xms" + root.min-memory-mb + "M  -Xmx" + root.max-memory-mb + "M";
                                        font-family: Theme.console-font-family;
                                        font-size: Theme.font-xs;
                                        color: Theme.text-secondary;
                                    }

                                    if root.memory-warning != "": Text {
                                        text: root.memory-warning;
                                        font-size: Theme.font-xs;
                                        color: Theme.warning-text;
                                        wrap: word-wrap;
                                    }

                                    if root.system-ram-display != "": Text {
                                        text: "Total System Memory: " + root.system-ram-display
                                            + (root.system-avail-ram-display != "" ? "  •  Available: " + root.system-avail-ram-display : "");
                                        font-size: Theme.font-xs;
                                        color: Theme.text-secondary;
                                    }

                                    CrabCheckbox {
                                        label: "Warn when available memory is insufficient";
                                        checked <=> root.warn-insufficient-memory;
                                        toggled => { root.save-clicked(); }
                                    }
                                }

                                SettingsSection {
                                    title: "Java Arguments";

                                    HorizontalLayout {
                                        spacing: Theme.space-sm;
                                        alignment: start;
                                        VerticalLayout {
                                            spacing: 4px;
                                            Text { text: "Argument Preset"; font-size: Theme.font-xs; color: Theme.text-secondary; }
                                            CrabDropdown {
                                                width: 260px;
                                                options: root.jvm-preset-options;
                                                selected-id <=> root.jvm-preset-id;
                                                selected-label: root.jvm-preset-label;
                                                selected(id) => { root.jvm-preset-selected(id); }
                                            }
                                        }
                                        VerticalLayout {
                                            alignment: end;
                                            CrabButton {
                                                text: "Manage Presets...";
                                                icon: @image-url("../../assets/icons/sliders-horizontal.svg");
                                                has-icon: true;
                                                variant: "secondary";
                                                clicked => { root.manage-jvm-presets-clicked(); }
                                            }
                                        }
                                    }

                                    if root.jvm-preset-description != "": Text {
                                        text: root.jvm-preset-description;
                                        font-size: Theme.font-xs;
                                        color: Theme.text-secondary;
                                        wrap: word-wrap;
                                    }

                                    if root.jvm-preset-compat != "": Text {
                                        text: "Compatibility: " + root.jvm-preset-compat;
                                        font-size: Theme.font-xs;
                                        color: Theme.text-secondary;
                                        wrap: word-wrap;
                                    }

                                    TextEdit {
                                        height: 84px;
                                        text <=> root.jvm-args;
                                        font-size: Theme.font-sm;
                                        edited(_) => { root.jvm-args-edited(); }
                                    }

                                    if root.jvm-conflict-warning != "": Text {
                                        text: root.jvm-conflict-warning;
                                        font-size: Theme.font-xs;
                                        color: Theme.warning-text;
                                        wrap: word-wrap;
                                    }

                                    HorizontalLayout {
                                        spacing: Theme.space-xs;
                                        alignment: start;

                                        CrabButton {
                                            text: "Reset to Default";
                                            icon: @image-url("../../assets/icons/refresh.svg");
                                            has-icon: true;
                                            variant: "secondary";
                                            clicked => {
                                                root.jvm-preset-selected("default");
                                            }
                                        }
                                        CrabButton {
                                            text: "Test Arguments";
                                            icon: @image-url("../../assets/icons/flask-conical.svg");
                                            has-icon: true;
                                            variant: "secondary";
                                            clicked => {
                                                root.test-jvm-args-clicked(
                                                    root.java-manual-path,
                                                    root.min-memory-mb,
                                                    root.max-memory-mb,
                                                    root.jvm-args
                                                );
                                            }
                                        }
                                        CrabButton {
                                            text: "Copy Arguments";
                                            icon: @image-url("../../assets/icons/copy.svg");
                                            has-icon: true;
                                            variant: "secondary";
                                            clicked => {
                                                root.copy-jvm-args-clicked(
                                                    "-Xms" + root.min-memory-mb + "M -Xmx" + root.max-memory-mb + "M " + root.jvm-args
                                                );
                                            }
                                        }
                                        CrabButton {
                                            text: "Save as Preset";
                                            icon: @image-url("../../assets/icons/save.svg");
                                            has-icon: true;
                                            variant: "secondary";
                                            enabled: root.jvm-args != "";
                                            clicked => { root.save-as-jvm-preset-clicked(root.jvm-args); }
                                        }
                                    }

                                    if root.jvm-test-result != "": Text {
                                        text: root.jvm-test-result;
                                        font-size: Theme.font-xs;
                                        color: Theme.text-secondary;
                                        wrap: word-wrap;
                                    }
                                }
                            }

                            // 2: Console (Behavior + Appearance + Logging)
                            if root.mc-subtab == 2: VerticalLayout {
                                horizontal-stretch: 1;
                                max-width: 99999px;
                                spacing: 12px;

                                SettingsSection {
                                    title: "Console Behavior";

                                    CrabCheckbox {
                                        label: "Show console automatically on launch";
                                        checked <=> root.show-console-on-launch;
                                        toggled => { root.save-clicked(); }
                                    }
                                    CrabCheckbox {
                                        label: "Show console when Minecraft crashes";
                                        checked <=> root.show-console-on-crash;
                                        toggled => { root.save-clicked(); }
                                    }
                                    CrabCheckbox {
                                        label: "Close console on successful exit";
                                        checked <=> root.close-console-on-exit;
                                        toggled => { root.save-clicked(); }
                                    }
                                    CrabCheckbox {
                                        label: "Automatically scroll to latest log";
                                        checked <=> root.console-autoscroll;
                                        toggled => { root.save-clicked(); }
                                    }
                                    CrabCheckbox {
                                        label: "Enable word wrap";
                                        checked <=> root.console-word-wrap;
                                        toggled => { root.save-clicked(); }
                                    }
                                    CrabCheckbox {
                                        label: "Confirm before clearing console";
                                        checked <=> root.confirm-before-clearing-console;
                                        toggled => { root.save-clicked(); }
                                    }
                                }

                                SettingsSection {
                                    title: "Console Appearance";

                                    CrabCheckbox {
                                        label: "Use theme default font (JetBrains Mono fallback)";
                                        checked <=> root.console-use-theme-font;
                                        toggled => { root.save-clicked(); }
                                    }

                                    HorizontalLayout {
                                        spacing: Theme.space-md;
                                        alignment: start;

                                        VerticalLayout {
                                            width: 200px;
                                            spacing: 4px;
                                            Text { text: "Font Family"; font-size: Theme.font-xs; color: Theme.text-secondary; }
                                            CrabTextInput {
                                                text <=> root.console-font-family;
                                                enabled: !root.console-use-theme-font;
                                                placeholder: "JetBrains Mono";
                                                edited => { root.save-clicked(); }
                                            }
                                        }
                                        VerticalLayout {
                                            width: 110px;
                                            spacing: 4px;
                                            Text { text: "Font Size (px)"; font-size: Theme.font-xs; color: Theme.text-secondary; }
                                            CrabTextInput {
                                                text <=> root.console-font-size;
                                                placeholder: "12";
                                                edited => { root.save-clicked(); }
                                            }
                                        }
                                        VerticalLayout {
                                            width: 120px;
                                            spacing: 4px;
                                            Text { text: "Line Spacing (px)"; font-size: Theme.font-xs; color: Theme.text-secondary; }
                                            CrabTextInput {
                                                text <=> root.console-line-spacing;
                                                placeholder: "2";
                                                edited => { root.save-clicked(); }
                                            }
                                        }
                                    }

                                    CrabCheckbox {
                                        label: "Colorize log levels";
                                        checked <=> root.console-colorize-levels;
                                        toggled => { root.save-clicked(); }
                                    }
                                    CrabCheckbox {
                                        label: "Show timestamps";
                                        checked <=> root.console-show-timestamps;
                                        toggled => { root.save-clicked(); }
                                    }

                                    HorizontalLayout {
                                        alignment: start;
                                        CrabButton {
                                            text: "Reset Console Appearance";
                                            icon: @image-url("../../assets/icons/refresh.svg");
                                            has-icon: true;
                                            variant: "secondary";
                                            clicked => {
                                                root.console-use-theme-font = true;
                                                root.console-font-family = "JetBrains Mono";
                                                root.console-font-size = "12";
                                                root.console-line-spacing = "2";
                                                root.console-colorize-levels = true;
                                                root.console-show-timestamps = true;
                                            }
                                        }
                                    }
                                }

                                SettingsSection {
                                    title: "Logging";

                                    HorizontalLayout {
                                        spacing: Theme.space-md;
                                        alignment: start;
                                        VerticalLayout {
                                            width: 180px;
                                            spacing: 4px;
                                            Text { text: "Maximum Visible Log Lines"; font-size: Theme.font-xs; color: Theme.text-secondary; }
                                            CrabTextInput { text <=> root.console-max-lines; placeholder: "4000"; edited => { root.save-clicked(); } }
                                        }
                                    }

                                    CrabCheckbox {
                                        label: "Preserve complete log files on disk";
                                        checked <=> root.preserve-complete-logs;
                                        toggled => { root.save-clicked(); }
                                    }

                                    Text {
                                        text: "Limiting visible console lines never truncates log files or Minecraft crash reports on disk.";
                                        font-size: Theme.font-xs;
                                        color: Theme.text-secondary;
                                        wrap: word-wrap;
                                    }

                                    HorizontalLayout {
                                        spacing: Theme.space-xs;
                                        alignment: start;
                                        CrabButton {
                                            text: "Open Logs Folder";
                                            icon: @image-url("../../assets/icons/folder.svg");
                                            has-icon: true;
                                            variant: "secondary";
                                            clicked => { root.open-logs-folder-clicked(); }
                                        }
                                        CrabButton {
                                            text: "Copy Latest Log";
                                            icon: @image-url("../../assets/icons/copy.svg");
                                            has-icon: true;
                                            variant: "secondary";
                                            clicked => { root.copy-latest-log-clicked(); }
                                        }
                                    }
                                }
                            }

                            // 3: Tweaks (Linux Performance Integration + System Information)
                            if root.mc-subtab == 3: VerticalLayout {
                                horizontal-stretch: 1;
                                max-width: 99999px;
                                spacing: 12px;

                                SettingsSection {
                                    title: "Performance";

                                    if !root.is-linux: Text {
                                        text: "Linux performance tweaks (GameMode, MangoHud, PRIME offload, Mesa Zink) are only available on Linux.";
                                        font-size: Theme.font-xs;
                                        color: Theme.text-secondary;
                                        wrap: word-wrap;
                                    }

                                    // Feral GameMode
                                    VerticalLayout {
                                        spacing: 2px;
                                        HorizontalLayout {
                                            spacing: Theme.space-sm;
                                            CrabCheckbox {
                                                horizontal-stretch: 1;
                                                label: "Enable Feral GameMode";
                                                checked <=> root.enable-gamemode;
                                                enabled: root.is-linux && root.gamemode-available;
                                                toggled => { root.save-clicked(); }
                                            }
                                            Text {
                                                text: root.gamemode-available
                                                    ? (root.enable-gamemode ? "Enabled" : "Available")
                                                    : root.gamemode-status;
                                                font-size: Theme.font-xs;
                                                color: root.gamemode-available ? Theme.success : Theme.text-secondary;
                                                vertical-alignment: center;
                                            }
                                        }
                                        Text {
                                            text: "Runs Minecraft through gamemoderun to request OS performance optimizations without affecting the Crab GUI.";
                                            font-size: Theme.font-xs;
                                            color: Theme.text-secondary;
                                            wrap: word-wrap;
                                        }
                                    }

                                    Rectangle { height: 1px; background: Theme.border-subtle; }

                                    // MangoHud
                                    VerticalLayout {
                                        spacing: 4px;
                                        HorizontalLayout {
                                            spacing: Theme.space-sm;
                                            CrabCheckbox {
                                                horizontal-stretch: 1;
                                                label: "Enable MangoHud";
                                                checked <=> root.enable-mangohud;
                                                enabled: root.is-linux && root.mangohud-available;
                                                toggled => { root.save-clicked(); }
                                            }
                                            Text {
                                                text: root.mangohud-available
                                                    ? (root.enable-mangohud ? "Enabled" : "Available")
                                                    : root.mangohud-status;
                                                font-size: Theme.font-xs;
                                                color: root.mangohud-available ? Theme.success : Theme.text-secondary;
                                                vertical-alignment: center;
                                            }
                                        }
                                        Text {
                                            text: "Displays performance overlay using mangohud --dlsym. Compatibility with legacy LWJGL 2 versions may vary.";
                                            font-size: Theme.font-xs;
                                            color: Theme.text-secondary;
                                            wrap: word-wrap;
                                        }
                                        HorizontalLayout {
                                            alignment: start;
                                            CrabButton {
                                                text: "Open MangoHud Configuration";
                                                icon: @image-url("../../assets/icons/external-link.svg");
                                                has-icon: true;
                                                variant: "secondary";
                                                enabled: root.is-linux;
                                                clicked => { root.open-mangohud-config-clicked(); }
                                            }
                                        }
                                    }

                                    Rectangle { height: 1px; background: Theme.border-subtle; }

                                    // Discrete GPU
                                    VerticalLayout {
                                        spacing: 2px;
                                        CrabCheckbox {
                                            label: "Use Discrete GPU";
                                            checked <=> root.use-discrete-gpu;
                                            enabled: root.is-linux && root.discrete-gpu-available;
                                            toggled => { root.save-clicked(); }
                                        }
                                        Text {
                                            text: root.gpu-detail;
                                            font-size: Theme.font-xs;
                                            color: Theme.text-secondary;
                                            wrap: word-wrap;
                                        }
                                    }

                                    Rectangle { height: 1px; background: Theme.border-subtle; }

                                    // Mesa Zink
                                    VerticalLayout {
                                        spacing: 2px;
                                        HorizontalLayout {
                                            spacing: Theme.space-sm;
                                            CrabCheckbox {
                                                horizontal-stretch: 1;
                                                label: "Use Zink";
                                                checked <=> root.use-zink;
                                                enabled: root.is-linux;
                                                toggled => { root.save-clicked(); }
                                            }
                                            Text {
                                                text: root.zink-available
                                                    ? (root.use-zink ? "Enabled" : "Available")
                                                    : root.zink-status;
                                                font-size: Theme.font-xs;
                                                color: root.zink-available ? Theme.success : Theme.warning-text;
                                                vertical-alignment: center;
                                            }
                                        }
                                        Text {
                                            text: "Runs OpenGL through Vulkan using Mesa Zink. Compatibility and performance may vary.";
                                            font-size: Theme.font-xs;
                                            color: Theme.text-secondary;
                                            wrap: word-wrap;
                                        }
                                        if !root.zink-available && root.use-zink: Text {
                                            text: "Warning: Mesa Zink / Vulkan support could not be confirmed on this system.";
                                            font-size: Theme.font-xs;
                                            color: Theme.warning-text;
                                            wrap: word-wrap;
                                        }
                                    }

                                    if root.tweaks-feedback != "": Text {
                                        text: root.tweaks-feedback;
                                        font-size: Theme.font-xs;
                                        color: Theme.warning-text;
                                        wrap: word-wrap;
                                    }
                                }

                                SettingsSection {
                                    title: "System Information";

                                    VerticalLayout {
                                        spacing: 3px;
                                        Text { text: "Operating System: " + root.sys-os; font-size: Theme.font-xs; color: Theme.text-secondary; }
                                        Text { text: "CPU Architecture: " + root.sys-arch; font-size: Theme.font-xs; color: Theme.text-secondary; }
                                        Text { text: "Physical Memory: " + root.sys-ram; font-size: Theme.font-xs; color: Theme.text-secondary; }
                                        Text { text: "Graphics Adapter: " + root.sys-gpu; font-size: Theme.font-xs; color: Theme.text-secondary; wrap: word-wrap; }
                                        Text { text: "Display Session: " + root.sys-session; font-size: Theme.font-xs; color: Theme.text-secondary; }
                                        Text { text: "GameMode: " + root.sys-gamemode; font-size: Theme.font-xs; color: Theme.text-secondary; }
                                        Text { text: "MangoHud: " + root.sys-mangohud; font-size: Theme.font-xs; color: Theme.text-secondary; }
                                        Text { text: "Vulkan: " + root.sys-vulkan; font-size: Theme.font-xs; color: Theme.text-secondary; wrap: word-wrap; }
                                    }

                                    HorizontalLayout {
                                        spacing: Theme.space-xs;
                                        alignment: start;

                                        CrabButton {
                                            text: "Refresh System Information";
                                            icon: @image-url("../../assets/icons/refresh.svg");
                                            has-icon: true;
                                            variant: "secondary";
                                            clicked => { root.refresh-system-info-clicked(); }
                                        }
                                        CrabButton {
                                            text: "Copy System Information";
                                            icon: @image-url("../../assets/icons/copy.svg");
                                            has-icon: true;
                                            variant: "secondary";
                                            clicked => { root.copy-system-info-clicked(); }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                // 3: Downloads
                if root.active-tab == 3: VerticalLayout {
                    width: parent.width;
                    height: parent.height;
                    padding: Theme.space-lg;
                    spacing: Theme.space-md;
                    alignment: start;

                    Text {
                        text: "Downloads";
                        font-size: Theme.font-xl;
                        font-weight: 600;
                        color: Theme.text-primary;
                    }

                    SettingsSection {
                        title: "Transfer Concurrency";
                        VerticalLayout {
                            spacing: Theme.space-xs;
                            Text {
                                text: "Max Concurrent Downloads (1 - 64)";
                                font-size: Theme.font-sm;
                                color: Theme.text-secondary;
                            }
                            CrabTextInput {
                                width: 120px;
                                text <=> root.max-concurrent-downloads;
                                placeholder: "16";
                                edited => { root.save-clicked(); }
                            }
                        }
                    }

                    SettingsSection {
                        title: "Storage Directories";
                        Text {
                            text: "Data: " + root.data-dir-display;
                            font-size: Theme.font-xs;
                            color: Theme.text-secondary;
                            overflow: elide;
                        }
                        Text {
                            text: "Config: " + root.config-dir-display;
                            font-size: Theme.font-xs;
                            color: Theme.text-secondary;
                            overflow: elide;
                        }
                        Text {
                            text: "Cache: " + root.cache-dir-display;
                            font-size: Theme.font-xs;
                            color: Theme.text-secondary;
                            overflow: elide;
                        }
                    }
                }

                // 5: Appearance (dividida em 2 sub-abas: Themes | Instance Grid)
                if root.active-tab == 5: VerticalLayout {
                    width: parent.width;
                    height: parent.height;
                    padding: Theme.space-lg;
                    spacing: Theme.space-md;

                    Text {
                        text: "Appearance";
                        font-size: Theme.font-xl;
                        font-weight: 600;
                        color: Theme.text-primary;
                    }

                    HorizontalLayout {
                        spacing: 4px;
                        alignment: start;

                        CrabButton {
                            text: "Themes";
                            icon: @image-url("../../assets/icons/palette.svg");
                            has-icon: true;
                            variant: root.appearance-subtab == 0 ? "primary" : "secondary";
                            clicked => { root.appearance-subtab = 0; }
                        }
                        CrabButton {
                            text: "Icons";
                            icon: @image-url("../../assets/icons/cube.svg");
                            has-icon: true;
                            variant: root.appearance-subtab == 1 ? "primary" : "secondary";
                            clicked => {
                                root.appearance-subtab = 1;
                                root.refresh-icon-packs-clicked();
                            }
                        }
                        CrabButton {
                            text: "Instance Grid";
                            icon: @image-url("../../assets/icons/layout-grid.svg");
                            has-icon: true;
                            variant: root.appearance-subtab == 2 ? "primary" : "secondary";
                            clicked => { root.appearance-subtab = 2; }
                        }
                    }

                    // Sub-aba 0: Themes (aplicação instantânea ao clicar; toolbar única acima da lista)
                    if root.appearance-subtab == 0: VerticalLayout {
                        vertical-stretch: 1;
                        horizontal-stretch: 1;
                        spacing: Theme.space-sm;

                        HorizontalLayout {
                            spacing: Theme.space-xs;
                            alignment: start;

                            CrabButton {
                                text: "Import Theme";
                                icon: @image-url("../../assets/icons/plus.svg");
                                has-icon: true;
                                variant: "secondary";
                                clicked => { root.import-theme-clicked(); }
                            }
                            CrabButton {
                                text: "Refresh";
                                icon: @image-url("../../assets/icons/refresh.svg");
                                has-icon: true;
                                variant: "secondary";
                                clicked => { root.refresh-themes-clicked(); }
                            }
                            CrabButton {
                                text: "Reset to Default";
                                icon: @image-url("../../assets/icons/refresh.svg");
                                has-icon: true;
                                variant: "secondary";
                                clicked => {
                                    root.selected-theme-id = "crab-dark";
                                    root.apply-theme-clicked("crab-dark");
                                }
                            }
                        }

                        Rectangle {
                            vertical-stretch: 1;
                            horizontal-stretch: 1;
                            border-radius: Theme.radius-sm;
                            background: Theme.bg-secondary;
                            border-width: 1px;
                            border-color: Theme.border;
                            clip: true;

                            ListView {
                                width: parent.width;
                                height: parent.height;

                                for th in root.themes: Rectangle {
                                    height: 54px;
                                    background: th.is-active
                                        ? Theme.accent-muted
                                        : th-touch.has-hover ? Theme.bg-interactive : transparent;

                                    th-touch := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => {
                                            root.selected-theme-id = th.id;
                                            root.apply-theme-clicked(th.id);
                                        }
                                    }

                                    HorizontalLayout {
                                        padding-left: Theme.space-md;
                                        padding-right: Theme.space-md;
                                        spacing: Theme.space-sm;

                                        VerticalLayout {
                                            horizontal-stretch: 1;
                                            alignment: center;
                                            spacing: 2px;

                                            HorizontalLayout {
                                                spacing: 6px;
                                                alignment: start;

                                                Text {
                                                    text: th.name;
                                                    font-size: Theme.font-md;
                                                    font-weight: th.is-active ? 600 : 500;
                                                    color: th.is-active ? Theme.accent : Theme.text-primary;
                                                    vertical-alignment: center;
                                                }
                                                if th.is-active: VerticalLayout {
                                                    alignment: center;
                                                    Image {
                                                        source: @image-url("../../assets/icons/check.svg");
                                                        width: 14px;
                                                        height: 14px;
                                                        colorize: Theme.accent;
                                                    }
                                                }
                                            }
                                            Text {
                                                text: th.description + " — " + th.author + " v" + th.version;
                                                font-size: Theme.font-xs;
                                                color: Theme.text-secondary;
                                                overflow: elide;
                                            }
                                        }

                                        // Paleta visual de 6 amostras obtidas dos tokens resolvidos do tema
                                        HorizontalLayout {
                                            spacing: 4px;
                                            alignment: center;

                                            for swatch in [
                                                th.swatch-bg,
                                                th.swatch-surface,
                                                th.swatch-border,
                                                th.swatch-accent,
                                                th.swatch-text,
                                                th.swatch-text-sec,
                                            ]: VerticalLayout {
                                                alignment: center;
                                                Rectangle {
                                                    width: 16px;
                                                    height: 16px;
                                                    border-radius: 3px;
                                                    background: swatch;
                                                    border-width: 1px;
                                                    border-color: Theme.border;
                                                }
                                            }
                                        }

                                        Text {
                                            text: th.is-builtin ? "Official" : "Custom";
                                            font-size: Theme.font-xs;
                                            color: Theme.text-secondary;
                                            width: 56px;
                                            horizontal-alignment: right;
                                            vertical-alignment: center;
                                        }
                                    }

                                    Rectangle {
                                        y: parent.height - 1px;
                                        height: 1px;
                                        width: parent.width;
                                        background: Theme.border-subtle;
                                    }
                                }
                            }
                        }
                    }

                    // Sub-aba 1: Instance Grid (rolável e ocupando 100% da largura)
                    // Sub-aba 1: Icons (pacotes oficiais Lucide / Lucide Dark + importação + Preview no hover)
                    if root.appearance-subtab == 1: VerticalLayout {
                        vertical-stretch: 1;
                        horizontal-stretch: 1;
                        spacing: Theme.space-sm;

                        HorizontalLayout {
                            spacing: Theme.space-xs;
                            alignment: start;

                            CrabButton {
                                text: "Import Pack";
                                icon: @image-url("../../assets/icons/plus.svg");
                                has-icon: true;
                                variant: "secondary";
                                clicked => { root.import-icon-pack-clicked(); }
                            }
                            CrabButton {
                                text: "Refresh";
                                icon: @image-url("../../assets/icons/refresh.svg");
                                has-icon: true;
                                variant: "secondary";
                                clicked => { root.refresh-icon-packs-clicked(); }
                            }
                            CrabButton {
                                text: "Reset to Default";
                                icon: @image-url("../../assets/icons/refresh.svg");
                                has-icon: true;
                                variant: "secondary";
                                clicked => { root.reset-icon-pack-clicked(); }
                            }
                        }

                        // Lista de pacotes de ícones (clique aplica imediatamente; hover apenas atualiza o preview)
                        Rectangle {
                            vertical-stretch: 1;
                            border-radius: Theme.radius-sm;
                            background: Theme.bg-secondary;
                            border-width: 1px;
                            border-color: Theme.border;
                            clip: true;

                            ListView {
                                for pk in root.icon-packs: Rectangle {
                                    height: 52px;
                                    background: pk.is-active
                                        ? Theme.accent-muted
                                        : pk-touch.has-hover ? Theme.bg-interactive : transparent;

                                    pk-touch := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => {
                                            root.active-icon-pack-id = pk.id;
                                            root.icon-pack-selected(pk.id);
                                        }
                                        changed has-hover => {
                                            if (self.has-hover) {
                                                root.hovered-icon-pack-id = pk.id;
                                            } else if (root.hovered-icon-pack-id == pk.id) {
                                                root.hovered-icon-pack-id = "";
                                            }
                                        }
                                    }

                                    HorizontalLayout {
                                        padding-left: Theme.space-md;
                                        padding-right: Theme.space-md;
                                        spacing: Theme.space-sm;

                                        VerticalLayout {
                                            horizontal-stretch: 1;
                                            alignment: center;
                                            HorizontalLayout {
                                                spacing: 6px;
                                                alignment: start;

                                                Text {
                                                    text: pk.name;
                                                    font-size: Theme.font-md;
                                                    font-weight: 600;
                                                    color: pk.is-active ? Theme.accent : Theme.text-primary;
                                                    vertical-alignment: center;
                                                }
                                                if pk.is-active: VerticalLayout {
                                                    alignment: center;
                                                    Image {
                                                        source: @image-url("../../assets/icons/check.svg");
                                                        width: 14px;
                                                        height: 14px;
                                                        colorize: Theme.accent;
                                                    }
                                                }
                                            }
                                            Text {
                                                text: pk.description + (pk.author != "" ? " — " + pk.author : "");
                                                font-size: Theme.font-xs;
                                                color: Theme.text-secondary;
                                                overflow: elide;
                                            }
                                        }

                                        Text {
                                            text: pk.is-builtin ? "Official" : "Custom";
                                            font-size: Theme.font-xs;
                                            color: Theme.text-secondary;
                                            vertical-alignment: center;
                                        }
                                    }

                                    Rectangle {
                                        y: parent.height - 1px;
                                        height: 1px;
                                        width: parent.width;
                                        background: Theme.border-subtle;
                                    }
                                }
                            }
                        }

                        // Painel de Preview abaixo da lista (exibe amostra do pacote sob o mouse ou do ativo)
                        Rectangle {
                            height: 92px;
                            border-radius: Theme.radius-sm;
                            background: Theme.bg-secondary;
                            border-width: 1px;
                            border-color: Theme.border;

                            VerticalLayout {
                                padding: Theme.space-md;
                                spacing: Theme.space-sm;

                                HorizontalLayout {
                                    alignment: space-between;
                                    Text {
                                        text: "Icon Preview — " + (root.preview-pack-id == "lucide-dark" ? "Lucide Dark" : root.preview-pack-id == "lucide" ? "Lucide" : root.preview-pack-id);
                                        font-size: Theme.font-xs;
                                        font-weight: 600;
                                        color: Theme.text-secondary;
                                    }
                                    if root.hovered-icon-pack-id != "" && root.hovered-icon-pack-id != root.active-icon-pack-id: Text {
                                        text: "Hover preview (click to apply)";
                                        font-size: Theme.font-xs;
                                        color: Theme.accent;
                                    }
                                }

                                HorizontalLayout {
                                    spacing: Theme.space-md;
                                    alignment: start;

                                    for sample in [
                                        @image-url("../../assets/icons/plus.svg"),
                                        @image-url("../../assets/icons/folder.svg"),
                                        @image-url("../../assets/icons/settings.svg"),
                                        @image-url("../../assets/icons/play.svg"),
                                        @image-url("../../assets/icons/edit.svg"),
                                        @image-url("../../assets/icons/puzzle.svg"),
                                        @image-url("../../assets/icons/file-text.svg"),
                                        @image-url("../../assets/icons/search.svg"),
                                        @image-url("../../assets/icons/refresh.svg"),
                                        @image-url("../../assets/icons/trash.svg"),
                                    ]: Rectangle {
                                        width: 34px;
                                        height: 34px;
                                        border-radius: Theme.radius-sm;
                                        background: Theme.bg-primary;
                                        border-width: 1px;
                                        border-color: Theme.border-subtle;

                                        Image {
                                            x: 8px;
                                            y: 8px;
                                            width: 18px;
                                            height: 18px;
                                            source: sample;
                                            colorize: root.preview-pack-id == "lucide-dark"
                                                ? Theme.text-secondary
                                                : Theme.text-primary;
                                        }
                                    }
                                }
                            }
                        }
                    }

                    // Sub-aba 2: Instance Grid
                    if root.appearance-subtab == 2: Flickable {
                        vertical-stretch: 1;
                        horizontal-stretch: 1;
                        content-width: self.width;
                        content-height: grid-app-inner.preferred-height + 16px;

                        grid-app-inner := VerticalLayout {
                            width: parent.width;
                            spacing: 12px;
                            alignment: start;

                            SettingsSection {
                                title: "Instance Grid";

                                VerticalLayout {
                                    spacing: 6px;
                                    Text {
                                        text: "Icon Size";
                                        font-size: Theme.font-xs;
                                        font-weight: 600;
                                        color: Theme.text-secondary;
                                    }
                                    HorizontalLayout {
                                        spacing: Theme.space-xs;
                                        alignment: start;
                                        CrabButton {
                                            text: "Small";
                                            variant: root.grid-icon-size == 0 ? "primary" : "secondary";
                                            clicked => { root.grid-icon-size = 0; root.save-clicked(); }
                                        }
                                        CrabButton {
                                            text: "Medium";
                                            variant: root.grid-icon-size == 1 ? "primary" : "secondary";
                                            clicked => { root.grid-icon-size = 1; root.save-clicked(); }
                                        }
                                        CrabButton {
                                            text: "Large";
                                            variant: root.grid-icon-size == 2 ? "primary" : "secondary";
                                            clicked => { root.grid-icon-size = 2; root.save-clicked(); }
                                        }
                                    }
                                }

                                VerticalLayout {
                                    spacing: 6px;
                                    Text {
                                        text: "Grid Spacing";
                                        font-size: Theme.font-xs;
                                        font-weight: 600;
                                        color: Theme.text-secondary;
                                    }
                                    HorizontalLayout {
                                        spacing: Theme.space-xs;
                                        alignment: start;
                                        CrabButton {
                                            text: "Compact";
                                            variant: root.grid-spacing == 0 ? "primary" : "secondary";
                                            clicked => { root.grid-spacing = 0; root.save-clicked(); }
                                        }
                                        CrabButton {
                                            text: "Normal";
                                            variant: root.grid-spacing == 1 ? "primary" : "secondary";
                                            clicked => { root.grid-spacing = 1; root.save-clicked(); }
                                        }
                                        CrabButton {
                                            text: "Spacious";
                                            variant: root.grid-spacing == 2 ? "primary" : "secondary";
                                            clicked => { root.grid-spacing = 2; root.save-clicked(); }
                                        }
                                    }
                                }

                                VerticalLayout {
                                    spacing: 6px;
                                    Text {
                                        text: "Sort By";
                                        font-size: Theme.font-xs;
                                        font-weight: 600;
                                        color: Theme.text-secondary;
                                    }
                                    HorizontalLayout {
                                        spacing: Theme.space-xs;
                                        alignment: start;
                                        CrabButton {
                                            text: "Name";
                                            variant: root.grid-sort-by == 0 ? "primary" : "secondary";
                                            clicked => { root.grid-sort-by = 0; root.save-clicked(); }
                                        }
                                        CrabButton {
                                            text: "Creation Date";
                                            variant: root.grid-sort-by == 1 ? "primary" : "secondary";
                                            clicked => { root.grid-sort-by = 1; root.save-clicked(); }
                                        }
                                        CrabButton {
                                            text: "Last Played";
                                            variant: root.grid-sort-by == 2 ? "primary" : "secondary";
                                            clicked => { root.grid-sort-by = 2; root.save-clicked(); }
                                        }
                                        CrabButton {
                                            text: "Manual Order";
                                            variant: root.grid-sort-by == 3 ? "primary" : "secondary";
                                            clicked => { root.grid-sort-by = 3; root.save-clicked(); }
                                        }
                                    }
                                }

                                VerticalLayout {
                                    spacing: 4px;
                                    Text {
                                        text: "Display Options";
                                        font-size: Theme.font-xs;
                                        font-weight: 600;
                                        color: Theme.text-secondary;
                                    }
                                    CrabCheckbox { label: "Show Instance Name"; checked <=> root.grid-show-name; toggled => { root.save-clicked(); } }
                                    CrabCheckbox { label: "Show Minecraft Version"; checked <=> root.grid-show-version; toggled => { root.save-clicked(); } }
                                    CrabCheckbox { label: "Show Modloader Badge"; checked <=> root.grid-show-modloader; toggled => { root.save-clicked(); } }
                                }

                                HorizontalLayout {
                                    alignment: start;
                                    CrabButton {
                                        text: "Reset Grid Appearance";
                                        icon: @image-url("../../assets/icons/refresh.svg");
                                        has-icon: true;
                                        variant: "secondary";
                                        clicked => {
                                            root.grid-icon-size = 1;
                                            root.grid-spacing = 1;
                                            root.grid-show-name = true;
                                            root.grid-show-version = false;
                                            root.grid-show-modloader = false;
                                            root.grid-sort-by = 1;
                                            root.save-clicked();
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                // 6: Accounts (referência: Prism Launcher)
                if root.active-tab == 6: VerticalLayout {
                    padding: Theme.space-lg;
                    spacing: Theme.space-md;

                    Text {
                        text: "Accounts";
                        font-size: Theme.font-xl;
                        font-weight: 700;
                        color: Theme.text-primary;
                    }

                    if root.accounts-error-message != "": Rectangle {
                        height: 30px;
                        border-radius: Theme.radius-sm;
                        background: Theme.error-bg;
                        border-width: 1px;
                        border-color: Theme.error-border;
                        HorizontalLayout {
                            padding-left: Theme.space-sm;
                            padding-right: Theme.space-sm;
                            Text {
                                text: root.accounts-error-message;
                                font-size: Theme.font-xs;
                                color: Theme.error-text;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                        }
                    }

                    HorizontalLayout {
                        vertical-stretch: 1;
                        spacing: Theme.space-md;

                        // Tabela de contas: Avatar, Username, Type, Status
                        Rectangle {
                            horizontal-stretch: 1;
                            border-radius: Theme.radius-sm;
                            background: Theme.bg-secondary;
                            border-width: 1px;
                            border-color: Theme.border;
                            clip: true;

                            VerticalLayout {
                                Rectangle {
                                    height: 28px;
                                    background: Theme.bg-interactive;
                                    HorizontalLayout {
                                        padding-left: Theme.space-md;
                                        padding-right: Theme.space-md;
                                        spacing: Theme.space-sm;
                                        Text { text: "Username"; font-size: Theme.font-xs; font-weight: 600; color: Theme.text-secondary; horizontal-stretch: 1; vertical-alignment: center; }
                                        Text { text: "Type"; font-size: Theme.font-xs; font-weight: 600; color: Theme.text-secondary; width: 72px; vertical-alignment: center; }
                                        Text { text: "Status"; font-size: Theme.font-xs; font-weight: 600; color: Theme.text-secondary; width: 76px; horizontal-alignment: right; vertical-alignment: center; }
                                    }
                                }

                                if root.accounts.length == 0: Rectangle {
                                    vertical-stretch: 1;
                                    Text {
                                        text: "No accounts configured. Add a Microsoft or Offline account.";
                                        font-size: Theme.font-sm;
                                        color: Theme.text-secondary;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }

                                if root.accounts.length > 0: ListView {
                                    vertical-stretch: 1;
                                    for acc in root.accounts: Rectangle {
                                        height: 36px;
                                        background: acc.id == root.selected-account-id
                                            ? Theme.accent-muted
                                            : acc-touch.has-hover ? Theme.bg-interactive : transparent;

                                        acc-touch := TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => { root.selected-account-id = acc.id; }
                                        }

                                        HorizontalLayout {
                                            padding-left: Theme.space-md;
                                            padding-right: Theme.space-md;
                                            spacing: Theme.space-sm;

                                            VerticalLayout {
                                                alignment: center;
                                                Image {
                                                    source: @image-url("../../assets/icons/steve-head.svg");
                                                    width: 20px;
                                                    height: 20px;
                                                    image-rendering: pixelated;
                                                }
                                            }

                                            Text {
                                                text: acc.username;
                                                font-size: Theme.font-sm;
                                                font-weight: acc.is-default ? 600 : 400;
                                                color: acc.is-default ? Theme.accent : Theme.text-primary;
                                                horizontal-stretch: 1;
                                                vertical-alignment: center;
                                                overflow: elide;
                                            }

                                            Text {
                                                text: acc.kind == "Microsoft" ? "MSA" : acc.kind;
                                                font-size: Theme.font-xs;
                                                color: Theme.text-secondary;
                                                width: 72px;
                                                vertical-alignment: center;
                                            }

                                            Text {
                                                text: acc.is-default ? "Default" : "Ready";
                                                font-size: Theme.font-xs;
                                                font-weight: acc.is-default ? 600 : 400;
                                                color: acc.is-default ? Theme.accent : Theme.success;
                                                width: 76px;
                                                horizontal-alignment: right;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        // Painel lateral de ações de conta (Prism style)
                        VerticalLayout {
                            width: 164px;
                            spacing: 4px;
                            alignment: start;

                            CrabButton {
                                text: "Add Microsoft";
                                icon: @image-url("../../assets/icons/microsoft.svg");
                                has-icon: true;
                                variant: "ghost";
                                align-left: true;
                                clicked => { root.add-microsoft-account-clicked(); }
                            }

                            CrabButton {
                                text: "Add Offline";
                                icon: @image-url("../../assets/icons/user-plus.svg");
                                has-icon: true;
                                variant: "ghost";
                                align-left: true;
                                clicked => {
                                    root.request-add-offline-account-dialog();
                                }
                            }

                            Rectangle { height: 1px; background: Theme.border; }

                            CrabButton {
                                text: "Refresh";
                                icon: @image-url("../../assets/icons/refresh.svg");
                                has-icon: true;
                                variant: "ghost";
                                align-left: true;
                                clicked => { root.refresh-accounts-clicked(); }
                            }

                            CrabButton {
                                text: "Remove";
                                icon: @image-url("../../assets/icons/trash.svg");
                                has-icon: true;
                                variant: "flat-danger";
                                align-left: true;
                                enabled: root.selected-account-id != "";
                                clicked => { root.remove-account-clicked(root.selected-account-id); }
                            }

                            Rectangle { height: 1px; background: Theme.border; }

                            CrabButton {
                                text: "Set Default";
                                icon: @image-url("../../assets/icons/check.svg");
                                has-icon: true;
                                variant: "ghost";
                                align-left: true;
                                enabled: root.selected-account-id != "";
                                clicked => { root.set-default-account-clicked(root.selected-account-id); }
                            }

                            CrabButton {
                                text: "No Default";
                                icon: @image-url("../../assets/icons/x.svg");
                                has-icon: true;
                                variant: "ghost";
                                align-left: true;
                                clicked => { root.no-default-account-clicked(); }
                            }
                        }
                    }
                }

                // 4: About (logo completa oficial do Crab alinhada à esquerda + versão + informações do sistema)
                if root.active-tab == 4: VerticalLayout {
                    width: parent.width;
                    height: parent.height;
                    padding: Theme.space-lg;
                    spacing: Theme.space-md;
                    alignment: start;

                    Image {
                        source: @image-url("../../assets/app/logo-full.svg");
                        height: 56px;
                        horizontal-alignment: left;
                        image-fit: contain;
                    }

                    Text {
                        text: "Version " + root.app-version;
                        font-size: Theme.font-md;
                        font-weight: 600;
                        color: Theme.text-secondary;
                    }

                    Text {
                        text: "A fast, minimalist, native Minecraft launcher built from scratch in Rust and Slint.";
                        font-size: Theme.font-md;
                        color: Theme.text-primary;
                        wrap: word-wrap;
                    }

                    if root.system-info-text != "": SettingsSection {
                        title: "System Information";
                        Text {
                            text: root.system-info-text;
                            font-family: Theme.console-font-family;
                            font-size: Theme.font-xs;
                            color: Theme.text-secondary;
                            wrap: word-wrap;
                        }
                    }

                    HorizontalLayout {
                        alignment: start;
                        CrabButton {
                            text: "Copy System Information";
                            icon: @image-url("../../assets/icons/copy.svg");
                            has-icon: true;
                            variant: "secondary";
                            clicked => {
                                root.copy-system-info-clicked();
                            }
                        }
                    }
                }
            }
        }

        // Rodapé
        Rectangle {
            height: 48px;
            background: Theme.bg-secondary;

            Rectangle {
                y: 0px;
                height: 1px;
                width: parent.width;
                background: Theme.border;
            }

            HorizontalLayout {
                padding-left: Theme.space-lg;
                padding-right: Theme.space-lg;
                spacing: Theme.space-sm;

                Text {
                    text: root.error-message;
                    font-size: Theme.font-xs;
                    color: Theme.error-text;
                    horizontal-stretch: 1;
                    vertical-alignment: center;
                    overflow: elide;
                }

                CrabButton {
                    text: "OK";
                    icon: @image-url("../../assets/icons/check.svg");
                    has-icon: true;
                    variant: "primary";
                    y: (parent.height - self.height) / 2;
                    clicked => {
                        root.close-clicked();
                    }
                }
            }
        }
    }
}
