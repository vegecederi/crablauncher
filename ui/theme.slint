// Sistema de design dinâmico do Crab Launcher (controlado pelo Theme Engine em Rust).
import "../assets/fonts/inter/Inter.ttf";
import "../assets/fonts/jetbrains-mono/JetBrainsMono-Regular.ttf";
import "../assets/fonts/fira-code/FiraCode-Regular.ttf";
import "../assets/fonts/ibm-plex-mono/IBMPlexMono-Regular.ttf";
import "../assets/fonts/source-code-pro/SourceCodePro-Regular.ttf";
import "../assets/themes/vice/fonts/pricedown.otf";

export global Theme {
    // Tema especial Vice + efeitos visuais + Icon Pack ativo
    in-out property <bool> is-vice-theme: false;
    in-out property <bool> disable-special-effects: false;
    in-out property <float> wallpaper-opacity: 1.0;
    in-out property <string> display-font-family: "Inter";
    in-out property <color> chrome-bg: #222222;
    in-out property <string> icon-pack-id: "lucide";
    in-out property <bool> icon-pack-dark: false;
    out property <color> icon-primary: root.icon-pack-dark ? root.text-secondary : root.text-primary;
    out property <color> icon-secondary: root.icon-pack-dark ? root.text-disabled : root.text-secondary;

    // Paleta principal (dinâmica via Theme Engine)
    in-out property <color> bg-primary: #1a1a1a;
    in-out property <color> bg-secondary: #222222;
    in-out property <color> bg-interactive: #2b2b2b;
    in-out property <color> bg-interactive-hover: #343434;
    in-out property <color> bg-interactive-pressed: #242424;

    // Cor de destaque
    in-out property <color> accent: #ff751f;
    in-out property <color> accent-hover: #ff863b;
    in-out property <color> accent-pressed: #e06114;
    in-out property <color> accent-muted: #ff751f24;

    // Bordas e divisores
    in-out property <color> border: #333333;
    in-out property <color> border-subtle: #292929;

    // Texto
    in-out property <color> text-primary: #f2f2f2;
    in-out property <color> text-secondary: #a0a0a0;
    in-out property <color> text-disabled: #666666;
    in-out property <color> text-on-accent: #141414;

    // Estados semânticos
    in-out property <color> success: #4caf50;
    in-out property <color> danger: #d14343;
    in-out property <color> danger-hover: #e05252;
    in-out property <color> danger-pressed: #b83434;
    in-out property <color> danger-muted: #d1434322;
    in-out property <color> warning-bg: #332718;
    in-out property <color> warning-border: #664822;
    in-out property <color> warning-text: #f0b35a;
    in-out property <color> error-bg: #331c1c;
    in-out property <color> error-border: #662e2e;
    in-out property <color> error-text: #f27474;

    // Console
    in-out property <color> console-bg: #141414;
    in-out property <string> console-font-family: "JetBrains Mono";
    in-out property <length> console-font-size: 12px;

    // Raios de borda
    in-out property <length> radius-sm: 4px;
    in-out property <length> radius-md: 5px;

    // Espaçamentos compactos
    out property <length> space-xs: 4px;
    out property <length> space-sm: 6px;
    out property <length> space-md: 10px;
    out property <length> space-lg: 14px;
    out property <length> space-xl: 20px;

    // Dimensões padrão de layout
    out property <length> toolbar-height: 44px;
    out property <length> toolbar-button-height: 32px;
    out property <length> statusbar-height: 28px;
    out property <length> sidebar-width: 184px;
    out property <length> button-height: 30px;

    // Tipografia Inter (tamanhos refinados +1px para melhor legibilidade mantendo densidade compacta)
    in-out property <string> font-family: "Inter";
    out property <length> font-xs: 12px;
    out property <length> font-sm: 13px;
    out property <length> font-md: 14px;
    out property <length> font-lg: 16px;
    out property <length> font-xl: 18px;

    // Ícones dinâmicos controlados pelo Icon Pack ativo (atualizados em tempo real via ThemeBroadcaster)
    in-out property <image> icon-arrow-down: @image-url("../assets/icons/arrow-down.svg");
    in-out property <image> icon-arrow-up: @image-url("../assets/icons/arrow-up.svg");
    in-out property <image> icon-calendar: @image-url("../assets/icons/calendar.svg");
    in-out property <image> icon-check: @image-url("../assets/icons/check.svg");
    in-out property <image> icon-chevron-down: @image-url("../assets/icons/chevron-down.svg");
    in-out property <image> icon-chevron-left: @image-url("../assets/icons/chevron-left.svg");
    in-out property <image> icon-chevron-right: @image-url("../assets/icons/chevron-right.svg");
    in-out property <image> icon-chevron-up: @image-url("../assets/icons/chevron-up.svg");
    in-out property <image> icon-clock: @image-url("../assets/icons/clock.svg");
    in-out property <image> icon-coffee: @image-url("../assets/icons/coffee.svg");
    in-out property <image> icon-copy: @image-url("../assets/icons/copy.svg");
    in-out property <image> icon-cube: @image-url("../assets/icons/cube.svg");
    in-out property <image> icon-download: @image-url("../assets/icons/download.svg");
    in-out property <image> icon-edit: @image-url("../assets/icons/edit.svg");
    in-out property <image> icon-external-link: @image-url("../assets/icons/external-link.svg");
    in-out property <image> icon-file-text: @image-url("../assets/icons/file-text.svg");
    in-out property <image> icon-flask-conical: @image-url("../assets/icons/flask-conical.svg");
    in-out property <image> icon-folder-plus: @image-url("../assets/icons/folder-plus.svg");
    in-out property <image> icon-folder: @image-url("../assets/icons/folder.svg");
    in-out property <image> icon-info: @image-url("../assets/icons/info.svg");
    in-out property <image> icon-layers: @image-url("../assets/icons/layers.svg");
    in-out property <image> icon-layout-grid: @image-url("../assets/icons/layout-grid.svg");
    in-out property <image> icon-palette: @image-url("../assets/icons/palette.svg");
    in-out property <image> icon-play: @image-url("../assets/icons/play.svg");
    in-out property <image> icon-plus: @image-url("../assets/icons/plus.svg");
    in-out property <image> icon-puzzle: @image-url("../assets/icons/puzzle.svg");
    in-out property <image> icon-refresh: @image-url("../assets/icons/refresh.svg");
    in-out property <image> icon-save: @image-url("../assets/icons/save.svg");
    in-out property <image> icon-scan-search: @image-url("../assets/icons/scan-search.svg");
    in-out property <image> icon-search: @image-url("../assets/icons/search.svg");
    in-out property <image> icon-settings: @image-url("../assets/icons/settings.svg");
    in-out property <image> icon-sliders-horizontal: @image-url("../assets/icons/sliders-horizontal.svg");
    in-out property <image> icon-square: @image-url("../assets/icons/square.svg");
    in-out property <image> icon-star: @image-url("../assets/icons/star.svg");
    in-out property <image> icon-terminal: @image-url("../assets/icons/terminal.svg");
    in-out property <image> icon-trash: @image-url("../assets/icons/trash.svg");
    in-out property <image> icon-user-plus: @image-url("../assets/icons/user-plus.svg");
    in-out property <image> icon-user: @image-url("../assets/icons/user.svg");
    in-out property <image> icon-wrench: @image-url("../assets/icons/wrench.svg");
    in-out property <image> icon-x: @image-url("../assets/icons/x.svg");
}
