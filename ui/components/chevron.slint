import { Theme } from "../theme.slint";

/// Indicador chevron reutilizável baseado em Lucide SVG (12–14px).
export component ChevronIcon inherits VerticalLayout {
    in property <string> direction: "down"; // "down" | "right" | "up" | "left"
    in property <length> icon-size: 13px;
    in property <color> icon-color: Theme.icon-secondary;

    alignment: center;

    Image {
        source: root.direction == "right"
            ? Theme.icon-chevron-right
            : root.direction == "up"
                ? Theme.icon-chevron-up
                : root.direction == "left"
                    ? Theme.icon-chevron-left
                    : Theme.icon-chevron-down;
        width: root.icon-size;
        height: root.icon-size;
        colorize: root.icon-color;
    }
}
