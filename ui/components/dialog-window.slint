import { Theme } from "../theme.slint";

/// Estrutura base reutilizável para janelas de diálogo nativas do Crab.
/// Garante margens, cabeçalho, espaçamento, divisor e suporte a Esc consistentes em todos os diálogos.
export component CrabDialogFrame inherits Rectangle {
    in property <string> heading;
    in property <string> subtitle: "";
    in property <bool> show-divider: true;

    callback escape-pressed();

    background: Theme.bg-secondary;

    FocusScope {
        key-pressed(ev) => {
            if (ev.text == Key.Escape) {
                root.escape-pressed();
                return accept;
            }
            reject
        }

        VerticalLayout {
            padding: Theme.space-lg;
            spacing: Theme.space-md;

            VerticalLayout {
                spacing: 2px;
                Text {
                    text: root.heading;
                    font-size: Theme.font-md;
                    font-weight: 600;
                    color: Theme.text-primary;
                    overflow: elide;
                }
                if root.subtitle != "": Text {
                    text: root.subtitle;
                    font-size: Theme.font-xs;
                    color: Theme.text-secondary;
                    wrap: word-wrap;
                }
            }

            @children
        }
    }
}
