import { Theme } from "../theme.slint";
import { Strings } from "../strings.slint";
import { CrabButton } from "button.slint";
import { CrabTextInput } from "input.slint";
import { ChevronIcon } from "chevron.slint";

/// Toolbar unificada do Crab Launcher (utilizada identicamente na posição superior e inferior).
export component CrabToolbar inherits Rectangle {
    in property <string> toolbar-position: "top"; // "top" | "bottom"
    in property <bool> show-toolbar-labels: true;
    in property <bool> compact-toolbar: false;
    in property <bool> search-visible: true;
    in-out property <string> instance-search-query: "";
    in property <bool> has-active-account: false;
    in property <string> active-account-name: "";
    in property <bool> customize-layout-mode: false;
    in property <bool> temp-reveal-search: false;
    in property <length> blur-offset-y: 0px;
    in property <length> window-width: 1000px;
    in property <length> window-height: 660px;

    callback add-instance-clicked();
    callback folders-toggled(length, length, length, length);   // btn_x, bar_y, btn_w, bar_h
    callback groups-toggled(length, length, length, length);    // btn_x, bar_y, btn_w, bar_h
    callback settings-clicked();
    callback accounts-toggled(length, length, length, length);  // btn_x, bar_y, btn_w, bar_h
    callback search-changed(string);
    callback clear-search-clicked();
    callback toolbar-right-clicked(length, length);
    callback drag-started();
    callback drag-moved(length);
    callback drag-ended();

    private property <length> btn-height: root.compact-toolbar ? 24px : Theme.toolbar-button-height;

    height: root.compact-toolbar ? 34px : Theme.toolbar-height;
    background: Theme.bg-secondary;
    clip: true;

    // Real Gaussian backdrop blur para o tema especial Vice (respeita Disable Special Effects e Wallpaper Opacity)
    if Theme.is-vice-theme && !Theme.disable-special-effects && Theme.wallpaper-opacity > 0.0: Image {
        x: 0px;
        y: -root.blur-offset-y;
        width: root.window-width;
        height: root.window-height;
        source: @image-url("../../assets/themes/vice/wallpaper-blurred.png");
        image-fit: cover;
        opacity: Theme.wallpaper-opacity;
    }
    if Theme.is-vice-theme && !Theme.disable-special-effects && Theme.wallpaper-opacity > 0.0: Rectangle {
        width: parent.width;
        height: parent.height;
        background: #30253894;
        opacity: Theme.wallpaper-opacity;
    }

    // Divisor sutil na borda voltada para o conteúdo
    Rectangle {
        y: root.toolbar-position == "bottom" ? 0px : parent.height - 1px;
        height: 1px;
        width: parent.width;
        background: Theme.border;
    }

    // Área de clique direito no fundo da toolbar
    TouchArea {
        pointer-event(ev) => {
            if (ev.kind == PointerEventKind.down && ev.button == PointerEventButton.right) {
                root.toolbar-right-clicked(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
            }
        }
    }

    HorizontalLayout {
        padding-left: Theme.space-md;
        padding-right: Theme.space-md;
        spacing: root.compact-toolbar ? 4px : Theme.space-xs;

        // Handle de arraste no modo Customize Layout
        if root.customize-layout-mode: Rectangle {
            width: 24px;
            height: root.btn-height;
            y: (parent.height - self.height) / 2;
            border-radius: Theme.radius-sm;
            background: Theme.accent;

            TouchArea {
                mouse-cursor: grab;
                pointer-event(ev) => {
                    if (ev.kind == PointerEventKind.down && ev.button == PointerEventButton.left) {
                        root.drag-started();
                    } else if (ev.kind == PointerEventKind.up && ev.button == PointerEventButton.left) {
                        root.drag-ended();
                    }
                }
                moved => {
                    root.drag-moved(self.absolute-position.y + self.mouse-y);
                }
            }

            Text {
                text: "⋮⋮";
                font-size: 11px;
                font-weight: 600;
                color: Theme.text-on-accent;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        CrabButton {
            text: root.show-toolbar-labels ? Strings.add-instance : "";
            icon: Theme.icon-plus;
            has-icon: true;
            variant: "ghost";
            height: root.btn-height;
            y: (parent.height - self.height) / 2;
            tooltip: "Create a new Minecraft instance";
            tooltip-align: "start";
            tooltip-above: root.toolbar-position == "bottom";
            clicked => {
                if (!root.customize-layout-mode) {
                    root.add-instance-clicked();
                }
            }
            right-clicked(mx, my) => { root.toolbar-right-clicked(mx, my); }
        }

        folders-btn := CrabButton {
            text: root.show-toolbar-labels ? "Folders" : "";
            icon: Theme.icon-folder;
            has-icon: true;
            show-chevron: root.show-toolbar-labels;
            variant: "ghost";
            height: root.btn-height;
            y: (parent.height - self.height) / 2;
            tooltip: "Open launcher directories";
            tooltip-above: root.toolbar-position == "bottom";
            clicked => {
                if (!root.customize-layout-mode) {
                    root.folders-toggled(
                        self.absolute-position.x,
                        root.absolute-position.y,
                        self.width,
                        root.height
                    );
                }
            }
            right-clicked(mx, my) => { root.toolbar-right-clicked(mx, my); }
        }

        groups-button := CrabButton {
            text: root.show-toolbar-labels ? "Groups" : "";
            icon: Theme.icon-folder-plus;
            has-icon: true;
            show-chevron: root.show-toolbar-labels;
            variant: "ghost";
            height: root.btn-height;
            y: (parent.height - self.height) / 2;
            tooltip: "Create or manage instance groups";
            tooltip-above: root.toolbar-position == "bottom";
            clicked => {
                if (!root.customize-layout-mode) {
                    root.groups-toggled(
                        self.absolute-position.x,
                        root.absolute-position.y,
                        self.width,
                        root.height
                    );
                }
            }
            right-clicked(mx, my) => { root.toolbar-right-clicked(mx, my); }
        }

        CrabButton {
            text: root.show-toolbar-labels ? Strings.settings : "";
            icon: Theme.icon-settings;
            has-icon: true;
            variant: "ghost";
            height: root.btn-height;
            y: (parent.height - self.height) / 2;
            tooltip: "Open launcher settings";
            tooltip-above: root.toolbar-position == "bottom";
            clicked => {
                if (!root.customize-layout-mode) {
                    root.settings-clicked();
                }
            }
            right-clicked(mx, my) => { root.toolbar-right-clicked(mx, my); }
        }

        Rectangle {
            horizontal-stretch: 1;
        }

        // Pesquisa compacta de instâncias
        CrabTextInput {
            visible: root.search-visible;
            width: root.search-visible ? 210px : 0px;
            height: root.compact-toolbar ? 24px : 28px;
            y: (parent.height - self.height) / 2;
            text <=> root.instance-search-query;
            placeholder: "Search instances...";
            leading-icon: Theme.icon-search;
            has-leading-icon: true;
            edited(q) => { root.search-changed(q); }
        }

        if root.search-visible && root.instance-search-query != "": CrabButton {
            text: "";
            icon: Theme.icon-x;
            has-icon: true;
            variant: "ghost";
            height: root.btn-height;
            y: (parent.height - self.height) / 2;
            tooltip: "Clear search";
            tooltip-above: root.toolbar-position == "bottom";
            clicked => { root.clear-search-clicked(); }
        }

        // Seletor de contas (sem conta ativa)
        if !root.has-active-account: CrabButton {
            text: root.show-toolbar-labels ? Strings.accounts : "";
            icon: Theme.icon-user;
            has-icon: true;
            show-chevron: root.show-toolbar-labels;
            variant: "ghost";
            height: root.btn-height;
            y: (parent.height - self.height) / 2;
            tooltip: "Switch or manage Minecraft accounts";
            tooltip-align: "end";
            tooltip-above: root.toolbar-position == "bottom";
            clicked => {
                if (!root.customize-layout-mode) {
                    root.accounts-toggled(
                        self.absolute-position.x,
                        root.absolute-position.y,
                        self.width,
                        root.height
                    );
                }
            }
            right-clicked(mx, my) => { root.toolbar-right-clicked(mx, my); }
        }

        // Seletor de contas (com conta ativa — avatar + username + chevron)
        if root.has-active-account: acc-btn := Rectangle {
            height: root.btn-height;
            y: (parent.height - self.height) / 2;
            border-radius: Theme.radius-sm;
            background: acc-touch.pressed
                ? Theme.bg-interactive-pressed
                : acc-touch.has-hover
                    ? Theme.bg-interactive-hover
                    : transparent;

            acc-touch := TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    if (!root.customize-layout-mode) {
                        root.accounts-toggled(
                            acc-btn.absolute-position.x,
                            root.absolute-position.y,
                            acc-btn.width,
                            root.height
                        );
                    }
                }
                pointer-event(ev) => {
                    if (ev.kind == PointerEventKind.down && ev.button == PointerEventButton.right) {
                        root.toolbar-right-clicked(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                    }
                }
            }

            HorizontalLayout {
                padding-left: Theme.space-sm;
                padding-right: Theme.space-sm;
                spacing: 8px;

                VerticalLayout {
                    alignment: center;
                    Image {
                        source: @image-url("../../assets/icons/steve-head.svg");
                        width: root.compact-toolbar ? 18px : 22px;
                        height: root.compact-toolbar ? 18px : 22px;
                        image-rendering: pixelated;
                    }
                }

                if root.show-toolbar-labels: Text {
                    text: root.active-account-name;
                    font-size: Theme.font-md;
                    font-weight: 500;
                    color: Theme.text-primary;
                    vertical-alignment: center;
                }

                if root.show-toolbar-labels: ChevronIcon {
                    direction: "down";
                    icon-size: 13px;
                }
            }
        }
    }
}
