import { Theme } from "theme.slint";
import { UnsavedSettingsWindow } from "views/unsaved-settings-window.slint";
import { ContextMenuWindow, FloatingMenuEntry } from "views/context-menu-window.slint";
import { Strings } from "strings.slint";
import { CrabButton } from "components/button.slint";
import { CrabToolbar } from "components/toolbar.slint";
import { CrabStatusBar } from "components/status-bar.slint";
import { CrabTextInput } from "components/input.slint";
import { ChevronIcon } from "components/chevron.slint";
import { CrabContextMenu, ContextMenuHeader, ContextMenuDivider, ContextMenuItem, ContextMenuCheckItem } from "components/context-menu.slint";
import { InstanceCard } from "components/instance-card.slint";
import { InstanceSidebar } from "views/sidebar.slint";
import { LaunchOfflineWindow, OfflineAccountEntry } from "views/launch-offline-window.slint";
import { CopyInstanceWindow } from "views/copy-instance-dialog.slint";
import { AddOfflineAccountWindow } from "views/add-offline-account-dialog.slint";
import { ConfirmDialogWindow } from "views/confirm-dialog-window.slint";
import { TextInputDialogWindow } from "views/text-input-dialog-window.slint";
import { ServerDialogWindow } from "views/server-dialog-window.slint";
import { ReviewModsWindow, ReviewItemEntry } from "views/review-mods-window.slint";
import { CheckUpdatesWindow, UpdateCandidateItem } from "views/check-updates-window.slint";
import { VerifyDependenciesWindow, DependencyIssueItem } from "views/verify-dependencies-window.slint";
import { AddInstanceWindow, VersionItem, AddLoaderVersionItem, PackResultItem } from "views/add-instance-window.slint";
import { SettingsWindow, JavaRuntimeItem, ThemeItem, IconPackItem } from "views/settings-window.slint";
import { AccountItem } from "views/accounts-window.slint";
import { EditInstanceWindow, GroupOption, ComponentItem, LocalModItem, PackItem, WorldItem, ServerItem, ScreenshotItem, SessionLogItem, SessionLogLine } from "views/edit-instance-window.slint";
import { ConsoleWindow, ConsoleLogLine } from "views/console-window.slint";
import { MicrosoftAuthWindow } from "views/microsoft-auth-window.slint";
import { InstallJavaWindow, JavaBuildItem } from "views/install-java-window.slint";
import { InstallLoaderWindow, LoaderVersionItem } from "views/install-loader-window.slint";
import { ChangeGroupWindow } from "views/change-group-window.slint";
import { SelectJavaWindow } from "views/select-java-window.slint";
import { LaunchSummaryWindow, LaunchSummaryRowItem } from "views/launch-summary-window.slint";
import { SelectIconWindow, SelectableIconItem } from "views/select-icon-window.slint";
import { TaskProgressWindow, DownloadTaskRow } from "views/task-progress-window.slint";
import { DownloadModsWindow, RemoteModListItem, ReviewModItem, DescriptionBlockItem, FilterOptionItem } from "views/download-mods-window.slint";
import { RenameInstanceWindow } from "views/rename-instance-window.slint";
import { RenameFolderConfirmWindow } from "views/rename-folder-confirm-window.slint";
import { JavaIncompatibleWindow } from "views/java-incompatible-window.slint";
