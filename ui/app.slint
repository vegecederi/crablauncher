}

export struct InstanceItem {
    id: string,
    name: string,
    minecraft-version: string,
    version-type: string,
    modloader: string,
    modloader-kind: string,
    custom-icon: image,
    has-custom-icon: bool,
    playtime-text: string,
    last-played-text: string,
    group-id: string,
    group-name: string,
    install-status-code: string,
    install-status-label: string,
    install-error: string,
    is-running: bool,
}

export struct GroupSectionItem {
    id: string,
    name: string,
    collapsed: bool,
    is-ungrouped: bool,
    instances: [InstanceItem],
}

export component MainWindow inherits Window {
    title: Strings.app-name + " " + root.app-version;
    icon: @image-url("../assets/app/logo-icon.svg");
    default-font-family: Theme.font-family;
    forward-focus: key-scope;
    preferred-width: 1060px;
    preferred-height: 660px;
    min-width: 780px;
    min-height: 480px;
    background: Theme.bg-primary;

    in property <[InstanceItem]> instances: [];
    in property <[GroupSectionItem]> group-sections: [];
    in property <bool> has-groups: false;
    in-out property <string> instance-search-query: "";
    in-out property <bool> temp-reveal-search: false;

    // Preferências da toolbar e barra de status (persistidas em config.json)
    in-out property <bool> hide-instance-search: false;
    in-out property <bool> show-status-bar: true;
    in-out property <bool> show-toolbar-labels: true;
    in-out property <bool> compact-toolbar: false;

    // Layout Customization Mode (posições encaixáveis tipadas, separadas dos temas)
    in-out property <string> toolbar-position: "top";      // "top" | "bottom"
    in-out property <string> sidebar-position: "right";    // "right" | "left"
    in-out property <string> status-bar-position: "bottom"; // "bottom" | "top"
    in-out property <bool> customize-layout-mode: false;
    private property <string> prev-toolbar-position: "top";
    private property <length> folders-btn-x: 122px;
    private property <length> folders-btn-y: 0px;
    private property <length> folders-btn-h: 44px;
    private property <length> groups-btn-x: 220px;
    private property <length> groups-btn-y: 0px;
    private property <length> groups-btn-h: 44px;
    private property <length> accounts-btn-x: 0px;
    private property <length> accounts-btn-y: 0px;
    private property <length> accounts-btn-w: 120px;
    private property <length> accounts-btn-h: 44px;
    private property <length> launch-menu-x: 0px;
    private property <length> launch-menu-y: 0px;
    private property <length> launch-menu-w: 164px;
    private property <length> launch-menu-h: 30px;
    private property <string> prev-sidebar-position: "right";
    private property <string> prev-status-bar-position: "bottom";
    in-out property <string> dragging-component: ""; // "" | "toolbar" | "sidebar" | "statusbar"
    in-out property <string> drop-preview-zone: "";  // "" | "top" | "bottom" | "left" | "right"

    // Preferências da grade de instâncias (Settings -> Appearance -> Instance Grid)
    in property <length> grid-icon-px: 44px;
    in property <length> grid-gap: 10px;
    in property <bool> grid-show-name: true;
    in property <bool> grid-show-version: false;
    in property <bool> grid-show-modloader: false;

    private property <length> active-toolbar-height: root.compact-toolbar ? 36px : Theme.toolbar-height;
    private property <length> active-toolbar-btn-height: root.compact-toolbar ? 26px : Theme.toolbar-button-height;
    private property <bool> search-visible: !root.hide-instance-search || root.temp-reveal-search;

    in-out property <string> selected-instance-id: "";
    in property <string> selected-instance-name: "";
    in property <string> selected-instance-version: "";
    in property <string> selected-instance-modloader: "";
    in property <string> selected-instance-playtime: "";
    in property <string> selected-instance-last-played: "";
    in property <image> selected-instance-icon;
    in property <bool> selected-instance-has-icon: false;
    in property <string> selected-instance-type: "";
    in property <string> selected-instance-group-name: "Ungrouped";
    in property <string> selected-instance-status-code: "not_installed";
    in property <string> selected-instance-status-label: "Not installed";
    in property <string> selected-instance-error: "";
    in property <bool> selected-instance-running: false;

    // Seletor de contas na toolbar
    in property <bool> has-active-account: false;
    in property <string> active-account-name: "";
    in property <[AccountItem]> accounts: [];

    // Menus suspensos e menus de contexto (apenas um aberto por vez)
    // Drag & Drop de instâncias entre grupos (independente do Customize Layout)
    private property <bool> instance-dragging: false;
    private property <string> dragging-instance-id: "";
    private property <string> dragging-instance-name: "";
    private property <length> drag-cursor-x: 0px;
    private property <length> drag-cursor-y: 0px;
    private property <string> drag-target-group-id: "";
    private property <bool> drag-has-valid-target: false;

    callback move-instance-to-group(string, string); // (instance_id, group_id)
    callback open-rename-instance-clicked(string);
    callback request-delete-instance-dialog(string, string);
    callback request-copy-instance-dialog(string, string);
    callback request-group-dialog(string, string, string);
    callback manage-groups-clicked();
    callback request-delete-group-dialog(string, string);
    callback request-add-offline-account-dialog();

    in-out property <bool> show-folders-menu: false;
    in-out property <bool> show-groups-menu: false;
    in-out property <bool> show-accounts-menu: false;
    in-out property <bool> show-launch-menu: false;
    in-out property <bool> show-group-context-menu: false;
    in-out property <string> group-context-id: "";
    in-out property <string> group-context-name: "";
    in-out property <bool> group-context-collapsed: false;
    in-out property <length> group-context-x: 0px;
    in-out property <length> group-context-y: 0px;
    in-out property <bool> show-delete-group-dialog: false;

    in-out property <bool> show-instance-context-menu: false;
    in-out property <length> instance-context-x: 0px;
    in-out property <length> instance-context-y: 0px;

    in-out property <bool> show-empty-context-menu: false;
    in-out property <length> empty-context-x: 0px;
    in-out property <length> empty-context-y: 0px;

    in-out property <bool> show-toolbar-context-menu: false;
    in-out property <length> toolbar-context-x: 0px;
    in-out property <length> toolbar-context-y: 0px;
    in property <bool> use-floating-context-menus: false;
    callback open-floating-instance-menu(length, length);
    callback open-floating-group-menu(string, string, bool, length, length);
    callback open-floating-empty-menu(length, length);
    callback dismiss-floating-menu();

    // Diálogo de confirmação ao encerrar o Minecraft
    in-out property <bool> show-stop-confirm-dialog: false;
    in-out property <string> stop-confirm-instance-id: "";
    in-out property <string> stop-confirm-instance-name: "";

    // Diálogo Copy Instance
    in-out property <bool> show-copy-dialog: false;
    in-out property <string> copy-new-name: "";
    in-out property <bool> copy-saves: true;
    in-out property <bool> copy-config: true;
    in-out property <bool> copy-resourcepacks: true;
    in-out property <bool> copy-screenshots: false;
    in property <string> copy-error: "";

    // Estado da barra de progresso de instalação
    in property <bool> install-active: false;
    in property <string> install-operation-text: "";
    in property <float> install-progress: 0.0;
    in property <bool> install-indeterminate: true;
    in property <string> install-files-text: "";
    in property <string> install-transfer-text: "";

    in property <string> status-text: "Ready";
    in property <string> status-kind: "success";
    in property <string> app-version: "v0.1.0";

    // Diálogos modais
    in-out property <bool> show-delete-dialog: false;
    in-out property <bool> show-offline-account-dialog: false;
    in-out property <string> offline-username-input: "";
    in property <string> offline-account-error: "";

    callback add-instance-clicked();
    callback instance-search-changed(string);
    callback toolbar-prefs-changed(bool, bool, bool, bool); // hide_search, show_status_bar, show_labels, compact
    callback layout-saved(string, string, string);          // toolbar_pos, sidebar_pos, status_bar_pos
    callback settings-clicked();
    callback accounts-clicked();
    callback open-system-folder(string); // "launcher" | "instances" | "libraries" | "assets" | "runtimes" | "logs"
    callback select-account(string);
    callback select-account-by-index(int);
    callback create-offline-account(string);
    callback select-instance(string);
    callback launch-instance-clicked(string);
    callback launch-offline-requested(string);
    callback launch-demo-clicked(string);
    callback stop-instance-clicked(string);
    callback confirm-stop-instance(string);
    callback open-console-clicked(string);
    callback view-launch-config-clicked(string);
    callback install-instance-clicked(string);
    callback repair-instance-clicked(string);
    callback edit-instance-clicked(string);
    callback change-icon-clicked(string);
    callback change-group-clicked(string);
    callback cancel-install-clicked();
    callback open-folder-clicked(string);
    callback copy-instance-confirmed(string, string, bool, bool, bool, bool);
    callback delete-confirmed(string);

    // Ações de grupos
    callback group-dialog-confirmed(string, string);
    callback toggle-group-collapsed(string);
    callback move-group-up(string);
    callback move-group-down(string);
    callback delete-group-clicked(string);

    // Atalhos globais da janela principal (ancestral de todo o conteúdo para nunca perder atalhos ao clicar em botões)
    key-scope := FocusScope {
        width: parent.width;
        height: parent.height;
        enabled: !root.show-delete-dialog && !root.show-offline-account-dialog && !root.show-copy-dialog && !root.show-stop-confirm-dialog;
        key-pressed(ev) => {
            if (ev.text == Key.Escape) {
                if (root.dragging-component != "") {
                    root.dragging-component = "";
                    root.drop-preview-zone = "";
                    return accept;
                }
                if (root.customize-layout-mode) {
                    root.toolbar-position = root.prev-toolbar-position;
                    root.sidebar-position = root.prev-sidebar-position;
                    root.status-bar-position = root.prev-status-bar-position;
                    root.customize-layout-mode = false;
                    return accept;
                }
                root.show-folders-menu = false;
                root.show-groups-menu = false;
                root.show-accounts-menu = false;
                root.show-launch-menu = false;
                root.show-group-context-menu = false;
                root.show-instance-context-menu = false;
                root.show-empty-context-menu = false;
                root.show-toolbar-context-menu = false;
                root.dismiss-floating-menu();
                if (root.instance-search-query != "") {
                    root.instance-search-query = "";
                    root.instance-search-changed("");
                }
                if (root.temp-reveal-search) {
                    root.temp-reveal-search = false;
                }
                return accept;
            }
            if (ev.modifiers.control && (ev.text == "f" || ev.text == "F" || ev.text == "\u{0006}")) {
                if (root.hide-instance-search) {
                    root.temp-reveal-search = true;
                }
                return accept;
            }
            if (ev.modifiers.control) {
                if (ev.text == "1") { root.select-account-by-index(0); return accept; }
                if (ev.text == "2") { root.select-account-by-index(1); return accept; }
                if (ev.text == "3") { root.select-account-by-index(2); return accept; }
                if (ev.text == "4") { root.select-account-by-index(3); return accept; }
                if (ev.text == "5") { root.select-account-by-index(4); return accept; }
                if (ev.text == "6") { root.select-account-by-index(5); return accept; }
                if (ev.text == "7") { root.select-account-by-index(6); return accept; }
                if (ev.text == "8") { root.select-account-by-index(7); return accept; }
                if (ev.text == "9") { root.select-account-by-index(8); return accept; }
                if (ev.text == "0") { root.select-account-by-index(9); return accept; }
            }
            if (root.selected-instance-id != "") {
                if (ev.text == Key.Return && !root.selected-instance-running && root.selected-instance-status-code != "installing") {
                    root.launch-instance-clicked(root.selected-instance-id);
                    return accept;
                }
                if (ev.text == Key.Delete && !root.selected-instance-running) {
                    root.request-delete-instance-dialog(root.selected-instance-id, root.selected-instance-name);
                    return accept;
                }
                if (ev.text == Key.F2) {
                    root.open-rename-instance-clicked(root.selected-instance-id);
                    return accept;
                }
                if (ev.modifiers.control) {
                    if ((ev.text == "o" || ev.text == "O" || ev.text == "\u{000f}" || ev.text == "ø" || ev.text == "Ø" || ev.text == "ó" || ev.text == "Ó")
                        && !root.selected-instance-running
                        && root.selected-instance-status-code != "installing")
                    {
                        root.show-launch-menu = false;
                        if (ev.modifiers.shift) {
                            root.launch-offline-requested(root.selected-instance-id);
                        } else if (ev.modifiers.alt) {
                            root.launch-demo-clicked(root.selected-instance-id);
                        } else {
                            root.launch-instance-clicked(root.selected-instance-id);
                        }
                        return accept;
                    }
                    if (ev.text == "k" || ev.text == "K" || ev.text == "\u{000b}") {
                        if (root.selected-instance-running) {
                            root.stop-instance-clicked(root.selected-instance-id);
                        }
                        return accept;
                    }
                    if (ev.text == "i" || ev.text == "I" || ev.text == "\u{0009}") {
                        root.edit-instance-clicked(root.selected-instance-id);
                        return accept;
                    }
                    if (ev.text == "g" || ev.text == "G" || ev.text == "\u{0007}") {
                        root.change-group-clicked(root.selected-instance-id);
                        return accept;
                    }
                    if (ev.text == "d" || ev.text == "D" || ev.text == "\u{0004}") {
                        root.request-copy-instance-dialog(root.selected-instance-id, root.selected-instance-name);
                        return accept;
                    }
                }
            }
            reject
        }

    // Wallpaper do tema especial Vice (respeita Wallpaper Opacity e Disable Special Effects)
    if Theme.is-vice-theme && Theme.wallpaper-opacity > 0.0: Rectangle {
        width: parent.width;
        height: parent.height;
        clip: true;

        Image {
            width: parent.width;
            height: parent.height;
            source: @image-url("../assets/themes/vice/wallpaper.png");
            image-fit: cover;
            opacity: Theme.wallpaper-opacity;
        }

        if !Theme.disable-special-effects: Rectangle {
            width: parent.width;
            height: parent.height;
            background: #19152266;
            opacity: Theme.wallpaper-opacity;
        }
    }

    VerticalLayout {
        // Barra de controle do modo Customize Layout (Done / Cancel / Reset Layout)
        if root.customize-layout-mode: Rectangle {
            height: 38px;
            background: Theme.accent-muted;

            Rectangle {
                y: parent.height - 1px;
                height: 1px;
                width: parent.width;
                background: Theme.accent;
            }

            HorizontalLayout {
                padding-left: Theme.space-md;
                padding-right: Theme.space-md;
                spacing: Theme.space-sm;

                Text {
                    text: "Customize Layout — Drag handles on Toolbar, Sidebar, or Status Bar to reposition (Esc to cancel)";
                    font-size: Theme.font-xs;
                    font-weight: 600;
                    color: Theme.text-primary;
                    horizontal-stretch: 1;
                    vertical-alignment: center;
                    overflow: elide;
                }

                CrabButton {
                    text: "Reset Layout";
                    icon: Theme.icon-refresh;
                    has-icon: true;
                    variant: "secondary";
                    height: 26px;
                    y: (parent.height - self.height) / 2;
                    clicked => {
                        root.toolbar-position = "top";
                        root.sidebar-position = "right";
                        root.status-bar-position = "bottom";
                    }
                }

                CrabButton {
                    text: "Cancel";
                    variant: "secondary";
                    height: 26px;
                    y: (parent.height - self.height) / 2;
                    clicked => {
                        root.dragging-component = "";
                        root.drop-preview-zone = "";
                        root.toolbar-position = root.prev-toolbar-position;
                        root.sidebar-position = root.prev-sidebar-position;
                        root.status-bar-position = root.prev-status-bar-position;
                        root.customize-layout-mode = false;
                    }
                }

                CrabButton {
                    text: "Done";
                    icon: Theme.icon-check;
                    has-icon: true;
                    variant: "primary";
                    height: 26px;
                    y: (parent.height - self.height) / 2;
                    clicked => {
                        root.dragging-component = "";
                        root.drop-preview-zone = "";
                        root.customize-layout-mode = false;
                        root.layout-saved(
                            root.toolbar-position,
                            root.sidebar-position,
                            root.status-bar-position
                        );
                    }
                }
            }
        }

        // Barra de status encaixada no topo (quando status-bar-position == "top")
        if root.show-status-bar && root.status-bar-position == "top": CrabStatusBar {
            position: "top";
            instance-count: root.instances.length;
            status-text: root.status-text;
            status-kind: root.status-kind;
            is-busy: root.install-active;
            is-running: root.selected-instance-running;
            selected-instance-id: root.selected-instance-id;
            selected-instance-playtime: root.selected-instance-playtime;
            selected-instance-last-played: root.selected-instance-last-played;
            app-version: root.app-version;
            customize-layout-mode: root.customize-layout-mode;
            border-width: root.customize-layout-mode ? 1px : 0px;
            border-color: Theme.accent;
            blur-offset-y: 0px;
            window-width: root.width;
            window-height: root.height;
            drag-started => {
                root.dragging-component = "statusbar";
                root.drop-preview-zone = "top";
            }
            drag-moved(gy) => {
                if (root.dragging-component == "statusbar") {
                    root.drop-preview-zone = gy < (root.height / 2) ? "top" : "bottom";
                }
            }
            drag-ended => {
                if (root.drop-preview-zone == "top" || root.drop-preview-zone == "bottom") {
                    root.status-bar-position = root.drop-preview-zone;
                }
                root.dragging-component = "";
                root.drop-preview-zone = "";
            }
        }

        // Toolbar unificada na parte superior (mesmo componente CrabToolbar usado na parte inferior)
        if root.toolbar-position == "top": CrabToolbar {
            toolbar-position: "top";
            show-toolbar-labels: root.show-toolbar-labels;
            compact-toolbar: root.compact-toolbar;
            search-visible: root.search-visible;
            instance-search-query <=> root.instance-search-query;
            has-active-account: root.has-active-account;
            active-account-name: root.active-account-name;
            customize-layout-mode: root.customize-layout-mode;
            temp-reveal-search: root.temp-reveal-search;
            blur-offset-y: root.show-status-bar && root.status-bar-position == "top" ? Theme.statusbar-height : 0px;
            window-width: root.width;
            window-height: root.height;

            add-instance-clicked => {
                root.show-folders-menu = false;
                root.show-groups-menu = false;
                root.show-accounts-menu = false;
                root.show-launch-menu = false;
                root.show-group-context-menu = false;
                root.show-toolbar-context-menu = false;
                root.dismiss-floating-menu();
                root.add-instance-clicked();
            }
            folders-toggled(bx, by, bw, bh) => {
                root.show-groups-menu = false;
                root.show-accounts-menu = false;
                root.show-group-context-menu = false;
                root.show-toolbar-context-menu = false;
                root.dismiss-floating-menu();
                root.folders-btn-x = bx;
                root.folders-btn-y = by;
                root.folders-btn-h = bh;
                root.show-folders-menu = !root.show-folders-menu;
            }
            groups-toggled(bx, by, bw, bh) => {
                root.show-folders-menu = false;
                root.show-accounts-menu = false;
                root.show-group-context-menu = false;
                root.show-toolbar-context-menu = false;
                root.dismiss-floating-menu();
                root.groups-btn-x = bx;
                root.groups-btn-y = by;
                root.groups-btn-h = bh;
                root.show-groups-menu = !root.show-groups-menu;
            }
            settings-clicked => {
                root.show-folders-menu = false;
                root.show-groups-menu = false;
                root.show-accounts-menu = false;
                root.show-launch-menu = false;
                root.show-group-context-menu = false;
                root.show-toolbar-context-menu = false;
                root.dismiss-floating-menu();
                root.settings-clicked();
            }
            accounts-toggled(bx, by, bw, bh) => {
                root.show-folders-menu = false;
                root.show-groups-menu = false;
                root.show-group-context-menu = false;
                root.show-toolbar-context-menu = false;
                root.dismiss-floating-menu();
                root.accounts-btn-x = bx;
                root.accounts-btn-y = by;
                root.accounts-btn-w = bw;
                root.accounts-btn-h = bh;
                root.show-accounts-menu = !root.show-accounts-menu;
            }
            search-changed(q) => { root.instance-search-changed(q); }
            clear-search-clicked => {
                root.instance-search-query = "";
                root.instance-search-changed("");
                if (root.temp-reveal-search) { root.temp-reveal-search = false; }
            }
            toolbar-right-clicked(mx, my) => {
                root.show-folders-menu = false;
                root.show-groups-menu = false;
                root.show-accounts-menu = false;
                root.toolbar-context-x = max(8px, min(root.width - 216px, mx));
                root.toolbar-context-y = max(4px, min(root.height - 190px, my));
                root.show-toolbar-context-menu = true;
            }
            drag-started => {
                root.dragging-component = "toolbar";
                root.drop-preview-zone = root.toolbar-position;
            }
            drag-moved(gy) => {
                root.drop-preview-zone = gy > root.height / 2 ? "bottom" : "top";
            }
            drag-ended => {
                if (root.drop-preview-zone == "top" || root.drop-preview-zone == "bottom") {
                    root.toolbar-position = root.drop-preview-zone;
                }
                root.dragging-component = "";
                root.drop-preview-zone = "";
            }
        }

        // Conteúdo principal: painel lateral (esquerda ou direita) + grade central automática
        HorizontalLayout {
            vertical-stretch: 1;

            // Painel lateral encaixado à esquerda (quando sidebar-position == "left")
            if root.sidebar-position == "left": VerticalLayout {
                width: Theme.sidebar-width;

                if root.customize-layout-mode: Rectangle {
                    height: 26px;
                    background: Theme.accent;

                    TouchArea {
                        mouse-cursor: grab;
                        pointer-event(ev) => {
                            if (ev.kind == PointerEventKind.down && ev.button == PointerEventButton.left) {
                                root.dragging-component = "sidebar";
                                root.drop-preview-zone = "left";
                            } else if (ev.kind == PointerEventKind.up && root.dragging-component == "sidebar") {
                                if (root.drop-preview-zone == "left" || root.drop-preview-zone == "right") {
                                    root.sidebar-position = root.drop-preview-zone;
                                }
                                root.dragging-component = "";
                                root.drop-preview-zone = "";
                            }
                        }
                        moved => {
                            if (root.dragging-component == "sidebar") {
                                root.drop-preview-zone = (self.absolute-position.x + self.mouse-x) < (root.width / 2) ? "left" : "right";
                            }
                        }
                    }

                    Text {
                        text: "Drag Panel";
                        font-size: 11px;
                        font-weight: 600;
                        color: Theme.text-on-accent;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                InstanceSidebar {
                    vertical-stretch: 1;
                    has-selection: root.selected-instance-id != "";
                    instance-name: root.selected-instance-name;
                    minecraft-version: root.selected-instance-version;
                    modloader-display: root.selected-instance-modloader;
                    playtime-display: root.selected-instance-playtime;
                    last-played-display: root.selected-instance-last-played;
                    custom-icon: root.selected-instance-icon;
                    has-custom-icon: root.selected-instance-has-icon;
                    group-name: root.selected-instance-group-name;
                    install-status-code: root.selected-instance-status-code;
                    install-status-label: root.selected-instance-status-label;
                    install-error: root.selected-instance-error;
                    is-running: root.selected-instance-running;
                    window-width: root.width;
                    window-height: root.height;
                    blur-offset-x: root.sidebar-position == "right" ? (root.width - Theme.sidebar-width) : 0px;
                    blur-offset-y: (root.toolbar-position == "top" ? root.active-toolbar-height : 0px)
                        + (root.show-status-bar && root.status-bar-position == "top" ? Theme.statusbar-height : 0px);

                    launch-clicked => { if (!root.customize-layout-mode) { root.show-launch-menu = false; root.launch-instance-clicked(root.selected-instance-id); } }
                    launch-menu-toggled(bx, by, bw, bh) => {
                        if (!root.customize-layout-mode) {
                            root.show-folders-menu = false;
                            root.show-groups-menu = false;
                            root.show-accounts-menu = false;
                            root.show-group-context-menu = false;
                            root.show-toolbar-context-menu = false;
                            root.dismiss-floating-menu();
                            root.launch-menu-x = bx;
                            root.launch-menu-y = by;
                            root.launch-menu-w = bw;
                            root.launch-menu-h = bh;
                            root.show-launch-menu = !root.show-launch-menu;
                        }
                    }
                    stop-clicked => { if (!root.customize-layout-mode) { root.stop-instance-clicked(root.selected-instance-id); } }
                    console-clicked => { if (!root.customize-layout-mode) { root.open-console-clicked(root.selected-instance-id); } }
                    install-clicked => { if (!root.customize-layout-mode) { root.install-instance-clicked(root.selected-instance-id); } }
                    repair-clicked => { if (!root.customize-layout-mode) { root.repair-instance-clicked(root.selected-instance-id); } }
                    edit-clicked => { if (!root.customize-layout-mode) { root.edit-instance-clicked(root.selected-instance-id); } }
                    change-icon-clicked => { if (!root.customize-layout-mode) { root.change-icon-clicked(root.selected-instance-id); } }
                    change-group-clicked => { if (!root.customize-layout-mode) { root.change-group-clicked(root.selected-instance-id); } }
                    open-folder-clicked => { if (!root.customize-layout-mode) { root.open-folder-clicked(root.selected-instance-id); } }
                    delete-clicked => { if (!root.customize-layout-mode) { root.request-delete-instance-dialog(root.selected-instance-id, root.selected-instance-name); } }
                }
            }

            Rectangle {
                horizontal-stretch: 1;
                background: Theme.is-vice-theme ? transparent : Theme.bg-primary;
                clip: true;

                // Clique direito em área vazia da grade abre exclusivamente "Create Instance"
                empty-area-touch := TouchArea {
                    clicked => {
                        root.dismiss-floating-menu();
                    }
                    pointer-event(ev) => {
                        if (ev.kind == PointerEventKind.down && ev.button == PointerEventButton.right) {
                            root.show-folders-menu = false;
                            root.show-groups-menu = false;
                            root.show-accounts-menu = false;
                            root.show-group-context-menu = false;
                            root.show-instance-context-menu = false;
                            if (root.use-floating-context-menus) {
                                root.open-floating-empty-menu(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                            } else {
                                root.empty-context-x = self.absolute-position.x + self.mouse-x;
                                root.empty-context-y = self.absolute-position.y + self.mouse-y;
                                root.show-empty-context-menu = true;
                            }
                        }
                    }
                }

                // Estado vazio minimalista
                if root.instances.length == 0 && !root.has-groups: VerticalLayout {
                    alignment: center;
                    spacing: Theme.space-md;

                    HorizontalLayout {
                        alignment: center;
                        Image {
                            source: Theme.icon-cube;
                            width: 44px;
                            height: 44px;
                        }
                    }

                    VerticalLayout {
                        spacing: 4px;

                        Text {
                            text: Strings.empty-title;
                            font-size: Theme.font-md;
                            font-weight: 600;
                            color: Theme.text-primary;
                            horizontal-alignment: center;
                        }

                        Text {
                            text: Strings.empty-subtitle;
                            font-size: Theme.font-sm;
                            color: Theme.text-secondary;
                            horizontal-alignment: center;
                        }
                    }

                    HorizontalLayout {
                        alignment: center;
                        CrabButton {
                            text: Strings.add-instance;
                            icon: Theme.icon-plus;
                            has-icon: true;
                            variant: "primary";
                            clicked => {
                                root.add-instance-clicked();
                            }
                        }
                    }
                }

                // Grade compacta quando não há grupos
                if root.instances.length > 0 && !root.has-groups: grid-flick := Flickable {
                    width: parent.width;
                    height: parent.height;

                    property <length> card-w: 112px;
                    property <length> card-h: root.grid-icon-px + 58px;
                    property <length> gap: root.grid-gap;
                    property <length> pad: 10px;
                    property <int> columns: max(1, floor((self.width - 2 * self.pad + self.gap) / (self.card-w + self.gap)));
                    property <int> rows: ceil(root.instances.length / self.columns);

                    content-width: self.width;
                    content-height: max(self.height, self.pad * 2 + self.rows * (self.card-h + self.gap));

                    for inst[idx] in root.instances: InstanceCard {
                        x: grid-flick.pad + mod(idx, grid-flick.columns) * (grid-flick.card-w + grid-flick.gap);
                        y: grid-flick.pad + floor(idx / grid-flick.columns) * (grid-flick.card-h + grid-flick.gap);
                        name: inst.name;
                        version: inst.minecraft-version;
                        modloader: inst.modloader;
                        modloader-kind: inst.modloader-kind;
                        custom-icon: inst.custom-icon;
                        has-custom-icon: inst.has-custom-icon;
                        install-status: inst.install-status-code;
                        is-running: inst.is-running;
                        selected: inst.id == root.selected-instance-id;
                        icon-px: root.grid-icon-px;
                        show-name: root.grid-show-name;
                        show-version: root.grid-show-version;
                        show-modloader: root.grid-show-modloader;
                        clicked => {
                            key-scope.focus();
                            root.dismiss-floating-menu();
                            root.select-instance(inst.id);
                        }
                        double-clicked => {
                            if (!inst.is-running && inst.install-status-code != "installing") {
                                root.launch-instance-clicked(inst.id);
                            }
                        }
                        middle-clicked => {
                            key-scope.focus();
                            root.select-instance(inst.id);
                            root.edit-instance-clicked(inst.id);
                        }
                        right-clicked(mx, my) => {
                            key-scope.focus();
                            root.select-instance(inst.id);
                            root.show-folders-menu = false;
                            root.show-groups-menu = false;
                            root.show-accounts-menu = false;
                            root.show-group-context-menu = false;
                            root.show-empty-context-menu = false;
                            if (root.use-floating-context-menus) {
                                root.open-floating-instance-menu(mx, my);
                            } else {
                                root.instance-context-x = mx;
                                root.instance-context-y = my;
                                root.show-instance-context-menu = true;
                            }
                        }
                    }
                }

                // Seções compactas por grupo
                if root.has-groups: groups-flick := Flickable {
                    width: parent.width;
                    height: parent.height;

                    property <length> card-w: 112px;
                    property <length> card-h: root.grid-icon-px + 58px;
                    property <length> gap: root.grid-gap;
                    property <int> columns: max(1, floor((self.width - 20px + self.gap) / (self.card-w + self.gap)));

                    content-width: self.width;
                    content-height: groups-col.preferred-height + 16px;

                    groups-col := VerticalLayout {
                        width: parent.width;
                        padding: Theme.space-md;
                        spacing: Theme.space-sm;
                        alignment: start;

                        for section in root.group-sections: Rectangle {
                            private property <bool> is-drop-target: root.instance-dragging
                                && root.drag-cursor-x >= self.absolute-position.x
                                && root.drag-cursor-x <= self.absolute-position.x + self.width
                                && root.drag-cursor-y >= self.absolute-position.y
                                && root.drag-cursor-y <= self.absolute-position.y + self.height;
                            changed is-drop-target => {
                                if (self.is-drop-target) {
                                    root.drag-target-group-id = section.id;
                                    root.drag-has-valid-target = true;
                                }
                            }
                            border-radius: Theme.radius-sm;
                            border-width: self.is-drop-target ? 1px : 0px;
                            border-color: Theme.accent;
                            background: self.is-drop-target ? Theme.accent-muted : transparent;

                            VerticalLayout {
                                spacing: 4px;

                            // Cabeçalho limpo do grupo (nunca exibido para instâncias sem grupo)
                            if !section.is-ungrouped: Rectangle {
                                height: 26px;
                                border-radius: Theme.radius-sm;
                                background: grp-hdr-touch.has-hover ? Theme.bg-secondary : transparent;

                                grp-hdr-touch := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => {
                                        if (!section.is-ungrouped) {
                                            root.toggle-group-collapsed(section.id);
                                        }
                                    }
                                    pointer-event(ev) => {
                                        if (!section.is-ungrouped
                                            && ev.kind == PointerEventKind.down
                                            && ev.button == PointerEventButton.right) {
                                            root.show-folders-menu = false;
                                            root.show-groups-menu = false;
                                            root.show-accounts-menu = false;
                                            root.group-context-id = section.id;
                                            root.group-context-name = section.name;
                                            root.group-context-collapsed = section.collapsed;
                                            if (root.use-floating-context-menus) {
                                                root.open-floating-group-menu(
                                                    section.id,
                                                    section.name,
                                                    section.collapsed,
                                                    self.absolute-position.x + self.mouse-x,
                                                    self.absolute-position.y + self.mouse-y
                                                );
                                            } else {
                                                root.group-context-x = self.absolute-position.x + self.mouse-x;
                                                root.group-context-y = self.absolute-position.y + self.mouse-y;
                                                root.show-group-context-menu = true;
                                            }
                                        }
                                    }
                                }

                                HorizontalLayout {
                                    padding-left: 4px;
                                    padding-right: 4px;
                                    spacing: 6px;

                                    ChevronIcon {
                                        direction: section.collapsed ? "right" : "down";
                                        icon-size: 13px;
                                        icon-color: Theme.text-secondary;
                                    }

                                    Text {
                                        text: section.name;
                                        font-family: Theme.display-font-family;
                                        font-size: Theme.is-vice-theme ? 16px : Theme.font-md;
                                        font-weight: 500;
                                        color: Theme.text-primary;
                                        vertical-alignment: center;
                                    }

                                    Rectangle {
                                        horizontal-stretch: 1;
                                        height: 1px;
                                        y: 13px;
                                        background: Theme.border;
                                    }
                                }
                            }

                            if !section.collapsed && section.instances.length > 0: Rectangle {
                                height: ceil(section.instances.length / groups-flick.columns) * (groups-flick.card-h + groups-flick.gap);

                                for inst[idx] in section.instances: InstanceCard {
                                    x: mod(idx, groups-flick.columns) * (groups-flick.card-w + groups-flick.gap);
                                    y: floor(idx / groups-flick.columns) * (groups-flick.card-h + groups-flick.gap);
                                    name: inst.name;
                                    version: inst.minecraft-version;
                                    modloader: inst.modloader;
                                    modloader-kind: inst.modloader-kind;
                                    custom-icon: inst.custom-icon;
                                    has-custom-icon: inst.has-custom-icon;
                                    install-status: inst.install-status-code;
                                    is-running: inst.is-running;
                                    selected: inst.id == root.selected-instance-id;
                                    icon-px: root.grid-icon-px;
                                    show-name: root.grid-show-name;
                                    show-version: root.grid-show-version;
                                    show-modloader: root.grid-show-modloader;
                                    clicked => {
                                        key-scope.focus();
                                        root.dismiss-floating-menu();
                                        root.select-instance(inst.id);
                                    }
                                    double-clicked => {
                                        if (!inst.is-running && inst.install-status-code != "installing") {
                                            root.launch-instance-clicked(inst.id);
                                        }
                                    }
                                    middle-clicked => {
                                        key-scope.focus();
                                        root.select-instance(inst.id);
                                        root.edit-instance-clicked(inst.id);
                                    }
                                    right-clicked(mx, my) => {
                                        key-scope.focus();
                                        root.select-instance(inst.id);
                                        root.show-folders-menu = false;
                                        root.show-groups-menu = false;
                                        root.show-accounts-menu = false;
                                        root.show-group-context-menu = false;
                                        root.show-empty-context-menu = false;
                                        if (root.use-floating-context-menus) {
                                            root.open-floating-instance-menu(mx, my);
                                        } else {
                                            root.instance-context-x = mx;
                                            root.instance-context-y = my;
                                            root.show-instance-context-menu = true;
                                        }
                                    }
                                    drag-started(dname, ax, ay) => {
                                        root.instance-dragging = true;
                                        root.dragging-instance-id = inst.id;
                                        root.dragging-instance-name = dname;
                                        root.drag-cursor-x = ax;
                                        root.drag-cursor-y = ay;
                                        root.drag-has-valid-target = false;
                                    }
                                    drag-moved(ax, ay) => {
                                        root.drag-cursor-x = ax;
                                        root.drag-cursor-y = ay;
                                    }
                                    drag-ended(ax, ay) => {
                                        root.drag-cursor-x = ax;
                                        root.drag-cursor-y = ay;
                                        if (root.instance-dragging && root.drag-has-valid-target && root.dragging-instance-id != "") {
                                            root.move-instance-to-group(root.dragging-instance-id, root.drag-target-group-id);
                                        }
                                        root.instance-dragging = false;
                                        root.drag-has-valid-target = false;
                                    }
                                }
                            }
                            }
                        }
                    }
                }
            }

            // Painel lateral encaixado à direita (padrão)
            if root.sidebar-position == "right": VerticalLayout {
                width: Theme.sidebar-width;

                if root.customize-layout-mode: Rectangle {
                    height: 26px;
                    background: Theme.accent;

                    TouchArea {
                        mouse-cursor: grab;
                        pointer-event(ev) => {
                            if (ev.kind == PointerEventKind.down && ev.button == PointerEventButton.left) {
                                root.dragging-component = "sidebar";
                                root.drop-preview-zone = "right";
                            } else if (ev.kind == PointerEventKind.up && root.dragging-component == "sidebar") {
                                if (root.drop-preview-zone == "left" || root.drop-preview-zone == "right") {
                                    root.sidebar-position = root.drop-preview-zone;
                                }
                                root.dragging-component = "";
                                root.drop-preview-zone = "";
                            }
                        }
                        moved => {
                            if (root.dragging-component == "sidebar") {
                                root.drop-preview-zone = (self.absolute-position.x + self.mouse-x) < (root.width / 2) ? "left" : "right";
                            }
                        }
                    }

                    Text {
                        text: "Drag Panel";
                        font-size: 11px;
                        font-weight: 600;
                        color: Theme.text-on-accent;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                InstanceSidebar {
                    vertical-stretch: 1;
                    has-selection: root.selected-instance-id != "";
                    instance-name: root.selected-instance-name;
                    minecraft-version: root.selected-instance-version;
                    modloader-display: root.selected-instance-modloader;
                    playtime-display: root.selected-instance-playtime;
                    last-played-display: root.selected-instance-last-played;
                    custom-icon: root.selected-instance-icon;
                    has-custom-icon: root.selected-instance-has-icon;
                    group-name: root.selected-instance-group-name;
                    install-status-code: root.selected-instance-status-code;
                    install-status-label: root.selected-instance-status-label;
                    install-error: root.selected-instance-error;
                    is-running: root.selected-instance-running;
                    window-width: root.width;
                    window-height: root.height;
                    blur-offset-x: root.sidebar-position == "right" ? (root.width - Theme.sidebar-width) : 0px;
                    blur-offset-y: (root.toolbar-position == "top" ? root.active-toolbar-height : 0px)
                        + (root.show-status-bar && root.status-bar-position == "top" ? Theme.statusbar-height : 0px);

                    launch-clicked => { if (!root.customize-layout-mode) { root.show-launch-menu = false; root.launch-instance-clicked(root.selected-instance-id); } }
                    launch-menu-toggled(bx, by, bw, bh) => {
                        if (!root.customize-layout-mode) {
                            root.show-folders-menu = false;
                            root.show-groups-menu = false;
                            root.show-accounts-menu = false;
                            root.show-group-context-menu = false;
                            root.show-toolbar-context-menu = false;
                            root.dismiss-floating-menu();
                            root.launch-menu-x = bx;
                            root.launch-menu-y = by;
                            root.launch-menu-w = bw;
                            root.launch-menu-h = bh;
                            root.show-launch-menu = !root.show-launch-menu;
                        }
                    }
                    stop-clicked => { if (!root.customize-layout-mode) { root.stop-instance-clicked(root.selected-instance-id); } }
                    console-clicked => { if (!root.customize-layout-mode) { root.open-console-clicked(root.selected-instance-id); } }
                    install-clicked => { if (!root.customize-layout-mode) { root.install-instance-clicked(root.selected-instance-id); } }
                    repair-clicked => { if (!root.customize-layout-mode) { root.repair-instance-clicked(root.selected-instance-id); } }
                    edit-clicked => { if (!root.customize-layout-mode) { root.edit-instance-clicked(root.selected-instance-id); } }
                    change-icon-clicked => { if (!root.customize-layout-mode) { root.change-icon-clicked(root.selected-instance-id); } }
                    change-group-clicked => { if (!root.customize-layout-mode) { root.change-group-clicked(root.selected-instance-id); } }
                    open-folder-clicked => { if (!root.customize-layout-mode) { root.open-folder-clicked(root.selected-instance-id); } }
                    delete-clicked => { if (!root.customize-layout-mode) { root.request-delete-instance-dialog(root.selected-instance-id, root.selected-instance-name); } }
                }
            }
        }

        // Toolbar unificada na parte inferior (mesmo componente CrabToolbar usado na parte superior)
        if root.toolbar-position == "bottom": CrabToolbar {
            toolbar-position: "bottom";
            show-toolbar-labels: root.show-toolbar-labels;
            compact-toolbar: root.compact-toolbar;
            search-visible: root.search-visible;
            instance-search-query <=> root.instance-search-query;
            has-active-account: root.has-active-account;
            active-account-name: root.active-account-name;
            customize-layout-mode: root.customize-layout-mode;
            temp-reveal-search: root.temp-reveal-search;
            blur-offset-y: root.height - root.active-toolbar-height
                - (root.show-status-bar && root.status-bar-position == "bottom" ? Theme.statusbar-height : 0px);
            window-width: root.width;
            window-height: root.height;

            add-instance-clicked => {
                root.show-folders-menu = false;
                root.show-groups-menu = false;
                root.show-accounts-menu = false;
                root.show-launch-menu = false;
                root.show-group-context-menu = false;
                root.show-toolbar-context-menu = false;
                root.dismiss-floating-menu();
                root.add-instance-clicked();
            }
            folders-toggled(bx, by, bw, bh) => {
                root.show-groups-menu = false;
                root.show-accounts-menu = false;
                root.show-group-context-menu = false;
                root.show-toolbar-context-menu = false;
                root.dismiss-floating-menu();
                root.folders-btn-x = bx;
                root.folders-btn-y = by;
                root.folders-btn-h = bh;
                root.show-folders-menu = !root.show-folders-menu;
            }
            groups-toggled(bx, by, bw, bh) => {
                root.show-folders-menu = false;
                root.show-accounts-menu = false;
                root.show-group-context-menu = false;
                root.show-toolbar-context-menu = false;
                root.dismiss-floating-menu();
                root.groups-btn-x = bx;
                root.groups-btn-y = by;
                root.groups-btn-h = bh;
                root.show-groups-menu = !root.show-groups-menu;
            }
            settings-clicked => {
                root.show-folders-menu = false;
                root.show-groups-menu = false;
                root.show-accounts-menu = false;
                root.show-launch-menu = false;
                root.show-group-context-menu = false;
                root.show-toolbar-context-menu = false;
                root.dismiss-floating-menu();
                root.settings-clicked();
            }
            accounts-toggled(bx, by, bw, bh) => {
                root.show-folders-menu = false;
                root.show-groups-menu = false;
                root.show-group-context-menu = false;
                root.show-toolbar-context-menu = false;
                root.dismiss-floating-menu();
                root.accounts-btn-x = bx;
                root.accounts-btn-y = by;
                root.accounts-btn-w = bw;
                root.accounts-btn-h = bh;
                root.show-accounts-menu = !root.show-accounts-menu;
            }
            search-changed(q) => { root.instance-search-changed(q); }
            clear-search-clicked => {
                root.instance-search-query = "";
                root.instance-search-changed("");
                if (root.temp-reveal-search) { root.temp-reveal-search = false; }
            }
            toolbar-right-clicked(mx, my) => {
                root.show-folders-menu = false;
                root.show-groups-menu = false;
                root.show-accounts-menu = false;
                root.toolbar-context-x = max(8px, min(root.width - 216px, mx));
                root.toolbar-context-y = max(4px, min(root.height - 190px, my));
                root.show-toolbar-context-menu = true;
            }
            drag-started => {
                root.dragging-component = "toolbar";
                root.drop-preview-zone = root.toolbar-position;
            }
            drag-moved(gy) => {
                root.drop-preview-zone = gy > root.height / 2 ? "bottom" : "top";
            }
            drag-ended => {
                if (root.drop-preview-zone == "top" || root.drop-preview-zone == "bottom") {
                    root.toolbar-position = root.drop-preview-zone;
                }
                root.dragging-component = "";
                root.drop-preview-zone = "";
            }
        }

        // Barra de status encaixada na parte inferior (padrão)
        if root.show-status-bar && root.status-bar-position == "bottom": CrabStatusBar {
            position: "bottom";
            instance-count: root.instances.length;
            status-text: root.status-text;
            status-kind: root.status-kind;
            is-busy: root.install-active;
            is-running: root.selected-instance-running;
            selected-instance-id: root.selected-instance-id;
            selected-instance-playtime: root.selected-instance-playtime;
            selected-instance-last-played: root.selected-instance-last-played;
            app-version: root.app-version;
            customize-layout-mode: root.customize-layout-mode;
            border-width: root.customize-layout-mode ? 1px : 0px;
            border-color: Theme.accent;
            blur-offset-y: root.height - Theme.statusbar-height;
            window-width: root.width;
            window-height: root.height;
            drag-started => {
                root.dragging-component = "statusbar";
                root.drop-preview-zone = "bottom";
            }
            drag-moved(gy) => {
                if (root.dragging-component == "statusbar") {
                    root.drop-preview-zone = gy < (root.height / 2) ? "top" : "bottom";
                }
            }
            drag-ended => {
                if (root.drop-preview-zone == "top" || root.drop-preview-zone == "bottom") {
                    root.status-bar-position = root.drop-preview-zone;
                }
                root.dragging-component = "";
                root.drop-preview-zone = "";
            }
        }
    }

    // Menu suspenso de opções de Launch (Launch / Launch Offline / Launch Demo)
    if root.show-launch-menu: Rectangle {
        width: parent.width;
        height: parent.height;
        background: transparent;

        TouchArea {
            clicked => { root.show-launch-menu = false; }
        }

        CrabContextMenu {
            x: max(8px, min(parent.width - self.width - 8px, root.launch-menu-x + root.launch-menu-w - self.width));
            y: min(parent.height - self.height - 8px, root.launch-menu-y + root.launch-menu-h + 6px);
            menu-width: 244px;

            ContextMenuItem {
                text: "Launch";
                shortcut: "Ctrl+O";
                icon: Theme.icon-play;
                enabled: !root.selected-instance-running && root.selected-instance-status-code != "installing";
                clicked => {
                    root.show-launch-menu = false;
                    root.launch-instance-clicked(root.selected-instance-id);
                }
            }
            ContextMenuItem {
                text: "Launch Offline";
                shortcut: "Ctrl+Shift+O";
                icon: Theme.icon-user;
                enabled: !root.selected-instance-running && root.selected-instance-status-code != "installing";
                clicked => {
                    root.show-launch-menu = false;
                    root.launch-offline-requested(root.selected-instance-id);
                }
            }
            ContextMenuItem {
                text: "Launch Demo";
                shortcut: "Ctrl+Alt+O";
                icon: Theme.icon-flask-conical;
                enabled: !root.selected-instance-running && root.selected-instance-status-code != "installing";
                clicked => {
                    root.show-launch-menu = false;
                    root.launch-demo-clicked(root.selected-instance-id);
                }
            }
        }
    }

    // Menu suspenso Folders (ancorado com folga limpa de 6px fora da toolbar)
    if root.show-folders-menu: Rectangle {
        width: parent.width;
        height: parent.height;
        background: transparent;

        TouchArea {
            clicked => { root.show-folders-menu = false; }
        }

        CrabContextMenu {
            x: max(8px, min(parent.width - self.width - 8px, root.folders-btn-x));
            y: root.toolbar-position == "bottom"
                ? max(8px, root.folders-btn-y - self.height - 6px)
                : min(parent.height - self.height - 8px, root.folders-btn-y + root.folders-btn-h + 6px);
            menu-width: 220px;

            for item in [
                { key: "launcher", label: "Launcher Folder" },
                { key: "instances", label: "Instances Folder" },
                { key: "libraries", label: "Libraries Folder" },
                { key: "assets", label: "Assets Folder" },
                { key: "runtimes", label: "Java Runtimes Folder" },
                { key: "icons", label: "Icons Folder" },
                { key: "themes", label: "Themes Folder" },
                { key: "logs", label: "Logs Folder" },
            ]: ContextMenuItem {
                text: item.label;
                icon: Theme.icon-folder;
                clicked => {
                    root.show-folders-menu = false;
                    root.open-system-folder(item.key);
                }
            }
        }
    }

    // Menu suspenso Groups (mesmo estilo e ancoragem limpa de 6px fora da toolbar)
    if root.show-groups-menu: Rectangle {
        width: parent.width;
        height: parent.height;
        background: transparent;

        TouchArea {
            clicked => { root.show-groups-menu = false; }
        }

        CrabContextMenu {
            x: max(8px, min(parent.width - self.width - 8px, root.groups-btn-x));
            y: root.toolbar-position == "bottom"
                ? max(8px, root.groups-btn-y - self.height - 6px)
                : min(parent.height - self.height - 8px, root.groups-btn-y + root.groups-btn-h + 6px);
            menu-width: 204px;

            ContextMenuItem {
                text: "Create Group";
                icon: Theme.icon-folder-plus;
                clicked => {
                    root.show-groups-menu = false;
                    root.request-group-dialog("Create Group", "", "");
                }
            }
            ContextMenuItem {
                text: "Manage Groups";
                icon: Theme.icon-folder;
                clicked => {
                    root.show-groups-menu = false;
                    root.manage-groups-clicked();
                }
            }
        }
    }

    // Menu suspenso Account Selector (alinhado à direita do botão, 6px fora da toolbar)
    if root.show-accounts-menu: Rectangle {
        width: parent.width;
        height: parent.height;
        background: transparent;

        TouchArea {
            clicked => { root.show-accounts-menu = false; }
        }

        CrabContextMenu {
            x: max(8px, min(parent.width - self.width - 8px, root.accounts-btn-x + root.accounts-btn-w - self.width));
            y: root.toolbar-position == "bottom"
                ? max(8px, root.accounts-btn-y - self.height - 6px)
                : min(parent.height - self.height - 8px, root.accounts-btn-y + root.accounts-btn-h + 6px);
            menu-width: 260px;

            for acc[idx] in root.accounts: Rectangle {
                height: 34px;
                border-radius: Theme.radius-sm;
                background: acc.is-default
                    ? Theme.accent-muted
                    : am-touch.has-hover ? Theme.bg-interactive-hover : transparent;

                am-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        root.show-accounts-menu = false;
                        root.select-account(acc.id);
                    }
                }

                HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 10px;
                    spacing: 10px;

                    VerticalLayout {
                        alignment: center;
                        Image {
                            source: @image-url("../assets/icons/steve-head.svg");
                            width: 16px;
                            height: 16px;
                            image-rendering: pixelated;
                        }
                    }

                    Text {
                        text: acc.username;
                        font-size: Theme.font-sm;
                        font-weight: acc.is-default ? 600 : 400;
                        color: acc.is-default ? Theme.accent : Theme.text-primary;
                        horizontal-stretch: 1;
                        vertical-alignment: center;
                        overflow: elide;
                    }

                    if idx < 10: Text {
                        text: idx < 9 ? "Ctrl+" + (idx + 1) : "Ctrl+0";
                        font-size: Theme.font-xs;
                        color: Theme.text-secondary;
                        vertical-alignment: center;
                    }

                    if acc.is-default: VerticalLayout {
                        alignment: center;
                        Image {
                            source: Theme.icon-check;
                            width: 14px;
                            height: 14px;
                            colorize: Theme.accent;
                        }
                    }
                }
            }

            if root.accounts.length > 0: ContextMenuDivider { }

            ContextMenuItem {
                text: "Manage Accounts";
                icon: Theme.icon-settings;
                clicked => {
                    root.show-accounts-menu = false;
                    root.accounts-clicked();
                }
            }
        }
    }

    // Menu de contexto de grupo (clique direito no cabeçalho do grupo)
    if root.show-group-context-menu: Rectangle {
        width: parent.width;
        height: parent.height;
        background: transparent;

        TouchArea {
            clicked => { root.show-group-context-menu = false; }
        }

        CrabContextMenu {
            x: max(6px, min(parent.width - self.width - 6px, root.group-context-x));
            y: max(6px, min(parent.height - self.height - 6px, root.group-context-y));
            menu-width: 204px;

            ContextMenuItem {
                text: "Rename Group";
                icon: Theme.icon-edit;
                clicked => {
                    root.show-group-context-menu = false;
                    root.request-group-dialog("Rename Group", root.group-context-id, root.group-context-name);
                }
            }

            ContextMenuItem {
                text: root.group-context-collapsed ? "Expand Group" : "Collapse Group";
                icon: root.group-context-collapsed
                    ? Theme.icon-chevron-down
                    : Theme.icon-chevron-up;
                clicked => {
                    root.show-group-context-menu = false;
                    root.toggle-group-collapsed(root.group-context-id);
                }
            }

            ContextMenuDivider { }

            ContextMenuItem {
                text: "Move Group Up";
                icon: Theme.icon-arrow-up;
                clicked => {
                    root.show-group-context-menu = false;
                    root.move-group-up(root.group-context-id);
                }
            }

            ContextMenuItem {
                text: "Move Group Down";
                icon: Theme.icon-arrow-down;
                clicked => {
                    root.show-group-context-menu = false;
                    root.move-group-down(root.group-context-id);
                }
            }

            ContextMenuDivider { }

            ContextMenuItem {
                text: "Delete Group";
                icon: Theme.icon-trash;
                danger: true;
                clicked => {
                    root.show-group-context-menu = false;
                    root.request-delete-group-dialog(root.group-context-id, root.group-context-name);
                }
            }
        }
    }

    // Menu de contexto da instância (clique direito sobre qualquer InstanceCard)
    if root.show-instance-context-menu: Rectangle {
        width: parent.width;
        height: parent.height;
        background: transparent;

        TouchArea {
            clicked => { root.show-instance-context-menu = false; }
        }

        CrabContextMenu {
            x: max(6px, min(parent.width - self.width - 6px, root.instance-context-x));
            y: max(6px, min(parent.height - self.height - 6px, root.instance-context-y));
            menu-width: 244px;

            ContextMenuHeader { text: root.selected-instance-name; }
                ContextMenuDivider { }

                ContextMenuItem {
                    text: "Rename";
                    shortcut: "F2";
                    icon: Theme.icon-edit;
                    clicked => {
                        root.show-instance-context-menu = false;
                        root.open-rename-instance-clicked(root.selected-instance-id);
                    }
                }
                ContextMenuItem {
                    text: "Change Icon";
                    icon: Theme.icon-cube;
                    clicked => {
                        root.show-instance-context-menu = false;
                        root.change-icon-clicked(root.selected-instance-id);
                    }
                }
                ContextMenuDivider { }

                ContextMenuItem {
                    text: "Launch";
                    shortcut: "Enter";
                    icon: Theme.icon-play;
                    enabled: !root.selected-instance-running && root.selected-instance-status-code != "installing";
                    clicked => {
                        root.show-instance-context-menu = false;
                        root.launch-instance-clicked(root.selected-instance-id);
                    }
                }
                ContextMenuItem {
                    text: "Stop Game";
                    shortcut: "Ctrl+K";
                    icon: Theme.icon-square;
                    enabled: root.selected-instance-running;
                    clicked => {
                        root.show-instance-context-menu = false;
                        root.stop-instance-clicked(root.selected-instance-id);
                    }
                }
                ContextMenuDivider { }

                ContextMenuItem {
                    text: "Edit Instance";
                    shortcut: "Ctrl+I";
                    icon: Theme.icon-settings;
                    clicked => {
                        root.show-instance-context-menu = false;
                        root.edit-instance-clicked(root.selected-instance-id);
                    }
                }
                ContextMenuItem {
                    text: "View Launch Configuration";
                    icon: Theme.icon-info;
                    clicked => {
                        root.show-instance-context-menu = false;
                        root.view-launch-config-clicked(root.selected-instance-id);
                    }
                }
                ContextMenuItem {
                    text: "Change Group";
                    shortcut: "Ctrl+G";
                    icon: Theme.icon-folder-plus;
                    clicked => {
                        root.show-instance-context-menu = false;
                        root.change-group-clicked(root.selected-instance-id);
                    }
                }
                ContextMenuItem {
                    text: "Open Folder";
                    icon: Theme.icon-folder;
                    clicked => {
                        root.show-instance-context-menu = false;
                        root.open-folder-clicked(root.selected-instance-id);
                    }
                }
                ContextMenuDivider { }

                ContextMenuItem {
                    text: "Copy Instance";
                    shortcut: "Ctrl+D";
                    icon: Theme.icon-copy;
                    clicked => {
                        root.show-instance-context-menu = false;
                        root.copy-new-name = root.selected-instance-name + " Copy";
                        root.show-copy-dialog = true;
                    }
                }
                ContextMenuItem {
                    text: "Repair Instance";
                    icon: Theme.icon-wrench;
                    enabled: !root.selected-instance-running && root.selected-instance-status-code != "installing";
                    clicked => {
                        root.show-instance-context-menu = false;
                        root.repair-instance-clicked(root.selected-instance-id);
                    }
                }
                ContextMenuItem {
                    text: "Delete Instance";
                    shortcut: "Del";
                    icon: Theme.icon-trash;
                    danger: true;
                    enabled: !root.selected-instance-running;
                    clicked => {
                        root.show-instance-context-menu = false;
                        root.request-delete-instance-dialog(root.selected-instance-id, root.selected-instance-name);
                    }
                }
        }
    }

    // Menu de contexto de área vazia (exclusivamente "Create Instance")
    if root.show-empty-context-menu: Rectangle {
        width: parent.width;
        height: parent.height;
        background: transparent;

        TouchArea {
            clicked => { root.show-empty-context-menu = false; }
        }

        CrabContextMenu {
            x: max(6px, min(parent.width - self.width - 6px, root.empty-context-x));
            y: max(6px, min(parent.height - self.height - 6px, root.empty-context-y));
            menu-width: 196px;

            Rectangle {
                height: 22px;
                HorizontalLayout {
                    padding-left: Theme.space-sm;
                    padding-right: Theme.space-sm;
                    Text {
                        text: "Crab Launcher";
                        font-size: Theme.font-xs;
                        font-weight: 600;
                        color: Theme.text-secondary;
                        vertical-alignment: center;
                    }
                }
            }

            ContextMenuDivider { }

            ContextMenuItem {
                text: "Create Instance";
                icon: Theme.icon-plus;
                clicked => {
                    root.show-empty-context-menu = false;
                    root.add-instance-clicked();
                }
            }

            ContextMenuItem {
                text: "Create Group";
                icon: Theme.icon-folder-plus;
                clicked => {
                    root.show-empty-context-menu = false;
                    root.request-group-dialog("Create Group", "", "");
                }
            }
        }
    }

    // Menu de contexto da toolbar (clique direito sobre a toolbar principal)
    if root.show-toolbar-context-menu: Rectangle {
        width: parent.width;
        height: parent.height;
        background: transparent;

        TouchArea {
            clicked => { root.show-toolbar-context-menu = false; }
        }

        CrabContextMenu {
            x: root.toolbar-context-x;
            y: root.toolbar-context-y;
            menu-width: 218px;

            ContextMenuItem {
                text: "Customize Layout";
                    icon: Theme.icon-layout-grid;
                    clicked => {
                        root.show-toolbar-context-menu = false;
                        root.prev-toolbar-position = root.toolbar-position;
                        root.prev-sidebar-position = root.sidebar-position;
                        root.prev-status-bar-position = root.status-bar-position;
                        root.customize-layout-mode = true;
                        key-scope.focus();
                    }
                }

                ContextMenuDivider { }

                ContextMenuCheckItem {
                    text: "Hide Instance Search";
                    checked: root.hide-instance-search;
                    toggled => {
                        root.hide-instance-search = !root.hide-instance-search;
                        root.temp-reveal-search = false;
                        if (root.hide-instance-search && root.instance-search-query != "") {
                            root.instance-search-query = "";
                            root.instance-search-changed("");
                        }
                        root.show-toolbar-context-menu = false;
                        root.toolbar-prefs-changed(
                            root.hide-instance-search,
                            root.show-status-bar,
                            root.show-toolbar-labels,
                            root.compact-toolbar
                        );
                    }
                }

                ContextMenuCheckItem {
                    text: "Status Bar";
                    checked: root.show-status-bar;
                    toggled => {
                        root.show-status-bar = !root.show-status-bar;
                        root.show-toolbar-context-menu = false;
                        root.toolbar-prefs-changed(
                            root.hide-instance-search,
                            root.show-status-bar,
                            root.show-toolbar-labels,
                            root.compact-toolbar
                        );
                    }
                }

                ContextMenuDivider { }

                ContextMenuCheckItem {
                    text: "Compact Toolbar";
                    checked: root.compact-toolbar;
                    toggled => {
                        root.compact-toolbar = !root.compact-toolbar;
                        root.show-toolbar-context-menu = false;
                        root.toolbar-prefs-changed(
                            root.hide-instance-search,
                            root.show-status-bar,
                            root.show-toolbar-labels,
                            root.compact-toolbar
                        );
                    }
                }

                ContextMenuDivider { }

                ContextMenuItem {
                    text: "Reset Layout";
                    icon: Theme.icon-refresh;
                    clicked => {
                        root.hide-instance-search = false;
                        root.temp-reveal-search = false;
                        root.show-status-bar = true;
                        root.show-toolbar-labels = true;
                        root.compact-toolbar = false;
                        root.toolbar-position = "top";
                        root.sidebar-position = "right";
                        root.status-bar-position = "bottom";
                        root.show-toolbar-context-menu = false;
                        root.toolbar-prefs-changed(false, true, true, false);
                        root.layout-saved("top", "right", "bottom");
                    }
                }
        }
    }

    // Prévia visual das zonas de encaixe (docking) durante arraste no modo Customize Layout
    if root.customize-layout-mode && root.dragging-component != "" && root.drop-preview-zone != "": Rectangle {
        x: root.drop-preview-zone == "right" ? root.width - Theme.sidebar-width - 8px : 8px;
        y: root.drop-preview-zone == "bottom" ? root.height - 52px : 44px;
        width: (root.drop-preview-zone == "left" || root.drop-preview-zone == "right")
            ? Theme.sidebar-width
            : root.width - 16px;
        height: (root.drop-preview-zone == "left" || root.drop-preview-zone == "right")
            ? root.height - 96px
            : 44px;
        border-radius: Theme.radius-sm;
        background: Theme.accent-muted;
        border-width: 2px;
        border-color: Theme.accent;

        Text {
            text: "Drop " + root.dragging-component + " here (" + root.drop-preview-zone + ")";
            font-size: Theme.font-sm;
            font-weight: 600;
            color: Theme.accent;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
    }

}
